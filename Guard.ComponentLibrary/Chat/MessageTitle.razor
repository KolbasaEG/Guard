@using System.Globalization
<RadzenStack Orientation="Orientation.Horizontal"
             AlignItems="AlignItems.Center"
             JustifyContent="@(IsOwner ? JustifyContent.End : JustifyContent.Start)"
             Gap="0.5rem"
             Style="flex-wrap: nowrap; --rz-stack-gap: 0.5rem;">

  @* Для сообщений других пользователей — слева: имя + время *@
  @if (!IsOwner)
  {
    <div class="rz-chat-message-participant-name">@UserName</div>
    <div class="rz-chat-message-time">@FormattedDateTime</div>
  }
  @* Для собственных сообщений — справа: только время *@
  else
  {
    <div class="rz-chat-message-time">@FormattedDateTime</div>
  }
</RadzenStack>
@code {
  [Parameter] public bool IsOwner { get; set; } = false;
  [Parameter] public string UserName { get; set; } = "";
  [Parameter] public DateTime PublishDateTime { get; set; }
  private string FormattedDateTime =>
        PublishDateTime
            .ToLocalTime()
            .ToString("dd.MM.yyyy HH:mm", CultureInfo.GetCultureInfo("ru-RU"));
  protected override void OnParametersSet()
  {
    // Защита от null/empty
    UserName = string.IsNullOrWhiteSpace(UserName) ? "Неизвестный" : UserName.Trim();
  }
}

