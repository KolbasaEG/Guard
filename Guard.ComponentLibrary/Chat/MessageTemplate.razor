
<RadzenStack Gap="0px;" Style="width:100%; margin-top:10px;" 
               Orientation="Orientation.Horizontal"
               AlignItems="AlignItems.Center"
               JustifyContent="@(Message.IsOwner ? JustifyContent.End : JustifyContent.Start)">
  <RadzenStack Gap="5px;" Style="width:70%;" Orientation="Orientation.Horizontal"
               JustifyContent="@(Message.IsOwner ? JustifyContent.End : JustifyContent.Start)">
    <RadzenStack Gap="0px;" Visible="@(!message.IsOwner)">
      <InitialsBlock UserInitials="@(message.UserInitials)" />
    </RadzenStack>
    <RadzenStack Gap="0px;" Style="padding:0px;">
      <MessageTitle IsOwner="@(message.IsOwner)" PublishDateTime="@(message.PublishDateTime)" UserName="@(message.UserName)" />
      <TextArea Text="@(message.Text)" />
    </RadzenStack>
    <RadzenStack Gap="0px;" Visible="@(message.IsOwner)">
      <InitialsBlock UserInitials="@(message.UserInitials)" />
    </RadzenStack>
  </RadzenStack>
</RadzenStack>


@code {
  [Parameter] public ChatMessageDto Message { get; set; } = default!;   // ← MessageDto переименован в ChatMessageDto по дорожной карте

  private ChatMessageDto message => Message;

  protected override void OnParametersSet()
  {
    // Защита от null (production-ready)
    if (Message == null)
    {
      Message = new ChatMessageDto
      {
        Text = "Сообщение не загрузилось",
        IsOwner = false,
        UserName = "Система",
        UserInitials = "??",
        PublishDateTime = DateTime.UtcNow
      };
    }
  }
}

