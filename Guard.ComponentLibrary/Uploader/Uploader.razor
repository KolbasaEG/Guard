@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Radzen
@using Radzen.Blazor
@attribute [Authorize]
<RadzenRow>
  <RadzenColumn Size="12">
    <RadzenStack Visible="@(!AutoUpload)" Orientation="Orientation.Horizontal" Style="width:100%;border-radius: var(--rz-upload-button-bar-border-radius); margin-bottom:10px; height:36px; background-color: var(--rz-upload-button-bar-background-color);" AlignItems="AlignItems.Center">
      <RadzenText Style="width:100%; margin-bottom:0px; margin-left:10px;" TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Загрузка файлов</RadzenText>
      <RadzenButton Click="Upload" Visible="@(myIBrowserFiles.Count>0)" Style="width:250px;" Icon="cloud_upload" ButtonStyle="ButtonStyle.Success" Text="Загрузить" />
    </RadzenStack>
    <div class="rz-fileupload" style="width:100%;">
      <div class="rz-fileupload-buttonbar" hidden="@(!ShowUploader)">
        <span class="rz-fileupload-choose rz-button" tabindex="0" style="width:100%; padding:30px 0;display:flex; justify-content:center;align-items:center;">
          @if (FileCount > 1)
          {
            <InputFile OnChange="HandleSelection" multiple accept="@Formats" tabindex="-1" style="min-height: 100%;min-width: 100%;" />
          }
          else
          {
            <InputFile OnChange="HandleSelection" accept="@Formats" tabindex="-1" style="min-height: 100%;min-width: 100%;" />
          }
          <span class="rz-button-text">Перетащите файл в эту область или нажмите для выбора</span>
        </span>
      </div>
      <div class="rz-fileupload-content">
        <div class="rz-fileupload-files" style="padding:0px;">
          <RadzenStack Gap="5px" Style="padding-top:10px;" Visible="@(myIBrowserFiles != null || myIBrowserFiles.Count > 0)">
            <RadzenStack Orientation="Orientation.Horizontal" Style="width:100%;border-radius: var(--rz-upload-button-bar-border-radius);" class="my-hoverable" AlignItems="AlignItems.Center">
              <RadzenProgressBar Visible="@ShowProgress" ProgressBarStyle="ProgressBarStyle.Success" Style="width:100%;color:var(--rz-text-subtitle2-color); background-color:rgba(0, 0, 0, 0.1);" @bind-Value="@value" />
            </RadzenStack>
            @foreach (var item in myIBrowserFiles)
            {
              <RadzenStack Orientation="Orientation.Horizontal" Style="width:100%;border-radius: var(--rz-upload-button-bar-border-radius);" class="my-hoverable" AlignItems="AlignItems.Center">
                <RadzenText Style="width:32px; margin-bottom:0px; margin-left:5px;" TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">@(item.Id).</RadzenText>
                <div class="rz-text-truncate" style="width: 100%;">@item.File.Name</div>
                <RadzenButton Style="width:28px;" Click=@(args => DeleteFile(args, item)) Size="ButtonSize.ExtraSmall" Icon="close" />
              </RadzenStack>
            }
          </RadzenStack>
        </div>
      </div>
    </div>

  </RadzenColumn>
</RadzenRow>
<style>
  .my-hoverable{
    background-color: var(--rz-upload-button-bar-background-color);
  }
  .my-hoverable:hover {
      background-color: var(--rz-grid-hover-color);
  }
</style>

