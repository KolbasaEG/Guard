@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Radzen
@using Radzen.Blazor
@attribute [Authorize]
<RadzenRow>
  <RadzenColumn Size="12">
    @if (IsEditor)
    {
      <Guard.ComponentLibrary.Uploader.Uploader UploadingFolder="@(Folder)" AutoUpload="true" FileCount="10" ParentStringsChanged="@OnParentStringsChanged" />
    }
    <RadzenTabs RenderMode="TabRenderMode.Client" @bind-SelectedIndex=@selectedIndex Style="margin-top:5px;">
      <Tabs>
        <RadzenTabsItem Text="Изображения" Visible="Images.Count>0">
          <RadzenDataList WrapItems="true" AllowPaging="false" Data="@imagesList" TItem="SelectedFile" Density="Density.Compact">
            <Template Context="item">
              <RadzenCard Style="width: 300px;" Variant="Variant.Text">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Style="height:100%;">
                  <RadzenImage Path="@item.Url" Style="width: 100px; height: 100px;" Click=@(args => ViewImage(args, item)) @onclick:stopPropagation="true" />
                  <RadzenStack Gap="0" Style="width: 100%;height:100%;  overflow: hidden;" Orientation="Orientation.Vertical" AlignItems="AlignItems.End" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenStack Gap="0" Style="width: 100%;height:100%; overflow: hidden;" Orientation="Orientation.Vertical">
                      <RadzenText TextStyle="TextStyle.Body1" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" >
                        <b>@(item.Name)</b>
                      </RadzenText>
                      <RadzenText TextStyle="TextStyle.Overline" class="rz-display-flex rz-mt-2 rz-my-0">@(item.Created)</RadzenText>
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="5px">
                      <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="wallpaper" Size="Radzen.ButtonSize.ExtraSmall"
                                    Shade="Shade.Lighter" Variant="Variant.Flat"
                                    Click=@(args => ViewImage(args, item)) @onclick:stopPropagation="true" />
                      <RadzenButton ButtonStyle="ButtonStyle.Info" Icon="download" Size="Radzen.ButtonSize.ExtraSmall"
                                    Shade="Shade.Lighter" Variant="Variant.Flat"
                                    Click=@(args => DownloadFile(args, item)) @onclick:stopPropagation="true" />
                      <RadzenButton Visible="@(IsEditor)" ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="Radzen.ButtonSize.ExtraSmall"
                                    Shade="Shade.Lighter" Variant="Radzen.Variant.Filled"
                                    Click=@(args => GridDeleteButtonClick(args, item)) @onclick:stopPropagation="true" />
                    </RadzenStack>
                  </RadzenStack>
                </RadzenStack>
              </RadzenCard>
            </Template>
          </RadzenDataList>
          <RadzenPager ShowPagingSummary="true" PagingSummaryFormat="@pagingSummaryFormat" PageChanged="@PageChanged" HorizontalAlign="HorizontalAlign.Right" Count="imagesCount" PageSize="@pageSize" PageNumbersCount="5" />
        </RadzenTabsItem>
        <RadzenTabsItem Text="Файлы" Visible="Files.Count>0">
          <RadzenDataGrid Visible="Files.Count>0" @ref="FilesGrid" IsLoading=@isLoading Data=@Files Count="@filesCount" TItem="SelectedFile" ColumnWidth="200px" AllowFiltering="true" FilterMode="FilterMode.Advanced" AllowPaging="true" AllowSorting="true" PageSizeOptions=@(new int[]{5, 10, 20, 30, 50, 100}) PageSize="5"
                          AllowColumnResize="true" Density="Density.Compact" AndOperatorText="И" ApplyFilterText="Применить" ClearFilterText="Очистить" ContainsText="Содержит" FilterText="Фильтр" EndsWithText="Заканчивается на" EqualsText="Равно"
                          DoesNotContainText="Не содержит" FirstPageTitle="Первая страница" FirstPageAriaLabel="К первой странице" IsEmptyText="Пусто" IsNotEmptyText="Не пусто"
                          LastPageAriaLabel="К последней странице" LastPageTitle="Последняя страница" NextPageTitle="Следующая страница" NotEqualsText="Не равно" OrOperatorText="Или"
                          PageAriaLabelFormat="К странице {0}" PageSizeText="записей на странице" PagingSummaryFormat="Страница {0} из {1} ({2} записей)" PrevPageTitle="Предидущая страница"
                          EmptyText="Записи не найдены" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" StartsWithText="Начинается c" LessThanText="Меньше" LessThanOrEqualsText="Меньше или равно"
                          GreaterThanText="Больше" GreaterThanOrEqualsText="Больше или равно" Style="height:100%;">
            <Columns>
              <RadzenDataGridColumn TItem="SelectedFile" Filterable="false" Sortable="false" Width="30px" TextAlign="TextAlign.Center">
                <Template Context="item">
                  <RadzenIcon Icon="@(item.Icon)" Style="font-size:0.875rem;" title="Имеются изображения!" IconColor="@Colors.InfoDark" />
                </Template>
              </RadzenDataGridColumn>
              <RadzenDataGridColumn TItem="SelectedFile" Property="Name" Title="Наименование" Width="100%" />
              <RadzenDataGridColumn TItem="SelectedFile" Property="Extension" Title="Расширение" Width="100px" />
              <RadzenDataGridColumn TItem="SelectedFile" Property="SizeInMB" Title="Размер в МБ" Width="100px" />
              <RadzenDataGridColumn TItem="SelectedFile" Filterable="false" Sortable="false" Width="100px" Frozen="true" TextAlign="TextAlign.Center" FrozenPosition="FrozenColumnPosition.Right">
                <Template Context="item">
                  <RadzenButton ButtonStyle="ButtonStyle.Info" Icon="download" Size="Radzen.ButtonSize.ExtraSmall"
                                Shade="Shade.Lighter" Variant="Variant.Flat"
                                Click=@(args => DownloadFile(args, item)) @onclick:stopPropagation="true" />
                  <RadzenButton Visible="@(IsEditor)" ButtonStyle="ButtonStyle.Danger" Icon="delete" Size="Radzen.ButtonSize.ExtraSmall"
                                Shade="Shade.Lighter" Variant="Radzen.Variant.Filled"
                                Click=@(args => GridDeleteButtonClick(args, item)) @onclick:stopPropagation="true" />
                </Template>
              </RadzenDataGridColumn>
            </Columns>
          </RadzenDataGrid>

        </RadzenTabsItem>
      </Tabs>
    </RadzenTabs>
  </RadzenColumn>
</RadzenRow>

<style>
  /* Стили для управления переполнением текста */
  .radzen-text {
    overflow: hidden; /* Скрываем переполнение */
    text-overflow: ellipsis; /* Многоточие для обрезанного текста */
    white-space: nowrap; /* Запрещаем перенос текста на новую строку */
  }
</style>