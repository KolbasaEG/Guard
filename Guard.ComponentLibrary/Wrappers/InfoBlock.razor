<RadzenCard Variant="Variant.Outlined" Style="@("padding:10px; border-radius:0px;" + Style)">
  <RadzenStack Orientation="Orientation.Vertical" Gap="10px" Style="height:100%;width:100%;">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Start" Style="width:100%;padding:5px;padding-top:0px;border-bottom:var(--rz-input-focus-border);">
      <RadzenIcon Icon="@Icon" />
      <RadzenText TextStyle="TextStyle.Body1"> <strong>@(Title.ToUpper())</strong></RadzenText>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Vertical"  JustifyContent="JustifyContent.Start" Gap="0px;" Style="height:100%;width:100%;">
      @ChildContent
    </RadzenStack>
  </RadzenStack>
</RadzenCard>
@code {
  [Parameter] public RenderFragment? ChildContent { get; set; }
  [Parameter]
  public string Title { get; set; } = "";
  [Parameter]
  public string Icon { get; set; } = "view_headline";
  [Parameter]
  public string Style { get; set; } = "event_note";
}

