    <bpmn:sequenceFlow id="P07_F10" sourceRef="P07_te" targetRef="P07_terr" name=""/>
    <bpmn:sequenceFlow id="P07_F11" sourceRef="P07_terr" targetRef="P07_tm" name=""/>
