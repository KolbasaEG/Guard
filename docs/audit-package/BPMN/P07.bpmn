      <bpmn:incoming>P07_F6</bpmn:incoming>
      <bpmn:outgoing>P07_F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P07_am" name="Продолжить">
      <bpmn:documentation>Продолжить</bpmn:documentation>
      <bpmn:incoming>P07_F5</bpmn:incoming>
      <bpmn:incoming>P07_F7</bpmn:incoming>
      <bpmn:outgoing>P07_F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P07_technical" name="Удалить старые технические строки до 10 пакетов по 10000">
      <bpmn:documentation>Удалить старые технические строки до 10 пакетов по 10000</bpmn:documentation>
      <bpmn:incoming>P07_F8</bpmn:incoming>
      <bpmn:outgoing>P07_F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="P07_te" name="Ошибка Technical" attachedToRef="P07_technical" cancelActivity="true">
      <bpmn:documentation>Ошибка Technical</bpmn:documentation>
      <bpmn:outgoing>P07_F10</bpmn:outgoing>
      <bpmn:errorEventDefinition id="P07_te_Error"/>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="P07_terr" name="Запомнить ошибку Technical">
      <bpmn:documentation>Запомнить ошибку Technical</bpmn:documentation>
      <bpmn:incoming>P07_F10</bpmn:incoming>
      <bpmn:outgoing>P07_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P07_tm" name="Продолжить">
      <bpmn:documentation>Продолжить</bpmn:documentation>
      <bpmn:incoming>P07_F9</bpmn:incoming>
      <bpmn:incoming>P07_F11</bpmn:incoming>
      <bpmn:outgoing>P07_F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P07_files" name="Удалить только собственные старые лог файлы">
      <bpmn:documentation>Удалить только собственные старые лог файлы</bpmn:documentation>
      <bpmn:incoming>P07_F12</bpmn:incoming>
      <bpmn:outgoing>P07_F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="P07_fe" name="Ошибка Files" attachedToRef="P07_files" cancelActivity="true">
      <bpmn:documentation>Ошибка Files</bpmn:documentation>
      <bpmn:outgoing>P07_F14</bpmn:outgoing>
      <bpmn:errorEventDefinition id="P07_fe_Error"/>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="P07_ferr" name="Запомнить ошибку Files">
      <bpmn:documentation>Запомнить ошибку Files</bpmn:documentation>
      <bpmn:incoming>P07_F14</bpmn:incoming>
      <bpmn:outgoing>P07_F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P07_fm" name="Продолжить">
      <bpmn:documentation>Продолжить</bpmn:documentation>
      <bpmn:incoming>P07_F13</bpmn:incoming>
      <bpmn:incoming>P07_F15</bpmn:incoming>
      <bpmn:outgoing>P07_F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P07_health" name="Обновить LastCleanupUtc и ошибки этапов">
      <bpmn:documentation>Обновить LastCleanupUtc и ошибки этапов</bpmn:documentation>
      <bpmn:incoming>P07_F16</bpmn:incoming>
      <bpmn:outgoing>P07_F17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P07_done" name="Очистка завершена или частична">
