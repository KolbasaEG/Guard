      <bpmn:documentation>Открыть состояние и определить причину</bpmn:documentation>
      <bpmn:incoming>P06_F6</bpmn:incoming>
      <bpmn:incoming>P06_F15</bpmn:incoming>
      <bpmn:outgoing>P06_F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P06_repair" name="Восстановить хранилище или соединение с сопровождением">
      <bpmn:documentation>Восстановить хранилище или соединение с сопровождением</bpmn:documentation>
      <bpmn:incoming>P06_F7</bpmn:incoming>
      <bpmn:outgoing>P06_F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="P06_settings" name="При исправной локальной записи изменить настройки P05" calledElement="P05">
      <bpmn:documentation>При исправной локальной записи изменить настройки P05</bpmn:documentation>
      <bpmn:incoming>P06_F20</bpmn:incoming>
      <bpmn:outgoing>P06_F8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="P06_health" name="Повторить проверку P03" calledElement="P03">
      <bpmn:documentation>Повторить проверку P03</bpmn:documentation>
      <bpmn:incoming>P06_F8</bpmn:incoming>
      <bpmn:incoming>P06_F21</bpmn:incoming>
      <bpmn:outgoing>P06_F9</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="P06_working" name="Аудит исправен" default="P06_F15">
