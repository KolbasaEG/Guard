  </bpmn:collaboration>
  <bpmn:process id="P09" name="Создание и формирование экспорта" isExecutable="false">
    <bpmn:documentation>Запрос и изменения состояний экспорта сопровождаются обязательным аудитом. Worker при неисправном аудите не начинает новую обработку. На контрольных точках повторяются проверки. После restart Processing возвращается в очередь с событием восстановления.</bpmn:documentation>
    <bpmn:laneSet id="P09_Lanes">
      <bpmn:lane id="P09_Lane0" name="Пользователь и сервис">
        <bpmn:flowNodeRef>P09_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_access</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_download</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P09_Lane1" name="Очередь и worker">
        <bpmn:flowNodeRef>P09_queued</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P09_Lane2" name="Файл и обязательный аудит">
        <bpmn:flowNodeRef>P09_make</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_mg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_restart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_recover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P09_downloadRequest</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P09_start" name="Запрос экспорта">
      <bpmn:documentation>Запрос экспорта</bpmn:documentation>
      <bpmn:outgoing>P09_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P09_access" name="Проверить permissions область запрос и аудит">
      <bpmn:documentation>Проверить permissions область запрос и аудит</bpmn:documentation>
      <bpmn:incoming>P09_F1</bpmn:incoming>
      <bpmn:outgoing>P09_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P09_request" name="Сохранить задание и ExportRequested одной транзакцией">
      <bpmn:documentation>Сохранить задание и ExportRequested одной транзакцией</bpmn:documentation>
      <bpmn:incoming>P09_F2</bpmn:incoming>
      <bpmn:outgoing>P09_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P09_queued" name="Ожидать исправного аудита и свободного worker">
      <bpmn:documentation>Ожидать исправного аудита и свободного worker</bpmn:documentation>
      <bpmn:incoming>P09_F3</bpmn:incoming>
      <bpmn:incoming>P09_F12</bpmn:incoming>
      <bpmn:outgoing>P09_F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P09_claim" name="Захватить задание и сохранить ProcessingStarted">
      <bpmn:documentation>Захватить задание и сохранить ProcessingStarted</bpmn:documentation>
      <bpmn:incoming>P09_F4</bpmn:incoming>
      <bpmn:outgoing>P09_F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P09_make" name="Повторять проверки и сформировать файл">
      <bpmn:documentation>Повторять проверки и сформировать файл</bpmn:documentation>
      <bpmn:incoming>P09_F5</bpmn:incoming>
      <bpmn:outgoing>P09_F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P09_mg" name="Формирование успешно">
      <bpmn:documentation>Формирование успешно</bpmn:documentation>
      <bpmn:incoming>P09_F6</bpmn:incoming>
      <bpmn:outgoing>P09_F7</bpmn:outgoing>
      <bpmn:outgoing>P09_F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P09_ready" name="Сохранить артефакт Ready и ExportArchived одной транзакцией">
      <bpmn:documentation>Сохранить артефакт Ready и ExportArchived одной транзакцией</bpmn:documentation>
      <bpmn:incoming>P09_F7</bpmn:incoming>
      <bpmn:outgoing>P09_F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="P09_download" name="Выдача и завершение P10" calledElement="P10">
      <bpmn:documentation>Выдача и завершение P10</bpmn:documentation>
      <bpmn:incoming>P09_F14</bpmn:incoming>
      <bpmn:outgoing>P09_F10</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="P09_failed" name="Сохранить Failed или Cancelled и итоговый аудит">
      <bpmn:documentation>Сохранить Failed или Cancelled и итоговый аудит</bpmn:documentation>
      <bpmn:incoming>P09_F8</bpmn:incoming>
      <bpmn:outgoing>P09_F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P09_end" name="Результат задания доступен при исправном аудите">
      <bpmn:documentation>Результат задания доступен при исправном аудите</bpmn:documentation>
      <bpmn:incoming>P09_F9</bpmn:incoming>
      <bpmn:incoming>P09_F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="P09_restart" name="Worker после перезапуска">
      <bpmn:documentation>Worker после перезапуска</bpmn:documentation>
      <bpmn:outgoing>P09_F11</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P09_recover" name="Processing вернуть в Queued с событием восстановления">
      <bpmn:documentation>Processing вернуть в Queued с событием восстановления</bpmn:documentation>
      <bpmn:incoming>P09_F11</bpmn:incoming>
      <bpmn:outgoing>P09_F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="P09_downloadRequest" name="Запрос пользователя на получение файла">
      <bpmn:documentation>Запрос пользователя на получение файла</bpmn:documentation>
      <bpmn:incoming>P09_F13</bpmn:incoming>
      <bpmn:outgoing>P09_F14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P09_downloadRequest_Message"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="P09_F1" sourceRef="P09_start" targetRef="P09_access" name=""/>
    <bpmn:sequenceFlow id="P09_F2" sourceRef="P09_access" targetRef="P09_request" name=""/>
    <bpmn:sequenceFlow id="P09_F3" sourceRef="P09_request" targetRef="P09_queued" name=""/>
    <bpmn:sequenceFlow id="P09_F4" sourceRef="P09_queued" targetRef="P09_claim" name=""/>
    <bpmn:sequenceFlow id="P09_F5" sourceRef="P09_claim" targetRef="P09_make" name=""/>
    <bpmn:sequenceFlow id="P09_F6" sourceRef="P09_make" targetRef="P09_mg" name=""/>
    <bpmn:sequenceFlow id="P09_F7" sourceRef="P09_mg" targetRef="P09_ready" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P09_F8" sourceRef="P09_mg" targetRef="P09_failed" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P09_F9" sourceRef="P09_failed" targetRef="P09_end" name=""/>
    <bpmn:sequenceFlow id="P09_F10" sourceRef="P09_download" targetRef="P09_end" name=""/>
    <bpmn:sequenceFlow id="P09_F11" sourceRef="P09_restart" targetRef="P09_recover" name=""/>
    <bpmn:sequenceFlow id="P09_F12" sourceRef="P09_recover" targetRef="P09_queued" name=""/>
    <bpmn:sequenceFlow id="P09_F13" sourceRef="P09_ready" targetRef="P09_downloadRequest" name=""/>
    <bpmn:sequenceFlow id="P09_F14" sourceRef="P09_downloadRequest" targetRef="P09_download" name=""/>
  </bpmn:process>
  <bpmn:process id="P10" name="Выдача экспорта и неизвестный результат" isExecutable="false">
    <bpmn:documentation>Передача одноразовая. Проверки доступа и аудита продолжаются при чтении. SentAt аудита и результат передачи файла различаются. При перезапуске незавершённая выдача не объявляется успешной: попытка unknown, задание Failed, требуется новый экспорт.</bpmn:documentation>
    <bpmn:laneSet id="P10_Lanes">
      <bpmn:lane id="P10_Lane0" name="Пользователь и доступ">
        <bpmn:flowNodeRef>P10_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_guard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_begin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P10_Lane1" name="Передача файла">
        <bpmn:flowNodeRef>P10_stream</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_crash</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P10_Lane2" name="Архив и восстановление">
        <bpmn:flowNodeRef>P10_unknown</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_new</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_expire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_expiryCheck</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P10_start" name="Получить готовый файл">
      <bpmn:documentation>Получить готовый файл</bpmn:documentation>
      <bpmn:outgoing>P10_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P10_guard" name="Проверить права stamp срок артефакт и аудит">
      <bpmn:documentation>Проверить права stamp срок артефакт и аудит</bpmn:documentation>
      <bpmn:incoming>P10_F1</bpmn:incoming>
      <bpmn:outgoing>P10_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P10_begin" name="Захватить одноразовую выдачу и записать DeliveryStarted">
      <bpmn:documentation>Захватить одноразовую выдачу и записать DeliveryStarted</bpmn:documentation>
      <bpmn:incoming>P10_F2</bpmn:incoming>
      <bpmn:outgoing>P10_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P10_stream" name="Передавать файл с повторными проверками">
      <bpmn:documentation>Передавать файл с повторными проверками</bpmn:documentation>
      <bpmn:incoming>P10_F3</bpmn:incoming>
      <bpmn:outgoing>P10_F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P10_result" name="Итог передачи известен">
      <bpmn:documentation>Итог передачи известен</bpmn:documentation>
      <bpmn:incoming>P10_F4</bpmn:incoming>
      <bpmn:outgoing>P10_F5</bpmn:outgoing>
      <bpmn:outgoing>P10_F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P10_complete" name="Записать DeliveryCompleted и фактический результат">
      <bpmn:documentation>Записать DeliveryCompleted и фактический результат</bpmn:documentation>
      <bpmn:incoming>P10_F5</bpmn:incoming>
      <bpmn:outgoing>P10_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P10_unknown" name="После restart отметить попытку unknown и задание Failed">
      <bpmn:documentation>После restart отметить попытку unknown и задание Failed</bpmn:documentation>
      <bpmn:incoming>P10_F6</bpmn:incoming>
      <bpmn:incoming>P10_F7</bpmn:incoming>
      <bpmn:outgoing>P10_F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="P10_new" name="При неизвестном исходе создать новый экспорт">
      <bpmn:documentation>При неизвестном исходе создать новый экспорт</bpmn:documentation>
      <bpmn:incoming>P10_F8</bpmn:incoming>
      <bpmn:outgoing>P10_F9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="P10_expire" name="По сроку удалить артефакт и записать ExportExpired">
      <bpmn:documentation>По сроку удалить артефакт и записать ExportExpired</bpmn:documentation>
      <bpmn:incoming>P10_F12</bpmn:incoming>
      <bpmn:outgoing>P10_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P10_end" name="Файл завершён или требуется новое задание">
      <bpmn:documentation>Файл завершён или требуется новое задание</bpmn:documentation>
      <bpmn:incoming>P10_F9</bpmn:incoming>
      <bpmn:incoming>P10_F10</bpmn:incoming>
      <bpmn:incoming>P10_F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="P10_crash" name="Worker после перезапуска">
      <bpmn:documentation>Worker после перезапуска</bpmn:documentation>
      <bpmn:outgoing>P10_F7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="P10_expiryCheck" name="Проверка сроков каждые 30 секунд">
      <bpmn:documentation>Проверка сроков каждые 30 секунд</bpmn:documentation>
      <bpmn:outgoing>P10_F12</bpmn:outgoing>
      <bpmn:timerEventDefinition id="P10_expiryCheck_Timer">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="P10_F1" sourceRef="P10_start" targetRef="P10_guard" name=""/>
    <bpmn:sequenceFlow id="P10_F2" sourceRef="P10_guard" targetRef="P10_begin" name=""/>
    <bpmn:sequenceFlow id="P10_F3" sourceRef="P10_begin" targetRef="P10_stream" name=""/>
    <bpmn:sequenceFlow id="P10_F4" sourceRef="P10_stream" targetRef="P10_result" name=""/>
    <bpmn:sequenceFlow id="P10_F5" sourceRef="P10_result" targetRef="P10_complete" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P10_F6" sourceRef="P10_result" targetRef="P10_unknown" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P10_F7" sourceRef="P10_crash" targetRef="P10_unknown" name=""/>
    <bpmn:sequenceFlow id="P10_F8" sourceRef="P10_unknown" targetRef="P10_new" name=""/>
    <bpmn:sequenceFlow id="P10_F9" sourceRef="P10_new" targetRef="P10_end" name=""/>
    <bpmn:sequenceFlow id="P10_F10" sourceRef="P10_complete" targetRef="P10_end" name=""/>
    <bpmn:sequenceFlow id="P10_F11" sourceRef="P10_expire" targetRef="P10_end" name=""/>
    <bpmn:sequenceFlow id="P10_F12" sourceRef="P10_expiryCheck" targetRef="P10_expire" name=""/>
  </bpmn:process>
