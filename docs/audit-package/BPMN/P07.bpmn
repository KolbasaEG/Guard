      <bpmn:incoming>P07_F3</bpmn:incoming>
      <bpmn:outgoing>P07_F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P07_audit" name="Удалить старые Local и доставленные до 10 пакетов по 1000">
      <bpmn:documentation>Удалить старые Local и доставленные до 10 пакетов по 1000</bpmn:documentation>
