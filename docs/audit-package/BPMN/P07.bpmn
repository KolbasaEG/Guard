  <bpmn:process id="P07" name="Хранение и независимая очистка" isExecutable="false">
    <bpmn:documentation>Цикл каждые 5 минут. Срок от даты события в календарных годах. Неотправленные обязательные события сохраняются в обоих режимах. Ошибка одного этапа не отменяет следующие. Последний корректный срок кэшируется в процессе.</bpmn:documentation>
    <bpmn:laneSet id="P07_Lanes">
      <bpmn:lane id="P07_Lane0" name="Настройки">
        <bpmn:flowNodeRef>P07_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_read</bpmn:flowNodeRef>
