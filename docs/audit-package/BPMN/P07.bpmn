  <bpmn:process id="P08" name="Проверка TLS соединения и тестового события" isExecutable="false">
    <bpmn:documentation>Проверка использует поля формы без сохранения настроек. Начало и результат записываются разными EventId. В RuSIEM нужно искать EventId начала, указанный в сообщении интерфейса. Подтверждение приёма выполняет Root отдельно.</bpmn:documentation>
    <bpmn:laneSet id="P08_Lanes">
      <bpmn:lane id="P08_Lane0" name="Root">
        <bpmn:flowNodeRef>P08_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_blocked</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_find</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P08_Lane1" name="Guard и журнал">
        <bpmn:flowNodeRef>P08_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_intent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_local</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_unverified</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P08_Lane2" name="TLS транспорт">
        <bpmn:flowNodeRef>P08_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_sent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_unknown</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P08_start" name="Проверить соединение">
      <bpmn:documentation>Проверить соединение</bpmn:documentation>
      <bpmn:outgoing>P08_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P08_validate" name="Проверить актуального Root адрес порт и публичный CA">
      <bpmn:documentation>Проверить актуального Root адрес порт и публичный CA</bpmn:documentation>
      <bpmn:incoming>P08_F1</bpmn:incoming>
      <bpmn:outgoing>P08_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P08_intent" name="Сохранить started и EventId теста локально">
      <bpmn:documentation>Сохранить started и EventId теста локально</bpmn:documentation>
      <bpmn:incoming>P08_F2</bpmn:incoming>
      <bpmn:outgoing>P08_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P08_local" name="Локальная запись доступна" default="P08_F12">
      <bpmn:documentation>Локальная запись доступна</bpmn:documentation>
      <bpmn:incoming>P08_F3</bpmn:incoming>
      <bpmn:outgoing>P08_F4</bpmn:outgoing>
      <bpmn:outgoing>P08_F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P08_blocked" name="Тест запрещён до восстановления записи">
      <bpmn:documentation>Тест запрещён до восстановления записи</bpmn:documentation>
      <bpmn:incoming>P08_F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="P08_send" name="Выполнить TLS и Syslog CEF в адрес из формы">
      <bpmn:documentation>Выполнить TLS и Syslog CEF в адрес из формы</bpmn:documentation>
      <bpmn:incoming>P08_F4</bpmn:incoming>
      <bpmn:outgoing>P08_F5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="P08_sent" name="Запись по TLS завершена">
      <bpmn:documentation>Запись по TLS завершена</bpmn:documentation>
      <bpmn:incoming>P08_F5</bpmn:incoming>
      <bpmn:outgoing>P08_F6</bpmn:outgoing>
      <bpmn:outgoing>P08_F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P08_fail" name="Сохранить failure с новым EventId">
      <bpmn:documentation>Сохранить failure с новым EventId</bpmn:documentation>
      <bpmn:incoming>P08_F7</bpmn:incoming>
      <bpmn:outgoing>P08_F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P08_success" name="Сохранить success с новым EventId">
      <bpmn:documentation>Сохранить success с новым EventId</bpmn:documentation>
      <bpmn:incoming>P08_F6</bpmn:incoming>
      <bpmn:outgoing>P08_F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P08_result" name="Подтверждение результата получено" default="P08_F13">
      <bpmn:documentation>Подтверждение результата получено</bpmn:documentation>
      <bpmn:incoming>P08_F9</bpmn:incoming>
      <bpmn:outgoing>P08_F10</bpmn:outgoing>
      <bpmn:outgoing>P08_F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P08_unknown" name="Проверить фактическое состояние до повтора">
      <bpmn:documentation>Проверить фактическое состояние до повтора</bpmn:documentation>
      <bpmn:incoming>P08_F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P08_find" name="Найти исходный EventId в RuSIEM и проверить поля">
      <bpmn:documentation>Найти исходный EventId в RuSIEM и проверить поля</bpmn:documentation>
      <bpmn:incoming>P08_F10</bpmn:incoming>
      <bpmn:outgoing>P08_F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P08_found" name="Событие найдено и разобрано" default="P08_F15">
      <bpmn:documentation>Событие найдено и разобрано</bpmn:documentation>
      <bpmn:incoming>P08_F11</bpmn:incoming>
      <bpmn:outgoing>P08_F14</bpmn:outgoing>
      <bpmn:outgoing>P08_F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P08_ok" name="Сквозная проверка подтверждена Root">
      <bpmn:documentation>Сквозная проверка подтверждена Root</bpmn:documentation>
      <bpmn:incoming>P08_F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P08_unverified" name="Проверка не завершена передать администратору SIEM">
      <bpmn:documentation>Проверка не завершена передать администратору SIEM</bpmn:documentation>
      <bpmn:incoming>P08_F8</bpmn:incoming>
      <bpmn:incoming>P08_F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P08_F1" sourceRef="P08_start" targetRef="P08_validate" name=""/>
    <bpmn:sequenceFlow id="P08_F2" sourceRef="P08_validate" targetRef="P08_intent" name=""/>
    <bpmn:sequenceFlow id="P08_F3" sourceRef="P08_intent" targetRef="P08_local" name=""/>
    <bpmn:sequenceFlow id="P08_F4" sourceRef="P08_local" targetRef="P08_send" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P08_F5" sourceRef="P08_send" targetRef="P08_sent" name=""/>
    <bpmn:sequenceFlow id="P08_F6" sourceRef="P08_sent" targetRef="P08_success" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P08_F7" sourceRef="P08_sent" targetRef="P08_fail" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P08_F8" sourceRef="P08_fail" targetRef="P08_unverified" name=""/>
    <bpmn:sequenceFlow id="P08_F9" sourceRef="P08_success" targetRef="P08_result" name=""/>
    <bpmn:sequenceFlow id="P08_F10" sourceRef="P08_result" targetRef="P08_find" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P08_F11" sourceRef="P08_find" targetRef="P08_found" name=""/>
    <bpmn:sequenceFlow id="P08_F12" sourceRef="P08_local" targetRef="P08_blocked" name="Нет"/>
    <bpmn:sequenceFlow id="P08_F13" sourceRef="P08_result" targetRef="P08_unknown" name="Commit неизвестен"/>
    <bpmn:sequenceFlow id="P08_F14" sourceRef="P08_found" targetRef="P08_ok" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P08_F15" sourceRef="P08_found" targetRef="P08_unverified" name="Нет"/>
