<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="GuardAuditDefinitions" targetNamespace="https://guard.local/audit/bpmn" exporter="Guard audit documentation" exporterVersion="1.0">
  <bpmn:message id="Message_CEF" name="Syslog TLS CEF событие с EventId"/>
  <bpmn:process id="P00" name="Обращение к системе и выбор процесса" isExecutable="false">
    <bpmn:documentation>Карта процессов. Доставка P04 и очистка P07 работают независимо по таймеру; P03 вызывается запросами и циклом состояния каждые 5 секунд. Модель описательная, не предназначена для запуска workflow engine.</bpmn:documentation>
    <bpmn:laneSet id="P00_Lanes">
      <bpmn:lane id="P00_Lane0" name="Пользователь или Root">
        <bpmn:flowNodeRef>P00_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_csrf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_out</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P00_Lane1" name="Guard">
        <bpmn:flowNodeRef>P00_classify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_kind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_work</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_settings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P00_start" name="Обращение">
      <bpmn:documentation>Обращение</bpmn:documentation>
      <bpmn:outgoing>P00_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P00_classify" name="Определить маршрут и тип операции">
      <bpmn:documentation>Определить маршрут и тип операции</bpmn:documentation>
      <bpmn:incoming>P00_F1</bpmn:incoming>
      <bpmn:outgoing>P00_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P00_kind" name="Какое действие">
      <bpmn:documentation>Какое действие</bpmn:documentation>
      <bpmn:incoming>P00_F2</bpmn:incoming>
      <bpmn:outgoing>P00_F3</bpmn:outgoing>
      <bpmn:outgoing>P00_F4</bpmn:outgoing>
      <bpmn:outgoing>P00_F5</bpmn:outgoing>
      <bpmn:outgoing>P00_F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="P00_login" name="Вход в систему P01" calledElement="P01">
      <bpmn:documentation>Вход в систему P01</bpmn:documentation>
      <bpmn:incoming>P00_F3</bpmn:incoming>
      <bpmn:outgoing>P00_F9</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="P00_work" name="Рабочая операция P02" calledElement="P02">
      <bpmn:documentation>Рабочая операция P02</bpmn:documentation>
      <bpmn:incoming>P00_F4</bpmn:incoming>
      <bpmn:outgoing>P00_F10</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="P00_settings" name="Настройки Root P05" calledElement="P05">
      <bpmn:documentation>Настройки Root P05</bpmn:documentation>
      <bpmn:incoming>P00_F5</bpmn:incoming>
      <bpmn:outgoing>P00_F11</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="P00_csrf" name="Проверить CSRF выхода">
      <bpmn:documentation>Проверить CSRF выхода</bpmn:documentation>
      <bpmn:incoming>P00_F6</bpmn:incoming>
      <bpmn:outgoing>P00_F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P00_out" name="Удалить cookie и попытаться записать Logout">
      <bpmn:documentation>Удалить cookie и попытаться записать Logout</bpmn:documentation>
      <bpmn:incoming>P00_F7</bpmn:incoming>
      <bpmn:outgoing>P00_F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P00_end" name="Результат и дальнейшее действие">
      <bpmn:documentation>Результат и дальнейшее действие</bpmn:documentation>
      <bpmn:incoming>P00_F8</bpmn:incoming>
      <bpmn:incoming>P00_F9</bpmn:incoming>
      <bpmn:incoming>P00_F10</bpmn:incoming>
      <bpmn:incoming>P00_F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P00_F1" sourceRef="P00_start" targetRef="P00_classify" name=""/>
    <bpmn:sequenceFlow id="P00_F2" sourceRef="P00_classify" targetRef="P00_kind" name=""/>
    <bpmn:sequenceFlow id="P00_F3" sourceRef="P00_kind" targetRef="P00_login" name="Вход">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Вход</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P00_F4" sourceRef="P00_kind" targetRef="P00_work" name="Работа">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Работа</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P00_F5" sourceRef="P00_kind" targetRef="P00_settings" name="Настройки">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Настройки</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P00_F6" sourceRef="P00_kind" targetRef="P00_csrf" name="Выход">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Выход</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P00_F7" sourceRef="P00_csrf" targetRef="P00_out" name=""/>
    <bpmn:sequenceFlow id="P00_F8" sourceRef="P00_out" targetRef="P00_end" name=""/>
    <bpmn:sequenceFlow id="P00_F9" sourceRef="P00_login" targetRef="P00_end" name=""/>
    <bpmn:sequenceFlow id="P00_F10" sourceRef="P00_work" targetRef="P00_end" name=""/>
    <bpmn:sequenceFlow id="P00_F11" sourceRef="P00_settings" targetRef="P00_end" name=""/>
  </bpmn:process>
  <bpmn:process id="P01" name="Обычный вход и отказ в доступе" isExecutable="false">
    <bpmn:documentation>Одна попытка входа имеет итоговое событие. Смена счётчика и наступление lockout могут иметь дополнительные связанные события. Успешная cookie выдаётся только после LoginSuccess. Включённая 2FA в локальном сценарии не поддерживается.</bpmn:documentation>
    <bpmn:laneSet id="P01_Lanes">
      <bpmn:lane id="P01_Lane0" name="Клиент и HTTP">
        <bpmn:flowNodeRef>P01_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_rg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_ag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_recovery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_formok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P01_Lane1" name="Identity и доступ">
        <bpmn:flowNodeRef>P01_identity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_ig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_cookie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P01_Lane2" name="Обязательный аудит">
        <bpmn:flowNodeRef>P01_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_sg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_unknown</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P01_start" name="POST входа">
      <bpmn:documentation>POST входа</bpmn:documentation>
      <bpmn:outgoing>P01_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P01_rate" name="Лимит 5 запросов на IP в минуту">
      <bpmn:documentation>Лимит 5 запросов на IP в минуту</bpmn:documentation>
      <bpmn:incoming>P01_F1</bpmn:incoming>
      <bpmn:outgoing>P01_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P01_rg" name="Лимит соблюдён" default="P01_F4">
      <bpmn:documentation>Лимит соблюдён</bpmn:documentation>
      <bpmn:incoming>P01_F2</bpmn:incoming>
      <bpmn:outgoing>P01_F3</bpmn:outgoing>
      <bpmn:outgoing>P01_F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P01_form" name="Проверить форму и обязательные поля">
      <bpmn:documentation>Проверить форму и обязательные поля</bpmn:documentation>
      <bpmn:incoming>P01_F3</bpmn:incoming>
      <bpmn:outgoing>P01_F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="P01_probe" name="Проверить аудит P03" calledElement="P03">
      <bpmn:documentation>Проверить аудит P03</bpmn:documentation>
      <bpmn:incoming>P01_F19</bpmn:incoming>
      <bpmn:outgoing>P01_F5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="P01_ag" name="Обычная работа разрешена" default="P01_F7">
      <bpmn:documentation>Обычная работа разрешена</bpmn:documentation>
      <bpmn:incoming>P01_F5</bpmn:incoming>
      <bpmn:outgoing>P01_F6</bpmn:outgoing>
      <bpmn:outgoing>P01_F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="P01_recovery" name="Ограниченный вход Root P06" calledElement="P06">
      <bpmn:documentation>Ограниченный вход Root P06</bpmn:documentation>
      <bpmn:incoming>P01_F7</bpmn:incoming>
      <bpmn:outgoing>P01_F8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="P01_identity" name="Найти аккаунт и проверить пароль политику IP и 2FA">
      <bpmn:documentation>Найти аккаунт и проверить пароль политику IP и 2FA</bpmn:documentation>
      <bpmn:incoming>P01_F6</bpmn:incoming>
      <bpmn:outgoing>P01_F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P01_ig" name="Вход разрешён" default="P01_F11">
      <bpmn:documentation>Вход разрешён</bpmn:documentation>
      <bpmn:incoming>P01_F9</bpmn:incoming>
      <bpmn:outgoing>P01_F10</bpmn:outgoing>
      <bpmn:outgoing>P01_F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P01_reject" name="Попытаться сохранить итог отказа и причину">
      <bpmn:documentation>Попытаться сохранить итог отказа и причину</bpmn:documentation>
      <bpmn:incoming>P01_F4</bpmn:incoming>
      <bpmn:incoming>P01_F11</bpmn:incoming>
      <bpmn:incoming>P01_F20</bpmn:incoming>
      <bpmn:outgoing>P01_F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P01_denied" name="Обычный доступ не предоставлен">
      <bpmn:documentation>Обычный доступ не предоставлен</bpmn:documentation>
      <bpmn:incoming>P01_F8</bpmn:incoming>
      <bpmn:incoming>P01_F12</bpmn:incoming>
      <bpmn:incoming>P01_F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P01_record" name="Сохранить LoginSuccess до cookie">
      <bpmn:documentation>Сохранить LoginSuccess до cookie</bpmn:documentation>
      <bpmn:incoming>P01_F10</bpmn:incoming>
      <bpmn:outgoing>P01_F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P01_sg" name="Запись подтверждена" default="P01_F16">
      <bpmn:documentation>Запись подтверждена</bpmn:documentation>
      <bpmn:incoming>P01_F13</bpmn:incoming>
      <bpmn:outgoing>P01_F14</bpmn:outgoing>
      <bpmn:outgoing>P01_F15</bpmn:outgoing>
      <bpmn:outgoing>P01_F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P01_cookie" name="Выдать обычную cookie и обновить активность">
      <bpmn:documentation>Выдать обычную cookie и обновить активность</bpmn:documentation>
      <bpmn:incoming>P01_F14</bpmn:incoming>
      <bpmn:outgoing>P01_F17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P01_ok" name="Обычная сессия">
      <bpmn:documentation>Обычная сессия</bpmn:documentation>
      <bpmn:incoming>P01_F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P01_unknown" name="Исход сохранения неизвестен проверить состояние">
      <bpmn:documentation>Исход сохранения неизвестен проверить состояние</bpmn:documentation>
      <bpmn:incoming>P01_F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P01_formok" name="Форма корректна" default="P01_F20">
      <bpmn:documentation>Форма корректна</bpmn:documentation>
      <bpmn:incoming>P01_F18</bpmn:incoming>
      <bpmn:outgoing>P01_F19</bpmn:outgoing>
      <bpmn:outgoing>P01_F20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P01_F1" sourceRef="P01_start" targetRef="P01_rate" name=""/>
    <bpmn:sequenceFlow id="P01_F2" sourceRef="P01_rate" targetRef="P01_rg" name=""/>
    <bpmn:sequenceFlow id="P01_F3" sourceRef="P01_rg" targetRef="P01_form" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P01_F4" sourceRef="P01_rg" targetRef="P01_reject" name="Нет HTTP 429"/>
    <bpmn:sequenceFlow id="P01_F5" sourceRef="P01_probe" targetRef="P01_ag" name=""/>
    <bpmn:sequenceFlow id="P01_F6" sourceRef="P01_ag" targetRef="P01_identity" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P01_F7" sourceRef="P01_ag" targetRef="P01_recovery" name="Нет"/>
    <bpmn:sequenceFlow id="P01_F8" sourceRef="P01_recovery" targetRef="P01_denied" name="Обычная cookie не выдаётся"/>
    <bpmn:sequenceFlow id="P01_F9" sourceRef="P01_identity" targetRef="P01_ig" name=""/>
    <bpmn:sequenceFlow id="P01_F10" sourceRef="P01_ig" targetRef="P01_record" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P01_F11" sourceRef="P01_ig" targetRef="P01_reject" name="Нет"/>
    <bpmn:sequenceFlow id="P01_F12" sourceRef="P01_reject" targetRef="P01_denied" name=""/>
    <bpmn:sequenceFlow id="P01_F13" sourceRef="P01_record" targetRef="P01_sg" name=""/>
    <bpmn:sequenceFlow id="P01_F14" sourceRef="P01_sg" targetRef="P01_cookie" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P01_F15" sourceRef="P01_sg" targetRef="P01_denied" name="Доказанный отказ">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Доказанный отказ</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P01_F16" sourceRef="P01_sg" targetRef="P01_unknown" name="Подтверждение потеряно"/>
    <bpmn:sequenceFlow id="P01_F17" sourceRef="P01_cookie" targetRef="P01_ok" name=""/>
    <bpmn:sequenceFlow id="P01_F18" sourceRef="P01_form" targetRef="P01_formok" name=""/>
    <bpmn:sequenceFlow id="P01_F19" sourceRef="P01_formok" targetRef="P01_probe" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P01_F20" sourceRef="P01_formok" targetRef="P01_reject" name="Нет InvalidInput"/>
  </bpmn:process>
  <bpmn:process id="P02" name="Обычная операция и атомарность аудита" isExecutable="false">
    <bpmn:documentation>Проверки остаются на сервере, включая старый Blazor circuit. Состояние P03 проверяет текущую очередь; перед обязательной вставкой дополнительно резервируется место под новые события. Обычные чтения самостоятельных событий не создают.</bpmn:documentation>
    <bpmn:laneSet id="P02_Lanes">
      <bpmn:lane id="P02_Lane0" name="Сервис доступа">
        <bpmn:flowNodeRef>P02_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_gate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_kind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_deny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_export</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P02_Lane1" name="Чтение данных">
        <bpmn:flowNodeRef>P02_query</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_recheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_readok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P02_Lane2" name="Транзакция изменения">
        <bpmn:flowNodeRef>P02_begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_insert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_cg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_rollback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_unknown</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_writeError</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P02_start" name="Запрос операции">
      <bpmn:documentation>Запрос операции</bpmn:documentation>
      <bpmn:outgoing>P02_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P02_session" name="Проверить stamp роли область и отсутствие recovery only">
      <bpmn:documentation>Проверить stamp роли область и отсутствие recovery only</bpmn:documentation>
      <bpmn:incoming>P02_F1</bpmn:incoming>
      <bpmn:outgoing>P02_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="P02_probe" name="Проверить аудит P03" calledElement="P03">
      <bpmn:documentation>Проверить аудит P03</bpmn:documentation>
      <bpmn:incoming>P02_F2</bpmn:incoming>
      <bpmn:outgoing>P02_F3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="P02_gate" name="Доступ разрешён" default="P02_F12">
      <bpmn:documentation>Доступ разрешён</bpmn:documentation>
      <bpmn:incoming>P02_F3</bpmn:incoming>
      <bpmn:outgoing>P02_F4</bpmn:outgoing>
      <bpmn:outgoing>P02_F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P02_kind" name="Тип операции">
      <bpmn:documentation>Тип операции</bpmn:documentation>
      <bpmn:incoming>P02_F4</bpmn:incoming>
      <bpmn:outgoing>P02_F5</bpmn:outgoing>
      <bpmn:outgoing>P02_F7</bpmn:outgoing>
      <bpmn:outgoing>P02_F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P02_deny" name="Операция запрещена">
      <bpmn:documentation>Операция запрещена</bpmn:documentation>
      <bpmn:incoming>P02_F11</bpmn:incoming>
      <bpmn:incoming>P02_F12</bpmn:incoming>
      <bpmn:incoming>P02_F20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P02_query" name="Прочитать DTO в серверной области">
      <bpmn:documentation>Прочитать DTO в серверной области</bpmn:documentation>
      <bpmn:incoming>P02_F5</bpmn:incoming>
      <bpmn:outgoing>P02_F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P02_recheck" name="Перепроверить доступ перед возвратом">
      <bpmn:documentation>Перепроверить доступ перед возвратом</bpmn:documentation>
      <bpmn:incoming>P02_F6</bpmn:incoming>
      <bpmn:outgoing>P02_F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P02_return" name="Вернуть данные без события просмотра">
      <bpmn:documentation>Вернуть данные без события просмотра</bpmn:documentation>
      <bpmn:incoming>P02_F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P02_begin" name="Начать транзакцию и сохранить изменение">
      <bpmn:documentation>Начать транзакцию и сохранить изменение</bpmn:documentation>
      <bpmn:incoming>P02_F7</bpmn:incoming>
      <bpmn:outgoing>P02_F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P02_insert" name="Под QueueLock проверить лимиты и вставить обязательный аудит">
      <bpmn:documentation>Под QueueLock проверить лимиты и вставить обязательный аудит</bpmn:documentation>
      <bpmn:incoming>P02_F8</bpmn:incoming>
      <bpmn:outgoing>P02_F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P02_commit" name="Выполнить общий commit">
      <bpmn:documentation>Выполнить общий commit</bpmn:documentation>
      <bpmn:incoming>P02_F9</bpmn:incoming>
      <bpmn:outgoing>P02_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P02_cg" name="Результат commit" default="P02_F16">
      <bpmn:documentation>Результат commit</bpmn:documentation>
      <bpmn:incoming>P02_F10</bpmn:incoming>
      <bpmn:outgoing>P02_F14</bpmn:outgoing>
      <bpmn:outgoing>P02_F15</bpmn:outgoing>
      <bpmn:outgoing>P02_F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P02_done" name="Изменение и аудит сохранены">
      <bpmn:documentation>Изменение и аудит сохранены</bpmn:documentation>
      <bpmn:incoming>P02_F14</bpmn:incoming>
      <bpmn:incoming>P02_F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P02_rollback" name="Откатить известную незавершённую транзакцию">
      <bpmn:documentation>Откатить известную незавершённую транзакцию</bpmn:documentation>
      <bpmn:incoming>P02_F15</bpmn:incoming>
      <bpmn:incoming>P02_F21</bpmn:incoming>
      <bpmn:outgoing>P02_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P02_unknown" name="Проверить фактическое состояние до повтора">
      <bpmn:documentation>Проверить фактическое состояние до повтора</bpmn:documentation>
      <bpmn:incoming>P02_F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="P02_export" name="Экспорт P09" calledElement="P09">
      <bpmn:documentation>Экспорт P09</bpmn:documentation>
      <bpmn:incoming>P02_F13</bpmn:incoming>
      <bpmn:outgoing>P02_F17</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="P02_readok" name="Повторная проверка успешна" default="P02_F20">
      <bpmn:documentation>Повторная проверка успешна</bpmn:documentation>
      <bpmn:incoming>P02_F18</bpmn:incoming>
      <bpmn:outgoing>P02_F19</bpmn:outgoing>
      <bpmn:outgoing>P02_F20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:boundaryEvent id="P02_writeError" name="Ошибка до commit" attachedToRef="P02_insert" cancelActivity="true">
      <bpmn:documentation>Ошибка до commit</bpmn:documentation>
      <bpmn:outgoing>P02_F21</bpmn:outgoing>
      <bpmn:errorEventDefinition id="P02_writeError_Error"/>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="P02_F1" sourceRef="P02_start" targetRef="P02_session" name=""/>
    <bpmn:sequenceFlow id="P02_F2" sourceRef="P02_session" targetRef="P02_probe" name=""/>
    <bpmn:sequenceFlow id="P02_F3" sourceRef="P02_probe" targetRef="P02_gate" name=""/>
    <bpmn:sequenceFlow id="P02_F4" sourceRef="P02_gate" targetRef="P02_kind" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P02_F5" sourceRef="P02_kind" targetRef="P02_query" name="Чтение">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Чтение</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P02_F6" sourceRef="P02_query" targetRef="P02_recheck" name=""/>
    <bpmn:sequenceFlow id="P02_F7" sourceRef="P02_kind" targetRef="P02_begin" name="Изменение">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Изменение</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P02_F8" sourceRef="P02_begin" targetRef="P02_insert" name=""/>
    <bpmn:sequenceFlow id="P02_F9" sourceRef="P02_insert" targetRef="P02_commit" name=""/>
    <bpmn:sequenceFlow id="P02_F10" sourceRef="P02_commit" targetRef="P02_cg" name=""/>
    <bpmn:sequenceFlow id="P02_F11" sourceRef="P02_rollback" targetRef="P02_deny" name=""/>
    <bpmn:sequenceFlow id="P02_F12" sourceRef="P02_gate" targetRef="P02_deny" name="Нет"/>
    <bpmn:sequenceFlow id="P02_F13" sourceRef="P02_kind" targetRef="P02_export" name="Экспорт">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Экспорт</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P02_F14" sourceRef="P02_cg" targetRef="P02_done" name="Подтверждён">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Подтверждён</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P02_F15" sourceRef="P02_cg" targetRef="P02_rollback" name="Откат подтверждён">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Откат подтверждён</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P02_F16" sourceRef="P02_cg" targetRef="P02_unknown" name="Подтверждение потеряно"/>
    <bpmn:sequenceFlow id="P02_F17" sourceRef="P02_export" targetRef="P02_done" name="Задание принято с аудитом"/>
    <bpmn:sequenceFlow id="P02_F18" sourceRef="P02_recheck" targetRef="P02_readok" name=""/>
    <bpmn:sequenceFlow id="P02_F19" sourceRef="P02_readok" targetRef="P02_return" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P02_F20" sourceRef="P02_readok" targetRef="P02_deny" name="Нет"/>
    <bpmn:sequenceFlow id="P02_F21" sourceRef="P02_writeError" targetRef="P02_rollback" name=""/>
  </bpmn:process>
  <bpmn:process id="P03" name="Определение доступности аудита" isExecutable="false">
    <bpmn:documentation>Один вызов проверки. Фоновый вызов повторяется каждые 5 секунд; HTTP и серверные операции вызывают проверку независимо. Проба вставляется и удаляется в одной подтверждённой транзакции, не создавая историю просмотров.</bpmn:documentation>
    <bpmn:laneSet id="P03_Lanes">
      <bpmn:lane id="P03_Lane0" name="Проверка локального хранения">
        <bpmn:flowNodeRef>P03_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_probe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_storage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_not</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_invalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_ready</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P03_Lane1" name="Настройки и очередь">
        <bpmn:flowNodeRef>P03_config</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_configured</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_mode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_limits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_limit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_blocked</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P03_start" name="Запрос проверки">
      <bpmn:documentation>Запрос проверки</bpmn:documentation>
      <bpmn:outgoing>P03_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P03_probe" name="Прочитать настройки и очередь выполнить INSERT DELETE пробы и commit">
      <bpmn:documentation>Прочитать настройки и очередь выполнить INSERT DELETE пробы и commit</bpmn:documentation>
      <bpmn:incoming>P03_F1</bpmn:incoming>
      <bpmn:outgoing>P03_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P03_store" name="Commit пробы подтверждён" default="P03_F4">
      <bpmn:documentation>Commit пробы подтверждён</bpmn:documentation>
      <bpmn:incoming>P03_F2</bpmn:incoming>
      <bpmn:outgoing>P03_F3</bpmn:outgoing>
      <bpmn:outgoing>P03_F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P03_storage" name="StorageUnavailable">
      <bpmn:documentation>StorageUnavailable</bpmn:documentation>
      <bpmn:incoming>P03_F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P03_config" name="Оценить прочитанные настройки и очередь">
      <bpmn:documentation>Оценить прочитанные настройки и очередь</bpmn:documentation>
      <bpmn:incoming>P03_F3</bpmn:incoming>
      <bpmn:outgoing>P03_F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P03_configured" name="Режим подтверждён" default="P03_F7">
      <bpmn:documentation>Режим подтверждён</bpmn:documentation>
      <bpmn:incoming>P03_F5</bpmn:incoming>
      <bpmn:outgoing>P03_F6</bpmn:outgoing>
      <bpmn:outgoing>P03_F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P03_not" name="NotConfigured">
      <bpmn:documentation>NotConfigured</bpmn:documentation>
      <bpmn:incoming>P03_F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P03_valid" name="Настройки допустимы" default="P03_F9">
      <bpmn:documentation>Настройки допустимы</bpmn:documentation>
      <bpmn:incoming>P03_F6</bpmn:incoming>
      <bpmn:outgoing>P03_F8</bpmn:outgoing>
      <bpmn:outgoing>P03_F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P03_invalid" name="InvalidConfiguration">
      <bpmn:documentation>InvalidConfiguration</bpmn:documentation>
      <bpmn:incoming>P03_F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P03_mode" name="Локальный режим" default="P03_F11">
      <bpmn:documentation>Локальный режим</bpmn:documentation>
      <bpmn:incoming>P03_F8</bpmn:incoming>
      <bpmn:outgoing>P03_F10</bpmn:outgoing>
      <bpmn:outgoing>P03_F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P03_limits" name="Проверить возраст байты и количество pending">
      <bpmn:documentation>Проверить возраст байты и количество pending</bpmn:documentation>
      <bpmn:incoming>P03_F11</bpmn:incoming>
      <bpmn:outgoing>P03_F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P03_limit" name="Пределы соблюдены" default="P03_F14">
      <bpmn:documentation>Пределы соблюдены</bpmn:documentation>
      <bpmn:incoming>P03_F12</bpmn:incoming>
      <bpmn:outgoing>P03_F13</bpmn:outgoing>
      <bpmn:outgoing>P03_F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P03_ready" name="Ready обычная работа разрешена">
      <bpmn:documentation>Ready обычная работа разрешена</bpmn:documentation>
      <bpmn:incoming>P03_F10</bpmn:incoming>
      <bpmn:incoming>P03_F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P03_blocked" name="QueueAgeExceeded или QueueVolumeExceeded">
      <bpmn:documentation>QueueAgeExceeded или QueueVolumeExceeded</bpmn:documentation>
      <bpmn:incoming>P03_F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P03_F1" sourceRef="P03_start" targetRef="P03_probe" name=""/>
    <bpmn:sequenceFlow id="P03_F2" sourceRef="P03_probe" targetRef="P03_store" name=""/>
    <bpmn:sequenceFlow id="P03_F3" sourceRef="P03_store" targetRef="P03_config" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P03_F4" sourceRef="P03_store" targetRef="P03_storage" name="Нет или неизвестен"/>
    <bpmn:sequenceFlow id="P03_F5" sourceRef="P03_config" targetRef="P03_configured" name=""/>
    <bpmn:sequenceFlow id="P03_F6" sourceRef="P03_configured" targetRef="P03_valid" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P03_F7" sourceRef="P03_configured" targetRef="P03_not" name="Нет"/>
    <bpmn:sequenceFlow id="P03_F8" sourceRef="P03_valid" targetRef="P03_mode" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P03_F9" sourceRef="P03_valid" targetRef="P03_invalid" name="Нет"/>
    <bpmn:sequenceFlow id="P03_F10" sourceRef="P03_mode" targetRef="P03_ready" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P03_F11" sourceRef="P03_mode" targetRef="P03_limits" name="Нет SIEM"/>
    <bpmn:sequenceFlow id="P03_F12" sourceRef="P03_limits" targetRef="P03_limit" name=""/>
    <bpmn:sequenceFlow id="P03_F13" sourceRef="P03_limit" targetRef="P03_ready" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P03_F14" sourceRef="P03_limit" targetRef="P03_blocked" name="Нет"/>
  </bpmn:process>
  <bpmn:process id="P04" name="Доставка обязательной очереди в RuSIEM" isExecutable="false">
    <bpmn:documentation>Цикл доставки каждые 2 секунды, до 25 событий. Аренда 2 минуты. Pending сохраняются при любых сетевых отказах. Успешная запись по TLS не является подтверждением сохранения в SIEM. При падении процесса возможен повтор того же EventId.</bpmn:documentation>
    <bpmn:laneSet id="P04_Lanes">
      <bpmn:lane id="P04_Lane0" name="Worker и PostgreSQL">
        <bpmn:flowNodeRef>P04_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_mode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_enabled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_paused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_exists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_attempt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_batch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P04_Lane1" name="TLS транспорт">
        <bpmn:flowNodeRef>P04_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_result</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P04_Lane2" name="Фиксация попытки">
        <bpmn:flowNodeRef>P04_retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_crash</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P04_start" name="Цикл каждые 2 секунды">
      <bpmn:documentation>Цикл каждые 2 секунды</bpmn:documentation>
      <bpmn:outgoing>P04_F1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="P04_start_Timer">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">PT2S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P04_mode" name="Прочитать настройки под QueueLock">
      <bpmn:documentation>Прочитать настройки под QueueLock</bpmn:documentation>
      <bpmn:incoming>P04_F1</bpmn:incoming>
      <bpmn:outgoing>P04_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P04_enabled" name="SIEM включён и настроен" default="P04_F4">
      <bpmn:documentation>SIEM включён и настроен</bpmn:documentation>
      <bpmn:incoming>P04_F2</bpmn:incoming>
      <bpmn:outgoing>P04_F3</bpmn:outgoing>
      <bpmn:outgoing>P04_F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P04_paused" name="В Local очередь сохранена и приостановлена">
      <bpmn:documentation>В Local очередь сохранена и приостановлена</bpmn:documentation>
      <bpmn:incoming>P04_F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P04_claim" name="Выбрать pending SKIP LOCKED и выдать lease на 2 минуты">
      <bpmn:documentation>Выбрать pending SKIP LOCKED и выдать lease на 2 минуты</bpmn:documentation>
      <bpmn:incoming>P04_F3</bpmn:incoming>
      <bpmn:incoming>P04_F15</bpmn:incoming>
      <bpmn:outgoing>P04_F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P04_exists" name="Событие найдено" default="P04_F7">
      <bpmn:documentation>Событие найдено</bpmn:documentation>
      <bpmn:incoming>P04_F5</bpmn:incoming>
      <bpmn:outgoing>P04_F6</bpmn:outgoing>
      <bpmn:outgoing>P04_F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P04_attempt" name="Сохранить начало попытки адресат и Attempts">
      <bpmn:documentation>Сохранить начало попытки адресат и Attempts</bpmn:documentation>
      <bpmn:incoming>P04_F6</bpmn:incoming>
      <bpmn:outgoing>P04_F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="P04_send" name="Проверить TLS и записать Syslog CEF">
      <bpmn:documentation>Проверить TLS и записать Syslog CEF</bpmn:documentation>
      <bpmn:incoming>P04_F8</bpmn:incoming>
      <bpmn:outgoing>P04_F9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="P04_result" name="Запись по TLS завершена" default="P04_F12">
      <bpmn:documentation>Запись по TLS завершена</bpmn:documentation>
      <bpmn:incoming>P04_F9</bpmn:incoming>
      <bpmn:outgoing>P04_F10</bpmn:outgoing>
      <bpmn:outgoing>P04_F11</bpmn:outgoing>
      <bpmn:outgoing>P04_F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P04_success" name="Записать SentAtUtc и успешную попытку">
      <bpmn:documentation>Записать SentAtUtc и успешную попытку</bpmn:documentation>
      <bpmn:incoming>P04_F11</bpmn:incoming>
      <bpmn:outgoing>P04_F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P04_retry" name="Записать ошибку и следующую попытку 10 с до 1 ч">
      <bpmn:documentation>Записать ошибку и следующую попытку 10 с до 1 ч</bpmn:documentation>
      <bpmn:incoming>P04_F12</bpmn:incoming>
      <bpmn:outgoing>P04_F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P04_batch" name="Менее 25 событий и нет отмены" default="P04_F16">
      <bpmn:documentation>Менее 25 событий и нет отмены</bpmn:documentation>
      <bpmn:incoming>P04_F13</bpmn:incoming>
      <bpmn:incoming>P04_F14</bpmn:incoming>
      <bpmn:outgoing>P04_F15</bpmn:outgoing>
      <bpmn:outgoing>P04_F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P04_done" name="Ожидать следующий цикл">
      <bpmn:documentation>Ожидать следующий цикл</bpmn:documentation>
      <bpmn:incoming>P04_F7</bpmn:incoming>
      <bpmn:incoming>P04_F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P04_crash" name="При обрыве lease истечёт и исход попытки останется неизвестным">
      <bpmn:documentation>При обрыве lease истечёт и исход попытки останется неизвестным</bpmn:documentation>
      <bpmn:incoming>P04_F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P04_F1" sourceRef="P04_start" targetRef="P04_mode" name=""/>
    <bpmn:sequenceFlow id="P04_F2" sourceRef="P04_mode" targetRef="P04_enabled" name=""/>
    <bpmn:sequenceFlow id="P04_F3" sourceRef="P04_enabled" targetRef="P04_claim" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P04_F4" sourceRef="P04_enabled" targetRef="P04_paused" name="Нет"/>
    <bpmn:sequenceFlow id="P04_F5" sourceRef="P04_claim" targetRef="P04_exists" name=""/>
    <bpmn:sequenceFlow id="P04_F6" sourceRef="P04_exists" targetRef="P04_attempt" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P04_F7" sourceRef="P04_exists" targetRef="P04_done" name="Нет"/>
    <bpmn:sequenceFlow id="P04_F8" sourceRef="P04_attempt" targetRef="P04_send" name=""/>
    <bpmn:sequenceFlow id="P04_F9" sourceRef="P04_send" targetRef="P04_result" name=""/>
    <bpmn:sequenceFlow id="P04_F10" sourceRef="P04_result" targetRef="P04_crash" name="Отмена процесса">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Отмена процесса</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P04_F11" sourceRef="P04_result" targetRef="P04_success" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P04_F12" sourceRef="P04_result" targetRef="P04_retry" name="Нет"/>
    <bpmn:sequenceFlow id="P04_F13" sourceRef="P04_success" targetRef="P04_batch" name=""/>
    <bpmn:sequenceFlow id="P04_F14" sourceRef="P04_retry" targetRef="P04_batch" name=""/>
    <bpmn:sequenceFlow id="P04_F15" sourceRef="P04_batch" targetRef="P04_claim" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P04_F16" sourceRef="P04_batch" targetRef="P04_done" name="Нет"/>
  </bpmn:process>
  <bpmn:collaboration id="P04_Collaboration">
    <bpmn:participant id="P04_Guard" name="Guard" processRef="P04"/>
    <bpmn:participant id="P04_SIEM" name="RuSIEM внешняя система"/>
    <bpmn:messageFlow id="P04_CEF" sourceRef="P04_send" targetRef="P04_SIEM" messageRef="Message_CEF" name="Syslog TLS CEF"/>
  </bpmn:collaboration>
  <bpmn:process id="P05" name="Изменение настроек и переключение режимов" isExecutable="false">
    <bpmn:documentation>Настройки применяются только после проверки актуального Root, версии и обязательного события. Изменение host port или CA при pending требует отдельного подтверждения. Старые Local события не ретроотправляются; возраст прежней обязательной очереди сохраняется.</bpmn:documentation>
    <bpmn:laneSet id="P05_Lanes">
      <bpmn:lane id="P05_Lane0" name="Root">
        <bpmn:flowNodeRef>P05_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_consent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P05_Lane1" name="Сервер и блокировки">
        <bpmn:flowNodeRef>P05_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_lock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_version</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_target</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_lease</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P05_Lane2" name="Транзакция аудита">
        <bpmn:flowNodeRef>P05_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_unknown</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P05_start" name="Сохранить настройки">
      <bpmn:documentation>Сохранить настройки</bpmn:documentation>
      <bpmn:outgoing>P05_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P05_validate" name="Проверить поля и актуального Root">
      <bpmn:documentation>Проверить поля и актуального Root</bpmn:documentation>
      <bpmn:incoming>P05_F1</bpmn:incoming>
      <bpmn:outgoing>P05_F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P05_lock" name="Начать транзакцию взять security lock и QueueLock">
      <bpmn:documentation>Начать транзакцию взять security lock и QueueLock</bpmn:documentation>
      <bpmn:incoming>P05_F2</bpmn:incoming>
      <bpmn:outgoing>P05_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P05_version" name="Root и версия актуальны" default="P05_F12">
      <bpmn:documentation>Root и версия актуальны</bpmn:documentation>
      <bpmn:incoming>P05_F3</bpmn:incoming>
      <bpmn:outgoing>P05_F4</bpmn:outgoing>
      <bpmn:outgoing>P05_F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P05_denied" name="Отказ перечитать настройки или войти заново">
      <bpmn:documentation>Отказ перечитать настройки или войти заново</bpmn:documentation>
      <bpmn:incoming>P05_F12</bpmn:incoming>
      <bpmn:incoming>P05_F13</bpmn:incoming>
      <bpmn:incoming>P05_F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P05_target" name="Адресат изменён и есть pending">
      <bpmn:documentation>Адресат изменён и есть pending</bpmn:documentation>
      <bpmn:incoming>P05_F4</bpmn:incoming>
      <bpmn:outgoing>P05_F5</bpmn:outgoing>
      <bpmn:outgoing>P05_F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P05_confirm" name="Отдельно подтвердить перенос обязательной очереди">
      <bpmn:documentation>Отдельно подтвердить перенос обязательной очереди</bpmn:documentation>
      <bpmn:incoming>P05_F5</bpmn:incoming>
      <bpmn:outgoing>P05_F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P05_consent" name="Подтверждение есть" default="P05_F13">
      <bpmn:documentation>Подтверждение есть</bpmn:documentation>
      <bpmn:incoming>P05_F6</bpmn:incoming>
      <bpmn:outgoing>P05_F7</bpmn:outgoing>
      <bpmn:outgoing>P05_F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P05_lease" name="Есть активная отправка при смене режима или адресата" default="P05_F14">
      <bpmn:documentation>Есть активная отправка при смене режима или адресата</bpmn:documentation>
      <bpmn:incoming>P05_F7</bpmn:incoming>
      <bpmn:incoming>P05_F8</bpmn:incoming>
      <bpmn:outgoing>P05_F9</bpmn:outgoing>
      <bpmn:outgoing>P05_F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P05_wait" name="Повторить после отправки или истечения аренды">
      <bpmn:documentation>Повторить после отправки или истечения аренды</bpmn:documentation>
      <bpmn:incoming>P05_F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P05_save" name="Сохранить версию режим и при необходимости назначение pending">
      <bpmn:documentation>Сохранить версию режим и при необходимости назначение pending</bpmn:documentation>
      <bpmn:incoming>P05_F9</bpmn:incoming>
      <bpmn:outgoing>P05_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P05_audit" name="Вставить событие настроек и выполнить общий commit">
      <bpmn:documentation>Вставить событие настроек и выполнить общий commit</bpmn:documentation>
      <bpmn:incoming>P05_F10</bpmn:incoming>
      <bpmn:outgoing>P05_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P05_commit" name="Общий commit подтверждён" default="P05_F17">
      <bpmn:documentation>Общий commit подтверждён</bpmn:documentation>
      <bpmn:incoming>P05_F11</bpmn:incoming>
      <bpmn:outgoing>P05_F15</bpmn:outgoing>
      <bpmn:outgoing>P05_F16</bpmn:outgoing>
      <bpmn:outgoing>P05_F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P05_ok" name="Настройки действуют">
      <bpmn:documentation>Настройки действуют</bpmn:documentation>
      <bpmn:incoming>P05_F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P05_unknown" name="Результат неизвестен перечитать фактическую версию">
      <bpmn:documentation>Результат неизвестен перечитать фактическую версию</bpmn:documentation>
      <bpmn:incoming>P05_F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P05_F1" sourceRef="P05_start" targetRef="P05_validate" name=""/>
    <bpmn:sequenceFlow id="P05_F2" sourceRef="P05_validate" targetRef="P05_lock" name=""/>
    <bpmn:sequenceFlow id="P05_F3" sourceRef="P05_lock" targetRef="P05_version" name=""/>
    <bpmn:sequenceFlow id="P05_F4" sourceRef="P05_version" targetRef="P05_target" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P05_F5" sourceRef="P05_target" targetRef="P05_confirm" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P05_F6" sourceRef="P05_confirm" targetRef="P05_consent" name=""/>
    <bpmn:sequenceFlow id="P05_F7" sourceRef="P05_consent" targetRef="P05_lease" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P05_F8" sourceRef="P05_target" targetRef="P05_lease" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P05_F9" sourceRef="P05_lease" targetRef="P05_save" name="Нет активной отправки">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет активной отправки</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P05_F10" sourceRef="P05_save" targetRef="P05_audit" name=""/>
    <bpmn:sequenceFlow id="P05_F11" sourceRef="P05_audit" targetRef="P05_commit" name=""/>
    <bpmn:sequenceFlow id="P05_F12" sourceRef="P05_version" targetRef="P05_denied" name="Нет"/>
    <bpmn:sequenceFlow id="P05_F13" sourceRef="P05_consent" targetRef="P05_denied" name="Нет"/>
    <bpmn:sequenceFlow id="P05_F14" sourceRef="P05_lease" targetRef="P05_wait" name="Да"/>
    <bpmn:sequenceFlow id="P05_F15" sourceRef="P05_commit" targetRef="P05_ok" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P05_F16" sourceRef="P05_commit" targetRef="P05_denied" name="Известный отказ откат">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Известный отказ откат</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P05_F17" sourceRef="P05_commit" targetRef="P05_unknown" name="Подтверждение потеряно"/>
  </bpmn:process>
  <bpmn:process id="P06" name="Ограниченный вход и восстановление Root" isExecutable="false">
    <bpmn:documentation>Ограниченный вход выдаётся только при запрещённой обычной работе и доступной Identity. Проверяется фактическая роль Root, hash пароля, блокировки и отсутствие 2FA. Неверная recovery попытка не увеличивает Identity failure counter и не создаёт отдельный LoginFailed внутри RecoveryAsync.</bpmn:documentation>
    <bpmn:laneSet id="P06_Lanes">
      <bpmn:lane id="P06_Lane0" name="Root">
        <bpmn:flowNodeRef>P06_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_refuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_diagnose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_ttl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_expired</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P06_Lane1" name="Identity и ограниченная сессия">
        <bpmn:flowNodeRef>P06_rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_identity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_cookie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_event</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_rateok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P06_Lane2" name="Восстановление">
        <bpmn:flowNodeRef>P06_external</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_settings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_health</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_working</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_needsettings</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P06_start" name="Аудит запрещает обычный вход">
      <bpmn:documentation>Аудит запрещает обычный вход</bpmn:documentation>
      <bpmn:outgoing>P06_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P06_rate" name="Применить отдельный лимит 5 на IP в минуту">
      <bpmn:documentation>Применить отдельный лимит 5 на IP в минуту</bpmn:documentation>
      <bpmn:incoming>P06_F1</bpmn:incoming>
      <bpmn:outgoing>P06_F16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P06_identity" name="Identity доступна" default="P06_F13">
      <bpmn:documentation>Identity доступна</bpmn:documentation>
      <bpmn:incoming>P06_F17</bpmn:incoming>
      <bpmn:outgoing>P06_F2</bpmn:outgoing>
      <bpmn:outgoing>P06_F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P06_external" name="Выход и обслуживание сервера">
      <bpmn:documentation>Выход и обслуживание сервера</bpmn:documentation>
      <bpmn:incoming>P06_F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P06_verify" name="Проверить пароль Root блокировки и отсутствие 2FA">
      <bpmn:documentation>Проверить пароль Root блокировки и отсутствие 2FA</bpmn:documentation>
      <bpmn:incoming>P06_F2</bpmn:incoming>
      <bpmn:outgoing>P06_F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P06_valid" name="Условия соблюдены" default="P06_F14">
      <bpmn:documentation>Условия соблюдены</bpmn:documentation>
      <bpmn:incoming>P06_F3</bpmn:incoming>
      <bpmn:outgoing>P06_F4</bpmn:outgoing>
      <bpmn:outgoing>P06_F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P06_refuse" name="Общий отказ без cookie">
      <bpmn:documentation>Общий отказ без cookie</bpmn:documentation>
      <bpmn:incoming>P06_F14</bpmn:incoming>
      <bpmn:incoming>P06_F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P06_cookie" name="Выдать recovery only cookie на 15 минут без продления">
      <bpmn:documentation>Выдать recovery only cookie на 15 минут без продления</bpmn:documentation>
      <bpmn:incoming>P06_F4</bpmn:incoming>
      <bpmn:outgoing>P06_F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P06_event" name="Попытаться записать RecoverySignIn">
      <bpmn:documentation>Попытаться записать RecoverySignIn</bpmn:documentation>
      <bpmn:incoming>P06_F5</bpmn:incoming>
      <bpmn:outgoing>P06_F6</bpmn:outgoing>
    </bpmn:serviceTask>
