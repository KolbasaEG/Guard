        <bpmn:flowNodeRef>P07_cutoff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_health</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P07_Lane1" name="Хранилища и файлы">
        <bpmn:flowNodeRef>P07_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_ae</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_am</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_technical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_te</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_tm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_files</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_fe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_fm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P07_Lane2" name="Диагностика">
        <bpmn:flowNodeRef>P07_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_aerr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_terr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_ferr</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P07_start" name="Цикл каждые 5 минут">
      <bpmn:documentation>Цикл каждые 5 минут</bpmn:documentation>
      <bpmn:outgoing>P07_F1</bpmn:outgoing>
