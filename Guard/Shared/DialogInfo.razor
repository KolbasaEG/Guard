<Guard.Components.Layout.Components.AccessDialog ReadPermission="@ReadPermission">
@using Guard.Components.Library.Views
@using Microsoft.AspNetCore.Authorization
@using Radzen.Blazor
@using Radzen
@attribute [Authorize]

<EntityInfo >
  @if (Compact)
  {
    <RadzenTable Style="width:100%;table-layout:fixed;" aria-label="Служебные сведения">
      <RadzenTableBody>
        @foreach (var row in CompactRows)
        {
          <RadzenTableRow>
            <RadzenTableCell Style="padding:2px;width:40%;overflow-wrap:anywhere;background:var(--rz-grid-header-background-color);vertical-align:top;">
              <RadzenStack Gap="5px" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start">
                <RadzenIcon Icon="@row.Icon" Style="font-size:16px;flex-shrink:0;" aria-hidden="true" />
                <span>@row.Label</span>
              </RadzenStack>
            </RadzenTableCell>
            <RadzenTableCell Style="padding:2px;overflow-wrap:anywhere;vertical-align:top;">@(string.IsNullOrWhiteSpace(row.Value) ? "—" : row.Value)</RadzenTableCell>
          </RadzenTableRow>
        }
      </RadzenTableBody>
    </RadzenTable>
  }
  else
  {
  <RadzenTable Style="width:100%;">
    <RadzenTableBody>
      <RadzenTableRow>
        <RadzenTableCell>
          Id
        </RadzenTableCell>
        <RadzenTableCell>
          @(Info.Id.ToString())
        </RadzenTableCell>
      </RadzenTableRow>
      <RadzenTableRow>
        <RadzenTableCell>
          Дата создания
        </RadzenTableCell>
        <RadzenTableCell>
          @(Time.Format(Info.InsertedDate, "dd.MM.yyyy HH:mm:ss"))
         </RadzenTableCell>
      </RadzenTableRow>
      <RadzenTableRow>
        <RadzenTableCell>
          Создал
        </RadzenTableCell>
        <RadzenTableCell>
          @Info.Creator
        </RadzenTableCell>
      </RadzenTableRow>
      <RadzenTableRow>
        <RadzenTableCell>
          Дата последнего редактирования
        </RadzenTableCell>
        <RadzenTableCell>
          @(Info.LastModifiedDate.HasValue
            ? Time.Format(Info.LastModifiedDate.Value, "dd.MM.yyyy HH:mm:ss")
            : "—")
        </RadzenTableCell>
      </RadzenTableRow>
      <RadzenTableRow>
        <RadzenTableCell>
          Редактировал
        </RadzenTableCell>
        <RadzenTableCell>
          @Info.Editor
        </RadzenTableCell>
      </RadzenTableRow>
    </RadzenTableBody>
  </RadzenTable>
  }
</EntityInfo>
</Guard.Components.Layout.Components.AccessDialog>

@code {
  private IEnumerable<(string Icon, string Label, string? Value)> CompactRows => [
    ("fingerprint", "Идентификатор", Info.Id.ToString()),
    ("event", "Создано", Time.Format(Info.InsertedDate, "dd.MM.yyyy HH:mm:ss")),
    ("person_outline", "Создал", Info.Creator),
    ("edit_calendar", "Изменено", Info.LastModifiedDate.HasValue ? Time.Format(Info.LastModifiedDate.Value, "dd.MM.yyyy HH:mm:ss") : null),
    ("manage_accounts", "Редактировал", Info.Editor)
  ];
}
