@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
<div class="table-template">
  <RadzenSplitter Orientation="Orientation.Vertical" style="height: 100%; background-color: var(--rz-tabs-background-color);">
    <RadzenSplitterPane Size="260px">
      <RadzenSplitter>
        <RadzenSplitterPane Min="30%" Max="70%">
          <AnalitycsWrapper Title="@AnalitycsTitle" Icon="@AnalitycsIcon" Buttons="@AnalitycsButtons">
            @Analitycs
          </AnalitycsWrapper>
        </RadzenSplitterPane>
        <RadzenSplitterPane>
          <AnalitycsWrapper Title="Фильтрация данных" Icon="feature_search" Buttons="@FilterButtons">
            @Filter
          </AnalitycsWrapper>
        </RadzenSplitterPane>
      </RadzenSplitter>
    </RadzenSplitterPane>
    <RadzenSplitterPane>
      <RadzenCard Variant="Variant.Outlined" Style="height:100%; padding:5px;">
        @Table
      </RadzenCard>
    </RadzenSplitterPane>
  </RadzenSplitter>
</div>

@code {
  [Parameter] public RenderFragment? Table { get; set; }
  [Parameter] public RenderFragment? Filter { get; set; }
  [Parameter] public RenderFragment? FilterButtons { get; set; }
  [Parameter] public RenderFragment? Analitycs { get; set; }
  [Parameter] public RenderFragment? AnalitycsButtons { get; set; }
  [Parameter] public string AnalitycsTitle { get; set; } = "Аналитическая информация";
  [Parameter] public string AnalitycsIcon { get; set; } = "analytics";
}
