<RadzenCard Style="width:100%; height:46px; border-radius:0px; border:var(--rz-grid-cell-border);box-shadow: var(--rz-grid-shadow); padding:5px; background-color:var(--rz-grid-header-background-color);flex-shrink:0;">
  <RadzenStack Gap="5px" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Style="width:100%;min-width:0;height:100%;">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Start" Gap="2px" Style="min-width:0;">
            <RadzenIcon Icon="@Icon" Style="margin:0; color:var(--rz-menu-top-item-color);flex-shrink:0;" />
            <RadzenText TextStyle="TextStyle.Body1" Style="margin:0; color:var(--rz-menu-top-item-color);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><strong>@Name</strong></RadzenText>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0px" Style="height:100%;flex-shrink:0;">
      @Menue
            <RadzenButton Icon="info" Click="InfoButtonClick" Visible="ShowInfoButton" Disabled="IsBusy" title="Дополнительная информация" aria-label="Дополнительная информация" ButtonStyle="Radzen.ButtonStyle.Light" Size="Radzen.ButtonSize.Medium" Variant="Variant.Text" Style="border-radius:0px; color:var(--rz-menu-top-item-color);" />
            <RadzenButton Icon="save" ButtonType="ButtonType.Submit" Visible="ShowSaveButton" Disabled="IsBusy" title="Сохранить" aria-label="Сохранить" ButtonStyle="Radzen.ButtonStyle.Light" Size="Radzen.ButtonSize.Medium" Variant="Variant.Text" Style="border-radius:0px; color:var(--rz-menu-top-item-color);" />
            <RadzenButton Icon="close" Click="CancelButtonClick" Visible="ShowCancelButton" title="Закрыть" aria-label="Закрыть" ButtonStyle="Radzen.ButtonStyle.Light" Size="Radzen.ButtonSize.Medium" Variant="Variant.Text" Style="border-radius:0px; color:var(--rz-menu-top-item-color);" />
    </RadzenStack>
  </RadzenStack>
</RadzenCard>

@code {
  [Parameter] public bool ShowCancelButton { get; set; } = true;
  [Parameter] public RenderFragment? Menue { get; set; }
  [Parameter] public bool ShowSaveButton { get; set; } = true;
  [Parameter] public bool ShowInfoButton { get; set; } = false;
  [Parameter] public bool IsBusy { get; set; }

  [Parameter] public string Name { get; set; } = "Просмотр";
  [Parameter] public string Icon { get; set; } = "event_note";

  [Parameter] public EventCallback OnInfoClick { get; set; }
  [Parameter] public EventCallback OnCancelButtonClick { get; set; }

  private async Task InfoButtonClick()
  {
    if (OnInfoClick.HasDelegate)
    {
      await OnInfoClick.InvokeAsync();
    }
  }

  private async Task CancelButtonClick()
  {
    if (OnCancelButtonClick.HasDelegate)
    {
      await OnCancelButtonClick.InvokeAsync();
    }
  }
}
