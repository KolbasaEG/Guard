@using Guard.Components.Library.Loading
@typeparam TItem

<RadzenStack Style="width:100%;height:100%;" Gap="0px">
  @if (Data != null) {
    @if (StaticFormName != null) {
      <EditForm Model="@Data" FormName="@StaticFormName" OnValidSubmit="FormSubmit" method="post" Style="width:100%;">
        @FormContent
      </EditForm>
    } else {
      <RadzenTemplateForm Submit="FormSubmit" TItem="TItem" Data="@Data" Style="width:100%;height:100%; padding:0px; margin:0px;">
        @FormContent
      </RadzenTemplateForm>
    }
  }
</RadzenStack>
@code {
  [Parameter] public string? StaticFormName { get; set; }
  private RenderFragment FormContent => @<RadzenStack Style="width:100%;height:100%;" Gap="0px">
      @if (ContentOnly) {
        <LoadingContainer IsLoading="IsLoading">
          @if (CanView) {
            <fieldset disabled="@EffectiveReadOnly" style="@FieldStyle">@ChildContent</fieldset>
          }
        </LoadingContainer>
      } else {
      <Guard.Components.Library.Cards.CardHeader
        Icon="@Icon"
        Name="@Name"
        ShowSaveButton="@(ShowSaveButton && !EffectiveReadOnly && CanView)"
        ShowInfoButton="@(ShowInfoButton && CanView)"
        ShowCancelButton="@(StaticFormName == null)"
        OnInfoClick="InfoButtonClick"
        OnCancelButtonClick="CancelButtonClick" />

      @if (AccessState?.Message != null) { <RadzenAlert AlertStyle="AlertStyle.Warning">@AccessState.Message</RadzenAlert> }
      <RadzenStack Orientation="Orientation.Horizontal" Gap="5px;" Style="flex: 1; min-height: 0; width:100%; margin-top:5px;">
        <RadzenStack Gap="0px" Orientation="Orientation.Vertical" Style="height:100%; width:100%;min-height:0;">
          <LoadingContainer IsLoading="IsLoading">
            <RadzenCard Variant="Variant.Outlined" Style="padding:5px; border-radius:0px;height:100%;display:flex; flex-direction:column;">
              <RadzenStack Gap="0px" Orientation="Orientation.Vertical" Style="height:100%; width:100%;">
                @if (CanView) {
                  <fieldset disabled="@EffectiveReadOnly" style="@FieldStyle">@ChildContent</fieldset>
                }
              </RadzenStack>
            </RadzenCard>
          </LoadingContainer>
        </RadzenStack>
      </RadzenStack>
      }
    </RadzenStack>;
  [Parameter] public bool ContentOnly { get; set; }
  [CascadingParameter] public Guard.Components.Library.Authorization.DialogAccessState? AccessState { get; set; }
  private bool CanView => AccessState?.CanView != false;
  private bool EffectiveReadOnly => ReadOnly || IsLoading || submitting || AccessState?.CanWrite == false;
  private bool submitting;
  private string FieldStyle => "border:0;margin:0;padding:0;width:100%;" + (EffectiveReadOnly ? "pointer-events:none;" : "");
  [Parameter] public bool ReadOnly { get; set; }
  [Parameter] public bool ShowSaveButton { get; set; } = true;
  [Parameter] public bool ShowInfoButton { get; set; } = false;

  [Parameter] public TItem? Data { get; set; }
  [Parameter] public string Name { get; set; } = "РЕДАКТИРОВАНИЕ";
  [Parameter] public string Icon { get; set; } = "edit_square";
  [Parameter] public bool IsLoading { get; set; }

  [Parameter] public RenderFragment? ChildContent { get; set; }
  [Parameter] public EventCallback Submit { get; set; }
  [Parameter] public EventCallback OnInfoClick { get; set; }
  [Parameter] public EventCallback OnCancelButtonClick { get; set; }

  private async Task InfoButtonClick()
  {
    if (OnInfoClick.HasDelegate)
    {
      await OnInfoClick.InvokeAsync();
    }
  }

  protected async Task FormSubmit()
  {
    if (submitting || IsLoading || ReadOnly) return;
    submitting = true;
    try {
      if (AccessState != null) await AccessState.RefreshAsync();
      if (!CanView || ReadOnly || IsLoading || AccessState?.CanWrite == false) return;
      await Submit.InvokeAsync();
    }
    finally { submitting = false; if (AccessState != null) await AccessState.RefreshAsync(); }
  }

  protected async Task CancelButtonClick()
  {
    if (OnCancelButtonClick.HasDelegate)
    {
      await OnCancelButtonClick.InvokeAsync();
    }
  }
}
