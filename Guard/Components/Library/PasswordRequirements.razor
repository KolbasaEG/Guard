@inject IPasswordRequirementsService Policies
@implements IDisposable
@if (policy != null) {
  <p>Пароль: от @policy.MinimumLength до 100 символов; различных символов — не менее @policy.UniqueCharacters.
    @(policy.RequireDigit ? "Нужна цифра." : "")
    @(policy.RequireLowercase ? "Нужна строчная латинская буква." : "")
    @(policy.RequireUppercase ? "Нужна прописная латинская буква." : "")
    @(policy.RequireSymbol ? "Нужен специальный символ." : "")
  </p>
}
@code {
  private Guard.Core.Services.DTOs.PasswordRequirementsDto? policy;
  private readonly CancellationTokenSource stop = new();
  private bool disposed;
  protected override async Task OnInitializedAsync()
  {
    var ct = stop.Token;
    try { var result = await Policies.GetRequirementsAsync(ct); if (!disposed) policy = result; }
    catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
  }
  public void Dispose() { if (disposed) return; disposed = true; stop.Cancel(); stop.Dispose(); }
}
