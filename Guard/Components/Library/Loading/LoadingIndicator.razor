<div class="loading-overlay" style="@(IsLoading ? "display: flex;" : "display: none;")">
  <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Info" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
</div>
@code {
  public bool IsLoading { get; set; } = false;
  public void SetLoadingState(bool state = false)
  {
    IsLoading = state;
    StateHasChanged();
  }

}
