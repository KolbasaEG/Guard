<RadzenCard Variant="Variant.Outlined" Style="height:100%;width:100%;box-sizing:border-box;padding:5px;border-radius:0px;">
  <RadzenCard Variant="Variant.Outlined" Style="height:100%;padding:5px;border-radius:0px;display:flex;flex-direction:column;min-height:0;min-width:0;">
        <RadzenCard Style="width:100%;height:36px;min-height:36px;border-radius:0px;border:var(--rz-grid-cell-border);box-shadow: var(--rz-grid-shadow);padding:0px;background-color:var(--rz-grid-header-background-color);flex-shrink:0;">
      <RadzenStack Gap="10px" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Style="width:100%;height:100%;min-width:0;">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Start" Gap="0px" Style="min-width:0;">
                    <RadzenIcon Icon="@Icon" Style="margin:8px;color:var(--rz-menu-top-item-color);margin-right:15px;margin-left:12px;flex-shrink:0;" />
                    <RadzenText TextStyle="TextStyle.Body1" Style="margin-right:15px;color:var(--rz-menu-top-item-color);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><strong>@Title</strong></RadzenText>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0px" Style="height:100%;flex-shrink:0;">
          @Buttons
        </RadzenStack>
      </RadzenStack>
    </RadzenCard>
    <div style="flex:1;min-height:0;min-width:0;overflow:auto;padding-top:5px;">
      @ChildContent
    </div>
  </RadzenCard>
</RadzenCard>

@code {
  [Parameter] public string Title { get; set; } = "Аналитическая информация";
  [Parameter] public string Icon { get; set; } = "analytics";
  [Parameter] public RenderFragment? Buttons { get; set; }
  [Parameter] public RenderFragment? ChildContent { get; set; }
}
