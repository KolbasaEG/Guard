<div class="analytics-wrapper">
<RadzenCard Variant="Variant.Outlined" Style="height:100%;width:100%;box-sizing:border-box;padding:5px;border-radius:0px;">
        <div class="analytics-header">
      <RadzenStack Gap="5px" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Style="width:100%;height:100%;min-width:0;">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Start" Gap="0px" Style="min-width:0;">
                    <RadzenIcon Icon="@Icon" Style="margin-inline:5px;color:var(--rz-menu-top-item-color);flex-shrink:0;" />
                    <RadzenText TextStyle="TextStyle.Body1" Style="margin:0;color:var(--rz-menu-top-item-color);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><strong>@Title</strong></RadzenText>
        </RadzenStack>
        <RadzenStack Class="analytics-header-buttons" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0px" Style="height:100%;flex-shrink:0;">
          @Buttons
        </RadzenStack>
      </RadzenStack>
    </div>
    <div class="@(FillContent ? "analytics-content analytics-content-fill" : "analytics-content")">
      @ChildContent
    </div>
</RadzenCard>
</div>

@code {
  [Parameter] public string Title { get; set; } = "Аналитическая информация";
  [Parameter] public string Icon { get; set; } = "analytics";
  [Parameter] public RenderFragment? Buttons { get; set; }
  [Parameter] public RenderFragment? ChildContent { get; set; }
  [Parameter] public bool FillContent { get; set; }
}
