@inject DialogService DialogService;
<Guard.Components.Library.Cards.CardHeader Icon="@Icon" Name="@Name" ShowSaveButton="false" OnCancelButtonClick="CancelButtonClick">
  <Menue>
    @Menue
  </Menue>
</Guard.Components.Library.Cards.CardHeader>
<RadzenCard Variant="Variant.Outlined">
  @Body
</RadzenCard>
@code {
  [Parameter] public RenderFragment? Body { get; set; }
  [Parameter] public RenderFragment? Menue { get; set; }

  [Parameter]
  public string Name { get; set; } = "Помещение в архив";
  [Parameter]
  public string Icon { get; set; } = "inventory_2";

  private void CancelButtonClick() => DialogService.Close(null);
}
