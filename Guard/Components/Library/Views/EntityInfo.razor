@inject DialogService DialogService;

<RadzenStack Style="width:100%;height:100%;min-height:0;" Gap="5px">
    <Guard.Components.Library.Cards.CardHeader Icon="@Icon" Name="@Name" ShowSaveButton="false" ShowInfoButton="false" OnCancelButtonClick="CancelButtonClick" />

        <RadzenCard Class="guard-entity-body" Variant="Variant.Outlined" Style="padding:5px; border-radius:0px;flex:1;display:flex; flex-direction:column;">
            @if (AccessState?.CanView != false) { @ChildContent }
        </RadzenCard>
</RadzenStack>


@code {
  [CascadingParameter] public Guard.Components.Library.Authorization.DialogAccessState? AccessState { get; set; }
  [Parameter] public string Name { get; set; } = "ДОПОЛНИТЕЛЬНАЯ ИНФОРМАЦИЯ";
  [Parameter] public string Icon { get; set; } = "info";

  [Parameter] public RenderFragment? ChildContent { get; set; }

  protected void CancelButtonClick()
  {
    DialogService.Close(null);
  }
}
