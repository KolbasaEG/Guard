@using Guard.Components.Library.Loading
@typeparam TItem

<RadzenStack Style="width:100%;height:100%;" Gap="0px">
  <RadzenStack Style="width:100%;height:100%;" Gap="0px">
    <Guard.Components.Library.Cards.CardHeader
      Icon="@Icon" 
      Name="@Name" 
      ShowSaveButton="false" 
      ShowInfoButton="@(ShowInfoButton && AccessState?.CanView != false)"
      OnInfoClick="InfoButtonClick" 
      OnCancelButtonClick="CancelButtonClick" />

    @if (AccessState?.Message != null) { <RadzenAlert AlertStyle="AlertStyle.Warning">@AccessState.Message</RadzenAlert> }
    <RadzenStack Orientation="Orientation.Horizontal" Gap="5px;" Style="flex: 1; min-height: 0; width:100%; margin-top:5px;">
      <RadzenStack Gap="0px" Orientation="Orientation.Vertical" Style="height:100%; width:100%;min-height:0;">
        <LoadingContainer IsLoading="IsLoading">
          <RadzenCard Variant="Variant.Outlined" Style="padding:5px; border-radius:0px;height:100%;display:flex; flex-direction:column;">
            <RadzenStack Gap="0px" Orientation="Orientation.Vertical" Style="height:100%; width:100%;">
              @if (AccessState?.CanView != false) { @ChildContent }
            </RadzenStack>
          </RadzenCard>
        </LoadingContainer>
      </RadzenStack>
    </RadzenStack>
  </RadzenStack>
</RadzenStack>

@code {
  [CascadingParameter] public Guard.Components.Library.Authorization.DialogAccessState? AccessState { get; set; }
  [Parameter] public bool ShowInfoButton { get; set; } = false;
  [Parameter] public bool IsLoading { get; set; }

  [Parameter] public TItem? Data { get; set; }
  [Parameter] public string Name { get; set; } = "ПРОСМОТР";
  [Parameter] public string Icon { get; set; } = "auto_stories";

  [Parameter] public RenderFragment? ChildContent { get; set; }
  [Parameter] public EventCallback OnInfoClick { get; set; }
  [Parameter] public EventCallback OnCancelButtonClick { get; set; }

  private async Task InfoButtonClick()
  {
    if (OnInfoClick.HasDelegate)
    {
      await OnInfoClick.InvokeAsync();
    }
  }

  protected async Task CancelButtonClick()
  {
    if (OnCancelButtonClick.HasDelegate)
    {
      await OnCancelButtonClick.InvokeAsync();
    }
  }
}
