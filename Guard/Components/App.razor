@using Microsoft.Extensions.Options
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <base href="/" />
    
  <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
  <link rel="stylesheet" href="@Assets["app.css"]" />
  <link rel="stylesheet" href="@Assets["ui-standard.css"]" />
  <link rel="stylesheet" href="@Assets["Guard.styles.css"]" />
  <link rel="icon" type="image/png" href="favicon.png" />
    
  <!-- HeadOutlet и RadzenTheme используют conditional render mode -->
  <HeadOutlet @rendermode="@RenderModeForPage" />
  <RadzenTheme Theme="@(ThemeService.Theme ?? "software")" @rendermode="@InteractiveServer" />
</head>
<body>
  <Routes @rendermode="@RenderModeForPage" />
  <ReconnectModal />
    
  <!-- Blazor Web App: единый загрузчик для Static SSR и Interactive Server. -->
  <script src="@Assets["_framework/blazor.web.js"]"></script>
  <script src="_content/Radzen.Blazor/Radzen.Blazor.js?v=@(typeof(Radzen.Colors).Assembly.GetName().Version)"></script>
  <script type="module" src="@Assets["Components/Account/Shared/AccountThemeToggle.razor.js"]"></script>
</body>
</html>

@code {
  [CascadingParameter]
  private HttpContext? HttpContext { get; set; }

  /// <summary>
  /// Самое важное изменение:
  /// Страницы Identity (/account/login, /account/register и т.д.) должны рендериться как Static SSR (null),
  /// иначе SignInManager/SignOutAsync не смогут установить куки.
  /// Всё остальное — InteractiveServer.
  /// </summary>
  private IComponentRenderMode? RenderModeForPage =>
      HttpContext?.Request.Path.StartsWithSegments("/account", StringComparison.OrdinalIgnoreCase) == true
          ? null
          : InteractiveServer;

  [Inject]
  private ThemeService ThemeService { get; set; }
    
  protected override void OnInitialized()
  {
    base.OnInitialized();

    if (HttpContext != null)
    {
      var theme = HttpContext.Request.Cookies["ApplicationTheme"];

      if (!string.IsNullOrEmpty(theme))
      {
        ThemeService.SetTheme(theme, false);
      }
    }
  }

}
