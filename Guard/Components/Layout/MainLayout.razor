@inherits LayoutComponentBase
@inject CookieThemeService CookieThemeService
<div class="app-shell">
<CascadingValue Value="@UserContext">
  <RadzenComponents />
  <RadzenLayout class="app-layout" Style="grid-template-columns: auto minmax(0, 1fr); grid-template-areas: 'rz-sidebar rz-header' 'rz-sidebar rz-body';">
    <RadzenHeader>
      <AppHeader UserContext="@UserContext" Title="@CurrentTitle" ToggleSidebar="ToggleSidebar" />
    </RadzenHeader>
    <RadzenSidebar @bind-Expanded="sidebarExpanded" ResponsiveMaxWidth="768px" class="app-sidebar" Style="width:260px;">
      <AppSidebar />
    </RadzenSidebar>
    <RadzenBody Style="padding:0; min-width:0;">@Body</RadzenBody>
  </RadzenLayout>
</CascadingValue>
</div>
