@inherits LayoutComponentBase

<div class="auth-page" style="height:auto; min-height:100vh; width:100%; padding:1rem 0;">
  <div class="auth-container">

    <!-- Логотип и название системы -->
    <div class="auth-header text-center mb-2">
      <img src="images/logo.png" alt="АИС Охрана" class="auth-logo mb-2" style="width:64px; height:64px;" />
      <h1 class="auth-title" style="font-size:1.5rem;">АИС Охрана</h1>
      <p class="auth-subtitle">специализированная информационная система, предназначенная для комплексной автоматизации процессов планирования, организации, учёта и контроля деятельности Департамента охраны</p>
    </div>

    <!-- Карточка с формой входа (@Body = содержимое Login.razor) -->
    @Body

    <!-- Футер -->
    <div class="auth-footer text-center mt-2">
      <small>© 2025 Guard • Все права защищены</small>
    </div>

  </div>
</div>
