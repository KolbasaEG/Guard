@inherits LayoutComponentBase

<div class="auth-page">
  <div class="auth-container">

    <!-- Логотип и название системы -->
    <div class="auth-header text-center mb-4">
      <img src="images/logo.png" alt="АИС Охрана" class="auth-logo mb-3" />
      <h1 class="auth-title">АИС Охрана</h1>
      <p class="auth-subtitle">специализированная информационная система, предназначенная для комплексной автоматизации процессов планирования, организации, учёта и контроля деятельности Департамента охраны</p>
    </div>

    <!-- Карточка с формой входа (@Body = содержимое Login.razor) -->
    @Body

    <!-- Футер -->
    <div class="auth-footer text-center mt-4">
      <small>© 2025 Guard • Все права защищены</small>
    </div>

  </div>
</div>