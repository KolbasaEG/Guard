@inherits LayoutComponentBase
<Guard.Components.Layout.Components.MainTemplate Icon="admin_panel_settings" Name="Рабочее место администратора">
  <ChildContent>
    <div style="background-color: var(--rz-body-background-color); width:100%; height:100%; padding:2px;">
      @Body
    </div>
  </ChildContent>
  <MenueContent>
    <RadzenPanelMenu>
      <RadzenPanelMenuItem Text="Классификаторы" Icon="library_books" Path="/classifiers" Visible="@(Access?.Has(Permissions.Classifiers.Read) == true)" />
      <RadzenPanelMenuItem Text="Синхронизация" Icon="sync" Path="/synchronization" />
      <RadzenPanelMenuItem Text="Логгирование" Icon="admin_panel_settings" Path="/Logs" Visible="@(Access?.Has(Permissions.Logs.Read) == true)" />
      <RadzenPanelMenuItem Text="Роли" Icon="domino_mask" Path="/roles" Visible="@(Access?.Has(Permissions.Roles.Read) == true)" />
      <RadzenPanelMenuItem Text="Архив выгрузок" Icon="inventory_2" Path="/export-archive" Visible="@(Access?.Has(Permissions.Exports.ReadArchive) == true)" />
    </RadzenPanelMenu>
  </MenueContent>
</Guard.Components.Layout.Components.MainTemplate>
@code { [CascadingParameter] public Guard.Core.Services.DTOs.UserAccessSnapshot? Access { get; set; } }
