@implements IDisposable
@inject IDirectoryManagementService Management
@using Guard.Core.Services.DTOs
<CascadingValue Value="@state">@ChildContent</CascadingValue>
@code {
  [Parameter, EditorRequired] public string ReadPermission { get; set; } = "";
  [Parameter] public string? WritePermission { get; set; }
  [Parameter] public bool ApiControlled { get; set; }
  [Parameter] public RenderFragment? ChildContent { get; set; }
  [CascadingParameter] public UserAccessSnapshot? Access { get; set; }
  [CascadingParameter] public AccessStateProvider? Provider { get; set; }
  private bool disposed;
  private bool apiManaged;
  [Inject] protected NotificationService Notifications { get; set; } = default!;
  private string? lastNotifiedMessage;
  private NotificationSeverity messageSeverity;
  public void Dispose() => disposed = true;
  private DialogAccessState state = new(false, false, null, () => Task.CompletedTask);
  protected override async Task OnInitializedAsync()
  {
    state = new(false, false, null, RefreshAsync);
    apiManaged = await Management.IsApiManagedAsync();
    if (Provider != null) await Provider.RefreshAsync();
  }
  protected override void OnParametersSet() => UpdateState(Access);
  protected override void OnAfterRender(bool firstRender)
  {
    if (disposed || state.Message == lastNotifiedMessage) return;
    lastNotifiedMessage = state.Message;
    if (state.Message == null) return;
    Notifications.Notify(new NotificationMessage {
      Severity = messageSeverity,
      Summary = state.CanView ? "Режим просмотра" : "Доступ",
      Detail = state.Message,
      Style = "position: fixed; top: 3%; left: 50%; transform: translate(-50%, -50%); z-index: 1000;"
    });
  }
  private void UpdateState(UserAccessSnapshot? access)
  {
    var view = access?.Has(ReadPermission) == true;
    var directoryWrite = ApiControlled || WritePermission is Permissions.Personals.Write or Permissions.Subdivisions.Write or Permissions.Classifiers.Manage;
    var write = (WritePermission == null || access?.Has(WritePermission) == true) && !(directoryWrite && apiManaged);
    state.CanView = view;
    state.CanWrite = write;
    state.Message = !view ? "Просмотр недоступен: права доступа изменились."
      : !write ? apiManaged && directoryWrite ? "Данными управляет API. Доступен только просмотр." : "Право редактирования отозвано. Введённые данные сохранены, отправка недоступна." : null;
    messageSeverity = !view ? NotificationSeverity.Error
      : apiManaged && directoryWrite ? NotificationSeverity.Info : NotificationSeverity.Warning;
  }
  private async Task RefreshAsync()
  {
    apiManaged = await Management.IsApiManagedAsync();
    if (Provider != null) {
      await Provider.RefreshAsync();
      UpdateState(Provider.Current);
      if (!disposed) StateHasChanged();
    }
  }
}
