
@using Guard.Core.Services.DTOs
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@implements IAsyncDisposable
@inject IPermissionService Permissions
@inject IAccessChangeNotifier Notifier
@inject AccessRefreshCoordinator Coordinator
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject ILogger<AccessStateProvider> Logger
@inject IAccountPolicyService Policies
@inject IJSRuntime JS
<CascadingValue Value="@this" IsFixed="true">
  <CascadingValue Value="@snapshot"><StableAccessContent>@ChildContent</StableAccessContent></CascadingValue>
</CascadingValue>
@code {
  [Parameter] public RenderFragment? ChildContent { get; set; }
  public UserAccessSnapshot Current => snapshot;
  private UserAccessSnapshot snapshot = new("", false, []);
  private readonly CancellationTokenSource stop = new();
  private IDisposable? subscription;
  private string? subscribedUser;
  private Task? refreshTask;
  private IJSObjectReference? activityModule, activitySubscription;
  private DotNetObjectReference<AccessStateProvider>? activityReference;
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender) return;
    activityModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/account-activity.js");
    activityReference = DotNetObjectReference.Create(this);
    activitySubscription = await activityModule.InvokeAsync<IJSObjectReference>("subscribe", activityReference);
  }
  [JSInvokable]
  public async Task RecordActivityAsync()
  {
    if (disposed) return;
    var ct = stop.Token;
    try {
      var access = await Permissions.GetCurrentAsync(ct);
      await Policies.RecordActivityAsync(access.UserId, ct);
    }
    catch (UnauthorizedAccessException) { await RefreshAsync(); }
    catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    catch (Exception ex) { Logger.LogWarning(ex, "Не удалось записать активность пользователя"); }
  }
  private bool pending, disposed;
  protected override async Task OnInitializedAsync()
  {
    Coordinator.RefreshRequested += RefreshAsync;
    Navigation.LocationChanged += LocationChanged;
    Authentication.AuthenticationStateChanged += AuthenticationChanged;
    await RefreshAsync();
  }
  public Task RefreshAsync() => InvokeAsync(QueueRefreshAsync);
  private Task QueueRefreshAsync()
  {
    if (disposed) return Task.CompletedTask;
    pending = true;
    if (refreshTask == null || refreshTask.IsCompleted) refreshTask = DrainAsync();
    return refreshTask;
  }
  private async Task DrainAsync()
  {
    await Task.Yield();
    while (pending && !disposed)
    {
      pending = false;
      var previous = snapshot;
      try {
        // Подписка до запроса исключает окно между первым чтением БД и подпиской.
        var state = await Authentication.GetAuthenticationStateAsync();
        var id = state.User.Identity?.IsAuthenticated == true
          ? state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value : null;
        if (id != subscribedUser) {
          subscription?.Dispose();
          subscribedUser = id;
          subscription = string.IsNullOrWhiteSpace(id) ? null : Notifier.Subscribe(id, RefreshAsync);
        }
        snapshot = await Permissions.GetCurrentAsync(stop.Token);
      }
      catch (UnauthorizedAccessException) {
        snapshot = new("", false, []);
        if (!string.IsNullOrEmpty(subscribedUser)) {
          var account = await Policies.CheckAsync(subscribedUser, stop.Token);
          var passwordRequired = account.PasswordExpired && !account.Blocked;
          var path = new Uri(Navigation.Uri).AbsolutePath;
          var passwordPage = path.Equals("/Account/Manage/ChangePassword", StringComparison.OrdinalIgnoreCase) ||
            path.Equals("/Account/Manage/SetPassword", StringComparison.OrdinalIgnoreCase);
          if (!passwordRequired || !passwordPage)
            Navigation.NavigateTo(passwordRequired ? "/Account/Manage/ChangePassword" : "/Account/Login", forceLoad: true);
        }
      }
      catch (OperationCanceledException) when (stop.IsCancellationRequested) { return; }
      catch (Exception ex) { Logger.LogError(ex, "Не удалось обновить состояние доступа"); snapshot = new("", false, []); }
      if (previous.UserId == snapshot.UserId && previous.IsRoot == snapshot.IsRoot &&
          previous.Permissions.SetEquals(snapshot.Permissions)) snapshot = previous;
      else if (!disposed) StateHasChanged();
    }
  }
  private async void LocationChanged(object? sender, LocationChangedEventArgs args) => await RefreshSafelyAsync();
  private async void AuthenticationChanged(Task<AuthenticationState> state) => await RefreshSafelyAsync();
  private async Task RefreshSafelyAsync()
  {
    try { await RefreshAsync(); }
    catch (Exception ex) when (disposed || ex is OperationCanceledException) { }
    catch (Exception ex) { Logger.LogWarning(ex, "Обновление доступа сессии"); }
  }
  public async ValueTask DisposeAsync()
  {
    disposed = true;
    Coordinator.RefreshRequested -= RefreshAsync;
    Navigation.LocationChanged -= LocationChanged;
    Authentication.AuthenticationStateChanged -= AuthenticationChanged;
    subscription?.Dispose();
    try {
      if (activitySubscription != null) { await activitySubscription.InvokeVoidAsync("dispose"); await activitySubscription.DisposeAsync(); }
      if (activityModule != null) await activityModule.DisposeAsync();
    }
    catch (JSDisconnectedException) { }
    activityReference?.Dispose();
    stop.Cancel();
    if (refreshTask != null) await refreshTask;
    stop.Dispose();
  }
}
