
@using Guard.Core.Services.DTOs
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@implements IAsyncDisposable
@inject IPermissionService Permissions
@inject IAccessChangeNotifier Notifier
@inject AccessRefreshCoordinator Coordinator
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject ILogger<AccessStateProvider> Logger
<CascadingValue Value="@this" IsFixed="true">
  <CascadingValue Value="@snapshot"><StableAccessContent>@ChildContent</StableAccessContent></CascadingValue>
</CascadingValue>
@code {
  [Parameter] public RenderFragment? ChildContent { get; set; }
  public UserAccessSnapshot Current => snapshot;
  private UserAccessSnapshot snapshot = new("", false, []);
  private readonly CancellationTokenSource stop = new();
  private IDisposable? subscription;
  private string? subscribedUser;
  private Task? refreshTask;
  private bool pending, disposed;
  protected override async Task OnInitializedAsync()
  {
    Coordinator.RefreshRequested += RefreshAsync;
    Navigation.LocationChanged += LocationChanged;
    Authentication.AuthenticationStateChanged += AuthenticationChanged;
    await RefreshAsync();
  }
  public Task RefreshAsync() => InvokeAsync(QueueRefreshAsync);
  private Task QueueRefreshAsync()
  {
    if (disposed) return Task.CompletedTask;
    pending = true;
    if (refreshTask == null || refreshTask.IsCompleted) refreshTask = DrainAsync();
    return refreshTask;
  }
  private async Task DrainAsync()
  {
    await Task.Yield();
    while (pending && !disposed)
    {
      pending = false;
      var previous = snapshot;
      try {
        // Подписка до запроса исключает окно между первым чтением БД и подпиской.
        var state = await Authentication.GetAuthenticationStateAsync();
        var id = state.User.Identity?.IsAuthenticated == true
          ? state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value : null;
        if (id != subscribedUser) {
          subscription?.Dispose();
          subscribedUser = id;
          subscription = string.IsNullOrWhiteSpace(id) ? null : Notifier.Subscribe(id, RefreshAsync);
        }
        snapshot = await Permissions.GetCurrentAsync(stop.Token);
      }
      catch (UnauthorizedAccessException) { snapshot = new("", false, []); }
      catch (OperationCanceledException) when (stop.IsCancellationRequested) { return; }
      catch (Exception ex) { Logger.LogError(ex, "Не удалось обновить состояние доступа"); snapshot = new("", false, []); }
      if (previous.UserId == snapshot.UserId && previous.IsRoot == snapshot.IsRoot &&
          previous.Permissions.SetEquals(snapshot.Permissions)) snapshot = previous;
      else if (!disposed) StateHasChanged();
    }
  }
  private async void LocationChanged(object? sender, LocationChangedEventArgs args) => await RefreshSafelyAsync();
  private async void AuthenticationChanged(Task<AuthenticationState> state) => await RefreshSafelyAsync();
  private async Task RefreshSafelyAsync()
  {
    try { await RefreshAsync(); }
    catch (Exception ex) when (disposed || ex is OperationCanceledException) { }
    catch (Exception ex) { Logger.LogWarning(ex, "Обновление доступа сессии"); }
  }
  public async ValueTask DisposeAsync()
  {
    disposed = true;
    Coordinator.RefreshRequested -= RefreshAsync;
    Navigation.LocationChanged -= LocationChanged;
    Authentication.AuthenticationStateChanged -= AuthenticationChanged;
    subscription?.Dispose();
    stop.Cancel();
    if (refreshTask != null) await refreshTask;
    stop.Dispose();
  }
}
