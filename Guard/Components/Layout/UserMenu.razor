@using Guard.Core.Services.DTOs
@inject NavigationManager Navigation
<div class="app-user-actions">
  <AuthorizeView>
    <Authorized>
      <a class="rz-button rz-button-md rz-variant-text rz-base header-action" href="@AccountUrl("Manage/ChangePassword")" title="Сменить пароль" aria-label="Сменить пароль"><RadzenIcon Icon="passkey" /></a>
      <a class="rz-button rz-button-md rz-variant-text rz-base header-action" href="@AccountUrl("Logout")" title="Выйти" aria-label="Выйти"><RadzenIcon Icon="power_settings_new" /></a>
    </Authorized>
    <NotAuthorized>
      <a class="rz-button rz-button-md rz-variant-text rz-base header-action" href="/Account/Login" title="Войти" aria-label="Войти"><RadzenIcon Icon="login" /></a>
    </NotAuthorized>
  </AuthorizeView>
</div>
@code {
  [Parameter] public CurrentUserDisplayDto? UserContext { get; set; }
  private string AccountUrl(string path) => "/Account/" + path + "?ReturnUrl=" + Uri.EscapeDataString(
    Guard.Components.Account.AccountReturnUrl.Normalize("/" + Navigation.ToBaseRelativePath(Navigation.Uri)));
}
