<Guard.Components.Layout.Components.AccessDialog ReadPermission="@Guard.Core.Identity.Permissions.Classifiers.Read" WritePermission="@Guard.Core.Identity.Permissions.Classifiers.Manage">
@using Guard.Core.Services.DTOs
@attribute [Authorize]

<EditEntity Name="@(Access?.Has(Permissions.Classifiers.Manage) == true ? "Редактирование классификатора" : "Просмотр классификатора")" ReadOnly="@(Access?.Has(Permissions.Classifiers.Manage) != true)" TItem="ClassifierDetailsDto" Data="@item" ShowSaveButton="@(Access?.Has(Permissions.Classifiers.Manage) == true)" Submit="@FormSubmit" ShowInfoButton="false" IsLoading="isLoading" IsSaving="isSaving" OnCancelButtonClick="HandleCancelButtonClick">
  <RadzenStack Gap="5px" Orientation="Orientation.Vertical" Style="width:100%;min-width:0;">
    <RadzenFormField Text="Наименование справочника" Variant="Variant.Text" Style="width:100%;">
      <ChildContent>
        <RadzenTextBox style="display: block; width: 100%" @bind-Value="@item.ClassifierName" Name="ClassifierName" Placeholder="например, Тип документа" />
      </ChildContent>
      <Helper>
        <RadzenRequiredValidator Component="ClassifierName" Text="Обязательно для заполнения!" />
      </Helper>
    </RadzenFormField>

    <RadzenStack Gap="2px" Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Style="width:100%;min-width:0;">
      <RadzenFormField Text="Тип справочника" Variant="Variant.Text" Style="flex:1;min-width:min(100%,200px);">
        <ChildContent>
          <RadzenNumeric style="display: block; width: 100%" @bind-Value="@item.Type" Name="Type" Min="1" />
        </ChildContent>
        <Helper>
          <RadzenRequiredValidator Component="Type" Text="Обязательно для заполнения!" />
        </Helper>
      </RadzenFormField>

      <RadzenFormField Text="Код значения" Variant="Variant.Text" Style="flex:1;min-width:min(100%,200px);">
        <ChildContent>
          <RadzenNumeric style="display: block; width: 100%" @bind-Value="@item.Code" Name="Code" Min="1" />
        </ChildContent>
        <Helper>
          <RadzenRequiredValidator Component="Code" Text="Обязательно для заполнения!" />
        </Helper>
      </RadzenFormField>
    </RadzenStack>

    <RadzenFormField Text="Отображаемое значение" Variant="Variant.Text" Style="width:100%;">
      <ChildContent>
        <RadzenTextBox style="display: block; width: 100%" @bind-Value="@item.Value" Name="Value" Placeholder="например, Паспорт" />
      </ChildContent>
      <Helper>
        <RadzenRequiredValidator Component="Value" Text="Обязательно для заполнения!" />
      </Helper>
    </RadzenFormField>

    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2px">
      <RadzenSwitch @bind-Value="@item.IsActive" Name="IsActive" />
      <RadzenLabel Text="Активен" Component="IsActive" />
    </RadzenStack>
  </RadzenStack>
</EditEntity>
@code { [CascadingParameter] public Guard.Core.Services.DTOs.UserAccessSnapshot? Access { get; set; } }
</Guard.Components.Layout.Components.AccessDialog>
