<Guard.Components.Layout.Components.AccessDialog ReadPermission="@Guard.Core.Identity.Permissions.Roles.Manage" WritePermission="@Guard.Core.Identity.Permissions.Roles.Manage">
@using Guard.Core.Services.DTOs
@attribute [Authorize]

<CreateEntity Name="Создание роли" TItem="RoleEditDto" Data="@item" Submit="@FormSubmit" OnCancelButtonClick="HandleCancelButtonClick" IsLoading="isLoading">
  <RadzenStack Class="guard-compact-content" Gap="5px" Orientation="Orientation.Vertical" Style="width:100%;min-width:0;">
    <RadzenFormField Text="Наименование роли" Variant="Variant.Text" Style="width:100%;">
      <ChildContent>
        <RadzenTextBox style="display: block; width: 100%" @bind-Value="@item.Name" Name="RoleName" Placeholder="Введите наименование роли" />
      </ChildContent>
      <Helper>
        <RadzenRequiredValidator Component="RoleName" Text="Обязательно для заполнения!" />
      </Helper>
    </RadzenFormField>
    <PermissionSelector Definitions="@PermissionCatalog.All" @bind-Selected="item.Permissions" Disabled="@isLoading" />
  </RadzenStack>
</CreateEntity>
</Guard.Components.Layout.Components.AccessDialog>
