@page "/Error"
@using System.Diagnostics
@inject NavigationManager Navigation

<PageTitle>Не удалось открыть страницу — АИС Охрана</PageTitle>
<CardPageWrapper>
  <InfoBlock Compact="true" Title="Не удалось открыть страницу" Icon="error_outline" Style="min-width:0;flex-shrink:0;">
    <p>Повторите загрузку страницы. Если ошибка сохраняется, обратитесь к администратору.</p>
    @if (ShowRequestId) {
      <p>Идентификатор запроса: <code style="color:var(--rz-text-color);overflow-wrap:anywhere;">@RequestId</code></p>
    }
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0px" Wrap="FlexWrap.Wrap" Style="margin-top:5px;">
      <RadzenButton Text="Повторить загрузку" Icon="refresh" Click="@(() => Navigation.Refresh(forceReload: true))" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Style="border-radius:0px;color:var(--rz-text-color);" />
      <RadzenButton Text="На главную" Icon="home" Click="@(() => Navigation.NavigateTo("/"))" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Style="border-radius:0px;color:var(--rz-text-color);" />
    </RadzenStack>
  </InfoBlock>
</CardPageWrapper>

@code {
  [CascadingParameter] private HttpContext? HttpContext { get; set; }
  [PersistentState] public string? RequestId { get; set; }
  private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);
  protected override void OnInitialized() => RequestId ??= Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
