<Guard.Components.Layout.Components.AccessDialog ReadPermission="@Guard.Core.Identity.Permissions.Personals.ReadDetails" WritePermission="@Guard.Core.Identity.Permissions.Personals.Write">
@using Guard.Core.Services.DTOs
@attribute [Authorize]
<EditEntity TItem="PersonalEditorDto" Data="@item" Name="Редактирование сотрудника" Submit="@FormSubmit" ShowSaveButton="@loaded" ReadOnly="@(!loaded)" IsLoading="@isLoading" OnCancelButtonClick="HandleCancelButtonClick">
  <RadzenStack Gap="5px" Style="width:100%;min-width:0;">
  @if (error != null) { <RadzenAlert AlertStyle="AlertStyle.Danger">@error</RadzenAlert> }
  <Guard.Components.Pages.Personals.Components.PersonalFields Item="@item" Subdivisions="@subdivisions" />
  @if (Access?.Has(Guard.Core.Identity.Permissions.IpAddresses.Manage) == true)
  {
    <RadzenStack Gap="2px" Style="min-width:0;">
      <RadzenButton Text="Назначить IP-адреса" Icon="lan" ButtonType="ButtonType.Button"
                    Click="OpenIpAssignmentsAsync" Disabled="@isLoading" />
      <RadzenText Text="IP-адреса сохраняются отдельно от данных сотрудника." Style="margin:0;" />
    </RadzenStack>
  }
  </RadzenStack>
</EditEntity>
</Guard.Components.Layout.Components.AccessDialog>
