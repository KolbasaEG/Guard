
@using Guard.Core.Services.DTOs
@using Guard.Core.Enums
<TableWrapperWithFilterAndAnalytics>
<Table>

  @if (error != null) { <RadzenAlert AlertStyle="AlertStyle.Danger">@error</RadzenAlert> }
<RadzenDataGrid TItem="PersonalListItemDto" @ref="grid" Data="@filteredData" Count="@count" LoadData="LoadData" RowSelect="OpenRow"
  IsLoading="@isLoading" AllowPaging="true" AllowSorting="true" PageSize="20" PageSizeOptions="@(new int[] {10,20,30,50,100})" EmptyText="Записи не найдены" Style="height:100%" ColumnWidth="200px" AllowColumnResize="true" Density="Density.Compact"
  AndOperatorText="И" ApplyFilterText="Применить" ClearFilterText="Очистить" ContainsText="Содержит" FilterText="Фильтр"
  EndsWithText="Заканчивается на" EqualsText="Равно" DoesNotContainText="Не содержит"
  FirstPageTitle="Первая страница" FirstPageAriaLabel="К первой странице" IsEmptyText="Пусто" IsNotEmptyText="Не пусто"
  LastPageTitle="Последняя страница" LastPageAriaLabel="К последней странице" NextPageTitle="Следующая страница"
  NextPageAriaLabel="К следующей странице" PrevPageTitle="Предыдущая страница" PrevPageAriaLabel="К предыдущей странице"
  NotEqualsText="Не равно" OrOperatorText="Или" PageAriaLabelFormat="К странице {0}" PageSizeText="записей на странице"
  StartsWithText="Начинается с" LessThanText="Меньше" LessThanOrEqualsText="Меньше или равно"
  GreaterThanText="Больше" GreaterThanOrEqualsText="Больше или равно" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
  PagerHorizontalAlign="HorizontalAlign.Right" PagerPosition="PagerPosition.Top" ShowPagingSummary="true" PagingSummaryFormat="@PagingSummaryFormat">
  <HeaderTemplate>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="8px" AlignItems="AlignItems.Center" Style="width:100%;position:relative;min-height:36px;">
          @if (Access?.Has(Permissions.Personals.Export) == true) {
            <RadzenMenu>
              <RadzenMenuItem Text="Меню" Icon="menu" Style="border: var(--rz-selectbar-border); font-weight:600;">
                <Guard.Components.Exports.ExportActions Area="ExportArea.Personals" BuildRequest="BuildExportRequestAsync" Disabled="ActionsDisabled" />
              </RadzenMenuItem>
            </RadzenMenu>
          }

      <RadzenSelectBar Size="ButtonSize.Medium" Style="position:absolute;left:50%;transform:translateX(-50%);background-color:var(--rz-menu-top-item-background-color);border-radius:0px;" TValue="DataViewMode" @bind-Value="mode" Change="@(() => ResetPageAsync())">
        <Items>
          <RadzenSelectBarItem Value="@DataViewMode.Active" Text="Активные" Style="border-radius:0px;width:105px;text-align:center;" />
          @if (Access?.Has(Permissions.Personals.ReadArchive) == true) { <RadzenSelectBarItem Value="@DataViewMode.Archived" Text="Архив" Style="border-radius:0px;width:105px;text-align:center;" /> }
          @if (Access?.IsRoot == true) { <RadzenSelectBarItem Value="@DataViewMode.Deleted" Text="Удалённые" Style="border-radius:0px;width:105px;text-align:center;" /> }
        </Items>
      </RadzenSelectBar>
      <RadzenStack Orientation="Orientation.Horizontal" Gap="0" Style="margin-left:auto;background-color:var(--rz-menu-top-item-background-color);border:var(--rz-selectbar-border);">
      @if (Access?.IsRoot == true)
      {
        <RadzenToggleButton Text="Весь персонал" Value="ShowAll" Change="OnAllRecordsChanged" Icon="groups" Variant="Variant.Text" Size="ButtonSize.Medium" Style="border-radius:0px;" />
      }
      <RadzenToggleButton Value="@(hierarchy == SubdivisionHierarchyMode.IncludeChildren)" Change="OnHierarchyModeChanged"
        Disabled="ShowAll"
        ButtonStyle="ButtonStyle.Warning" ToggleButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" Style="border-radius:0px;"
        Size="ButtonSize.Medium" Icon="account_tree" ToggleIcon="domain" Shade="Shade.Light" ToggleShade="Shade.Dark"
        title="@(hierarchy == SubdivisionHierarchyMode.CurrentOnly ? "Только свои" : "Свои и подчинённые")"
        InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = "Переключение режима отображения иерархии" })" />
      <RadzenButton Icon="refresh" title="Обновить" Click="ReloadAsync" Size="ButtonSize.Medium" Variant="Variant.Text" Style="border-radius:0px;" Disabled="@ActionsDisabled" />
      <RadzenButton Icon="add_circle_outline" title="Добавить" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Medium" Variant="Variant.Text" Style="border-radius:0px;" Disabled="@ActionsDisabled" Visible="@(!apiManaged && Access?.Has(Permissions.Personals.Write) == true)" Click="AddAsync" />
      </RadzenStack>
    </RadzenStack>

  </HeaderTemplate>
  <Columns>
    <RadzenDataGridColumn TItem="PersonalListItemDto" Property="SubdivisionName" SortProperty="Subdivision.Name" Title="Подразделение" />
    <RadzenDataGridColumn TItem="PersonalListItemDto" Property="FullName" SortProperty="FullName" Title="Фамилия и инициалы" />
    <RadzenDataGridColumn TItem="PersonalListItemDto" Property="LastName" SortProperty="LastName" Title="Фамилия" />
    <RadzenDataGridColumn TItem="PersonalListItemDto" Property="FirstName" SortProperty="FirstName" Title="Имя" />
    <RadzenDataGridColumn TItem="PersonalListItemDto" Property="MiddleName" SortProperty="MiddleName" Title="Отчество" />
    <RadzenDataGridColumn TItem="PersonalListItemDto" Filterable="false" Sortable="false" Title="Действия" Width="180px" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TextAlign="TextAlign.Center">
      <Template Context="row">
        <RadzenStack Gap="2px" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Style="width:100%;">
        <RadzenButton Icon="visibility" Title="Полная карточка" Visible="@(Access?.Has(Permissions.Personals.ReadDetails) == true)" Click="@(() => DetailsAsync(row))" Size="ButtonSize.ExtraSmall" Shade="Shade.Lighter" Variant="Variant.Flat" Disabled="@ActionsDisabled" @onclick:stopPropagation="true" />
        <RadzenButton Icon="edit" Title="Редактировать" Visible="@(CanWrite(row) && Access?.Has(Permissions.Personals.ReadDetails) == true && row.Status is Status.Inserted or Status.Modified)" Click="@(() => EditAsync(row))" Size="ButtonSize.ExtraSmall" Shade="Shade.Lighter" Variant="Variant.Flat" Disabled="@ActionsDisabled" @onclick:stopPropagation="true" />
        <RadzenButton Icon="lan" Title="Разрешённые IP" Visible="@(!apiManaged && Access?.Has(Permissions.IpAddresses.Manage) == true && row.Status is Status.Inserted or Status.Modified)" Click="@(() => IpsAsync(row))" Size="ButtonSize.ExtraSmall" Shade="Shade.Lighter" Variant="Variant.Flat" Disabled="@ActionsDisabled" @onclick:stopPropagation="true" />
        <RadzenButton Icon="archive" Title="Архивировать" Visible="@(CanWrite(row) && EntityStatusTransitions.CanApply(row.Status, StatusOperation.Archive))" Click="@(() => ChangeStatusAsync(row, StatusOperation.Archive))" Size="ButtonSize.ExtraSmall" Shade="Shade.Lighter" Variant="Variant.Flat" Disabled="@ActionsDisabled" @onclick:stopPropagation="true" />
        <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="unarchive" Title="Восстановить" Visible="@(CanWrite(row) && EntityStatusTransitions.CanApply(row.Status, StatusOperation.Restore, Access?.IsRoot == true))" Click="@(() => ChangeStatusAsync(row, StatusOperation.Restore))" Size="ButtonSize.ExtraSmall" Shade="Shade.Lighter" Variant="Variant.Flat" Disabled="@ActionsDisabled" @onclick:stopPropagation="true" />
        <RadzenButton Icon="lock" Title="Заблокировать" Visible="@(CanWrite(row) && EntityStatusTransitions.CanApply(row.Status, StatusOperation.Block))" Click="@(() => ChangeStatusAsync(row, StatusOperation.Block))" Size="ButtonSize.ExtraSmall" Shade="Shade.Lighter" Variant="Variant.Flat" Disabled="@ActionsDisabled" @onclick:stopPropagation="true" />
        <RadzenButton Icon="lock_open" Title="Разблокировать" Visible="@(CanWrite(row) && EntityStatusTransitions.CanApply(row.Status, StatusOperation.Unblock))" Click="@(() => ChangeStatusAsync(row, StatusOperation.Unblock))" Size="ButtonSize.ExtraSmall" Shade="Shade.Lighter" Variant="Variant.Flat" Disabled="@ActionsDisabled" @onclick:stopPropagation="true" />
        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Title="Удалить" Visible="@(CanWrite(row) && EntityStatusTransitions.CanApply(row.Status, StatusOperation.Delete))" Click="@(() => ChangeStatusAsync(row, StatusOperation.Delete))" Size="ButtonSize.ExtraSmall" Shade="Shade.Lighter" Variant="Variant.Flat" Disabled="@ActionsDisabled" @onclick:stopPropagation="true" />
              </RadzenStack>
      </Template>
    </RadzenDataGridColumn>
  </Columns>
</RadzenDataGrid>
</Table>
<Filter>
  <RadzenDataFilter Style="width:100%;" ApplyFilterText="Применить" ClearFilterText="Очистить" FilterText="Фильтр" LessThanText="Меньше" LessThanOrEqualsText="Меньше или равно" GreaterThanText="Больше" GreaterThanOrEqualsText="Больше или равно" @ref="dataFilter" Auto="false" Data="@data" TItem="Guard.Core.Entities.Personal" AndOperatorText="И" OrOperatorText="Или" AddFilterText="Добавить фильтр" AddFilterGroupText="Добавить группу фильтров" EqualsText="Равно" NotEqualsText="Не равно" ContainsText="Содержит" DoesNotContainText="Не содержит" StartsWithText="Начинается с" EndsWithText="Заканчивается на" IsNullText="Не задано" IsNotNullText="Задано" IsEmptyText="Пусто" IsNotEmptyText="Не пусто" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
    <Properties>
      <RadzenDataFilterProperty TItem="Guard.Core.Entities.Personal" Property="LastName" Title="Фамилия" />
      <RadzenDataFilterProperty TItem="Guard.Core.Entities.Personal" Property="FirstName" Title="Имя" />
      <RadzenDataFilterProperty TItem="Guard.Core.Entities.Personal" Property="MiddleName" Title="Отчество" />
      <RadzenDataFilterProperty TItem="Guard.Core.Entities.Personal" Property="FullName" Title="Фамилия и инициалы" />
      <RadzenDataFilterProperty TItem="Guard.Core.Entities.Personal" Property="Subdivision.Name" Title="Подразделение" />
    </Properties>
  </RadzenDataFilter>
</Filter>
<FilterButtons><RadzenButton Icon="filter_alt" Text="Применить" Click="ApplyFilter" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Medium" Variant="Variant.Text" Style="border-radius:0px;" /></FilterButtons>
<Analitycs>
  <Guard.Components.Pages.Synchronization.ActualityPanel ReadPermission="@Permissions.Personals.Read" ApiModeChanged="@((bool value) => apiManaged = value)" ReloadData="ReloadForSynchronizationAsync" />
  <RadzenText>Найдено сотрудников: @count</RadzenText>
  <RadzenText>Режим отображения: @(hierarchy == SubdivisionHierarchyMode.CurrentOnly ? "Только свои" : "Свои и подчинённые")</RadzenText>
</Analitycs>
</TableWrapperWithFilterAndAnalytics>
