<Guard.Components.Layout.Components.AccessDialog ReadPermission="@Guard.Core.Identity.Permissions.IpAddresses.Read" WritePermission="@Guard.Core.Identity.Permissions.IpAddresses.Manage" ApiControlled="true">
@using Guard.Core.Services
@using Guard.Core.Services.DTOs

<EditEntity TItem="Guid" Data="@PersonalId" Name="Разрешённые IP" Submit="SaveAsync" ShowSaveButton="@loaded" IsLoading="@loading" OnCancelButtonClick="Close">
<RadzenStack Gap="12px">
  <RadzenText Text="Разрешённые IP-адреса сотрудника" TextStyle="TextStyle.H6" />
  <RadzenText Text="Пустой список запрещает вход. Изменения применяются при следующем входе или новом соединении. Root освобождён от проверки IP." />
  @if (error != null) { <RadzenAlert AlertStyle="AlertStyle.Danger">@error</RadzenAlert> }
  <RadzenText Text="Выбираются только активные IP подразделения сотрудника, без дочерних подразделений." />
  @if (hiddenAssignmentCount > 0) { <RadzenAlert AlertStyle="AlertStyle.Warning">Есть ранее назначенные IP вне подразделения сотрудника (@hiddenAssignmentCount). Они не показаны и сохраняются отдельно. Очистка видимого списка не удаляет эти назначения.</RadzenAlert> }
  <RadzenDropDown TValue="IEnumerable<Guid>" Data="@available" TextProperty="Address" ValueProperty="Id"
                  @bind-Value="selected" Multiple="true" AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                  Disabled="@loading" Style="width:100%" Placeholder="Выберите IP-адреса или подсети" />

</RadzenStack>
</EditEntity>

</Guard.Components.Layout.Components.AccessDialog>
