@using Guard.Core.Services.DTOs
  <RadzenStack Gap="5px" Orientation="Orientation.Vertical" Style="width:100%;min-width:0;">
    <RadzenStack Orientation="Orientation.Horizontal" Style="width:100%;" Gap="0px">
      <RadzenFormField Text="Подразделение" Variant="Variant.Text" Style="width:100%;">
        <ChildContent>
          <RadzenDropDown Data="@Subdivisions" TextProperty="Name" ValueProperty="Id" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true"
                          style="display: block; width: 100%" @bind-Value="@Item.SubdivisionId" Name="SubdivisionId" />
        </ChildContent>
      </RadzenFormField>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="2px" Wrap="FlexWrap.Wrap" Style="width: 100%;">
      <!-- Фамилия -->
      <RadzenFormField Text="Фамилия *" Variant="Variant.Text" Style="flex:1;min-width:min(180px, 100%);">
        <ChildContent>
          <RadzenTextBox Style="display: block; width: 100%" @bind-Value="@Item.LastName" Name="LastName" MaxLength="100" />
        </ChildContent>
        <Helper>
          <RadzenRequiredValidator Component="LastName" Text="Обязательно для заполнения!" />
        </Helper>
      </RadzenFormField>

      <!-- Имя -->
      <RadzenFormField Text="Имя *" Variant="Variant.Text" Style="flex:1;min-width:min(180px, 100%);">
        <ChildContent>
          <RadzenTextBox Style="display: block; width: 100%" @bind-Value="@Item.FirstName" Name="FirstName" MaxLength="100" />
        </ChildContent>
        <Helper>
          <RadzenRequiredValidator Component="FirstName" Text="Обязательно для заполнения!" />
        </Helper>
      </RadzenFormField>

      <!-- Отчество -->
      <RadzenFormField Text="Отчество" Variant="Variant.Text" Style="flex:1;min-width:min(180px, 100%);">
        <ChildContent>
          <RadzenTextBox Style="display: block; width: 100%" @bind-Value="@Item.MiddleName" Name="MiddleName" MaxLength="100" />
        </ChildContent>
      </RadzenFormField>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="2px" Wrap="FlexWrap.Wrap" Style="width: 100%;">
      <!-- Фамилия (род. падеж) -->
      <RadzenFormField Text="Фамилия (род. падеж)" Variant="Variant.Text" Style="flex:1;min-width:min(180px, 100%);">
        <ChildContent>
          <RadzenTextBox Style="display: block; width: 100%" @bind-Value="@Item.LastNameGen" Name="LastNameGen" MaxLength="100" />
        </ChildContent>
      </RadzenFormField>

      <!-- Имя (род. падеж) -->
      <RadzenFormField Text="Имя (род. падеж)" Variant="Variant.Text" Style="flex:1;min-width:min(180px, 100%);">
        <ChildContent>
          <RadzenTextBox Style="display: block; width: 100%" @bind-Value="@Item.FirstNameGen" Name="FirstNameGen" MaxLength="100" />
        </ChildContent>
      </RadzenFormField>

      <!-- Отчество (род. падеж) -->
      <RadzenFormField Text="Отчество (род. падеж)" Variant="Variant.Text" Style="flex:1;min-width:min(180px, 100%);">
        <ChildContent>
          <RadzenTextBox Style="display: block; width: 100%" @bind-Value="@Item.MiddleNameGen" Name="MiddleNameGen" MaxLength="100" />
        </ChildContent>
      </RadzenFormField>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="2px" Wrap="FlexWrap.Wrap" Style="width: 100%;">
      <!-- Фамилия и инициалы -->
      <RadzenFormField Text="Фамилия и инициалы (ФИО)" Variant="Variant.Text" Style="flex: 2; min-width:min(280px, 100%);">
        <ChildContent>
          <RadzenTextBox Style="display: block; width: 100%" @bind-Value="@Item.FullName" Name="FullName" MaxLength="250" />
        </ChildContent>
      </RadzenFormField>

      <!-- Личный номер -->
      <RadzenFormField Text="Личный номер" Variant="Variant.Text" Style="flex: 1; min-width:min(180px, 100%);">
        <ChildContent>
          <RadzenTextBox Style="display: block; width: 100%" @bind-Value="@Item.PersonalNumber" Name="PersonalNumber" MaxLength="50" />
        </ChildContent>
      </RadzenFormField>

      <!-- Год принятия на службу -->
      <RadzenFormField Text="Год принятия на службу" Variant="Variant.Text" Style="flex: 1; min-width:min(180px, 100%);">
        <ChildContent>
          <RadzenNumeric Style="display: block; width: 100%"
                         @bind-Value="@Item.EnlistmentYear"
                         Name="EnlistmentYear"
                         TValue="int?"
                         Min="1900"
                         Max="2100"
                         Format="0000"
                         ShowUpDown="false" />
        </ChildContent>
        <Helper>
          <RadzenNumericRangeValidator Component="EnlistmentYear" Min="1900" Max="2100" Text="Укажите год от 1900 до 2100." />
        </Helper>
      </RadzenFormField>
    </RadzenStack>
  </RadzenStack>

@code {
[Parameter, EditorRequired] public PersonalEditorDto Item { get; set; } = default!;
[Parameter] public IEnumerable<PersonalSubdivisionOptionDto> Subdivisions { get; set; } = [];
}
