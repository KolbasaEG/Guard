<Guard.Components.Layout.Components.AccessDialog ReadPermission="@Guard.Core.Identity.Permissions.Logs.Read">
@using Guard.Core.Services.DTOs
@using System.Text.Json
@using System.Text.RegularExpressions
@inject DialogService DialogService
@inject Guard.Components.Library.BrowserTimeService Time
@inject ILogger<LogDetailsDialog> Logger
<div class="log-details">
<ViewEntity TItem="LogEntryDto" Data="Log" Name="Событие технического журнала" OnCancelButtonClick="HandleCancelButtonClick">
  <RadzenStack Gap="5px" Orientation="Orientation.Vertical" Class="guard-compact-content" Style="width:100%;min-width:0;">
    <InfoBlock Compact="true" Title="Основные метаданные контекста" Icon="info" Style="min-width:0;">
      <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="5px">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2px">
          <RadzenBadge BadgeStyle="@GetBadgeStyle(Log.Level)" Text="@Log.Level" IsPill="true"  />
          <RadzenBadge BadgeStyle="@GetLayerBadgeStyle(Log.Layer)" Text="@(Log.Layer ?? "System")" IsPill="true" />
        </RadzenStack>

        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color); font-size: 0.85rem;">
          <RadzenIcon Icon="schedule" Style="vertical-align: middle; font-size: 1.1rem;" />
          @Time.Format(Log.Timestamp, "dd.MM.yyyy HH:mm:ss.fff")
        </RadzenText>
      </RadzenStack>
      <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="2px" Style="width:100%;min-width:0;">
        <RadzenFormField Text="Пользователь (UserId)" Variant="Variant.Text" Style="flex:1;min-width:min(100%,200px);">
          <RadzenTextBox Value="@(string.IsNullOrEmpty(Log.UserId) ? "Не указан" : Log.UserId)" ReadOnly="true" Style="width:100%;" />
        </RadzenFormField>
        <RadzenFormField Text="IP-адрес клиента" Variant="Variant.Text" Style="flex:1;min-width:min(100%,200px);">
          <RadzenTextBox Value="@(string.IsNullOrEmpty(Log.ClientIp) ? "N/A" : Log.ClientIp)" ReadOnly="true" Style="width:100%;" />
        </RadzenFormField>
      </RadzenStack>
    </InfoBlock>
    <InfoBlock Compact="true" Title="Детальная информация" Icon="description" Style="min-width:0;">
      <RadzenTabs RenderMode="TabRenderMode.Client">
        <Tabs>
          <RadzenTabsItem Text="Структурированные данные" Icon="data_object">
            <p>Идентификатор: @Log.Id</p>
            <p>Корреляция: @Log.CorrelationId; категория: @Log.SourceContext</p>
            <p>Диагностическая сессия: @Log.DiagnosticSessionId; запуск: @Log.RunId</p>
            <p>Отпечаток ошибки: @Log.Fingerprint</p>
            <p>Версия приложения: @Log.ApplicationVersion; экземпляр: @Log.InstanceId</p>
            <p>Шаблон: @Log.MessageTemplate</p>
            <pre class="log-code">@Log.Properties</pre>
          </RadzenTabsItem>
          <RadzenTabsItem Text="Сообщение" Icon="chat" >
              <RadzenStack Gap="2px" Style="min-width:0;">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin:0;">Исходное сообщение:</RadzenText>
                <div class="log-code">
                  @Log.Message
                </div>

                @if (parsedJsonMessage != null)
                {
                  <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin:0;">Распарсенный JSON из сообщения:</RadzenText>
                  <div class="log-code log-code-scroll">
                    <pre class="log-json">@parsedJsonMessage</pre>
                  </div>
                }
              </RadzenStack>
          </RadzenTabsItem>

          <!-- Анализ и парсинг Исключения (Exception) -->
          @if (!string.IsNullOrEmpty(Log.Exception))
          {
            <RadzenTabsItem Text="Исключение (Exception)" Icon="bug_report">
                  <RadzenStack Gap="2px">
                  <div class="log-exception-header">
                    @exceptionHeader
                  </div>
                  <div class="log-code log-code-scroll">
                    @foreach (var line in stackTraceLines)
                    {
                      <div style="display: block; margin-bottom: 2px; word-break: break-word; line-height: 1.4;">
                        @if (line.StartsWith("at "))
                        {
                          <span style="color: var(--rz-primary); font-weight: bold;">at&nbsp;</span>
                          <span style="color: var(--rz-text-color);">@line.Substring(3)</span>
                        }
                        else if (line.StartsWith("в "))
                        {
                          <span style="color: var(--rz-primary); font-weight: bold;">в&nbsp;</span>
                          <span style="color: var(--rz-text-color);">@line.Substring(2)</span>
                        }
                        else
                        {
                          <span style="color: var(--rz-text-color);">@line</span>
                        }
                      </div>
                    }
                  </div>
                </RadzenStack>
              </RadzenTabsItem>
          }
        </Tabs>
      </RadzenTabs>

    </InfoBlock>
  </RadzenStack>
</ViewEntity>
</div>


@code {
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender) return;
    try { await Time.InitializeAsync(); StateHasChanged(); }
    catch (Exception ex) { Guard.Core.Logging.OperationFailureLogging.LogOperationFailure(Logger, ex, "Часовой пояс события журнала"); }
  }
  [Parameter] public LogEntryDto Log { get; set; } = default!;

  private string? parsedJsonMessage;
  private string exceptionHeader = string.Empty;
  private List<string> stackTraceLines = new();

  protected override void OnInitialized()
  {
    ParseMessageJson();
    ParseExceptionData();
  }

  private void ParseMessageJson()
  {
    if (string.IsNullOrWhiteSpace(Log.Message)) return;

    // Попытка найти JSON блок внутри сообщения
    var jsonMatch = Regex.Match(Log.Message, @"\{.*\}|\[.*\]", RegexOptions.Singleline);
    if (jsonMatch.Success)
    {
      try
      {
        using var doc = JsonDocument.Parse(jsonMatch.Value);
        parsedJsonMessage = JsonSerializer.Serialize(doc, new JsonSerializerOptions { WriteIndented = true });
      }
      catch
      {
        // Если не валидный JSON - пропускаем
      }
    }
  }

  private void ParseExceptionData()
  {
    if (string.IsNullOrWhiteSpace(Log.Exception)) return;

    // Разбиваем строку по переносам \r\n, \n, \r и автоматически удаляем внешние пробелы
    var lines = Log.Exception
        .Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    if (lines.Length > 0)
    {
      // Первая строка — тип и заголовок исключения
      exceptionHeader = lines[0];

      // Остальные строки — фреймы стека вызовов
      stackTraceLines = lines.Skip(1).ToList();
    }
  }

  private BadgeStyle GetBadgeStyle(string? level) => level switch
  {
    "Error" or "Fatal" => BadgeStyle.Danger,
    "Warning" => BadgeStyle.Warning,
    "Information" => BadgeStyle.Info,
    "Debug" => BadgeStyle.Secondary,
    _ => BadgeStyle.Light
  };

  private BadgeStyle GetLayerBadgeStyle(string? layer) => layer switch
  {
    "Components" => BadgeStyle.Secondary,
    "Service" => BadgeStyle.Success,
    "Database" => BadgeStyle.Warning,
    _ => BadgeStyle.Light
  };
  protected void HandleCancelButtonClick()
  {
    DialogService.Close(null);
  }
}
</Guard.Components.Layout.Components.AccessDialog>
