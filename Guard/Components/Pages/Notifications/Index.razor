@using Guard.Core.Services
@implements IDisposable
@inject IUserNotificationService Service
@inject Guard.Web.Notifications.NotificationCenterState Center
@inject DialogService Dialogs
@inject NotificationService Notifications
@inject ILogger<Index> Logger

<div class="notification-list">
<PageWrapper EnableCellTooltips="true">
<Content>
<RadzenStack Gap="5px" Style="height:100%; min-height:0;">
  <CardHeader Name="УВЕДОМЛЕНИЯ" Icon="notifications" ShowSaveButton="false" ShowCancelButton="false" ShowInfoButton="false" />
  @if (error != null) { <CompactNotice Severity="AlertStyle.Danger">@error</CompactNotice> }
  <RadzenDataGrid @ref="grid" TItem="UserNotificationDto" Data="items" Count="count" LoadData="LoadData" IsLoading="loading"
                  RowSelect="OpenAsync" AllowPaging="true" AllowSorting="false" PageSize="20" PageSizeOptions="@(new int[] { 10, 20, 50, 100 })"
                  Density="Density.Compact" AllowColumnResize="true" EmptyText="Уведомлений нет" Style="height:100%;"
                  FirstPageTitle="Первая страница" FirstPageAriaLabel="К первой странице" LastPageTitle="Последняя страница" LastPageAriaLabel="К последней странице"
                  NextPageTitle="Следующая страница" NextPageAriaLabel="К следующей странице" PrevPageTitle="Предыдущая страница" PrevPageAriaLabel="К предыдущей странице" PageAriaLabelFormat="К странице {0}" PageSizeText="записей на странице"
                  ShowPagingSummary="true" PagingSummaryFormat="Страница {0} из {1} (всего {2} уведомлений)" PagerHorizontalAlign="HorizontalAlign.Right" PagerPosition="PagerPosition.Top">
    <HeaderTemplate>
      <RadzenStack Class="notification-toolbar" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0px" Style="position:relative; min-height:36px; width:100%;">
        <RadzenStack Class="notification-status" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0px" Style="position:absolute; left:50%; transform:translateX(-50%);">
        <RadzenSelectBar TValue="bool" Value="unread" Change="FilterAsync">
          <Items><RadzenSelectBarItem Value="false" Text="Все" /><RadzenSelectBarItem Value="true" Text="Непрочитанные" /></Items>
        </RadzenSelectBar>
        </RadzenStack>
        <RadzenStack Class="notification-actions" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0px" Style="margin-left:auto;background-color:var(--rz-menu-top-item-background-color);border:var(--rz-selectbar-border);">
          <RadzenButton Text="Прочитать все" Icon="done_all" Click="ReadAllAsync" Disabled="@(reading || Center.Summary == null)" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Style="border-radius:0px;color:var(--rz-text-color);" />
          <RadzenButton Icon="refresh" title="Обновить" aria-label="Обновить уведомления" Click="ReloadAsync" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Style="border-radius:0px;color:var(--rz-text-color);" />
        </RadzenStack>
      </RadzenStack>
    </HeaderTemplate>
    <Columns>
      <RadzenDataGridColumn TItem="UserNotificationDto" Property="IsRead" Title="Прочтение" Width="140px">
        <Template Context="item"><span class="guard-cell-text" tabindex="0">@(item.IsRead ? "Прочитано" : "Новое")</span></Template>
      </RadzenDataGridColumn>
      <RadzenDataGridColumn TItem="UserNotificationDto" Property="Title" Title="Уведомление">
        <Template Context="item"><span class="guard-cell-text" tabindex="0" style="font-weight:@(item.IsRead ? "normal" : "600")">@item.Title</span></Template>
      </RadzenDataGridColumn>
      <RadzenDataGridColumn TItem="UserNotificationDto" Property="IncidentActive" Title="Состояние" Width="180px">
        <Template Context="item"><span class="guard-cell-text" tabindex="0">@(item.IsIncident ? item.IncidentActive ? "Требует внимания" : "Восстановлено" : "Результат операции")</span></Template>
      </RadzenDataGridColumn>
      <RadzenDataGridColumn TItem="UserNotificationDto" Property="UpdatedAtUtc" Title="Обновлено" Width="190px">
        <Template Context="item"><span class="guard-cell-text" tabindex="0">@item.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</span></Template>
      </RadzenDataGridColumn>
      <RadzenDataGridColumn TItem="UserNotificationDto" Width="60px" TextAlign="TextAlign.Center">
        <Template Context="item"><RadzenButton Icon="visibility" Size="ButtonSize.ExtraSmall" Variant="Variant.Flat" Shade="Shade.Lighter" title="Открыть уведомление" aria-label="Открыть уведомление" Click="@(() => OpenAsync(item))" @onclick:stopPropagation="true" /></Template>
      </RadzenDataGridColumn>
    </Columns>
  </RadzenDataGrid>
</RadzenStack>
</Content>
</PageWrapper>
</div>
