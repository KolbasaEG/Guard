@page "/not-found"
@layout MainLayout
@inject NavigationManager Navigation

<PageTitle>Страница не найдена — АИС Охрана</PageTitle>
<CardPageWrapper>
  <InfoBlock Compact="true" Title="Страница не найдена" Icon="search_off" Style="min-width:0;flex-shrink:0;">
    <p>По этому адресу нет страницы. Проверьте адрес или перейдите на главную.</p>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0px" Style="margin-top:5px;">
      <RadzenButton Text="На главную" Icon="home" Click="@(() => Navigation.NavigateTo("/"))" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Style="border-radius:0px;color:var(--rz-text-color);" />
    </RadzenStack>
  </InfoBlock>
</CardPageWrapper>
