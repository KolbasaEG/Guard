@page "/audit/settings"
@attribute [Authorize]
@layout Guard.Components.Layout.AuditRecoveryLayout
@using Guard.Core.Enums
<PageTitle>Состояние и настройки аудита</PageTitle>
<div class="audit-settings-page">
<CardPageWrapper>
  @if (!allowed && !loading) {
    <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">Состояние недоступно: не удалось подтвердить полномочия Root.</RadzenAlert>
  }
  else if (loading && state == null) {
    <RadzenText Text="Загрузка состояния аудита…" />
  }
  else {
    @if (message != null) { <RadzenAlert AlertStyle="@(success ? AlertStyle.Success : AlertStyle.Warning)" AllowClose="false">@message</RadzenAlert> }
    <div class="audit-settings-grid">
      @if (state != null) {
        <section class="audit-state" aria-label="Состояние аудита">
          <ViewEntity TItem="AuditSystemState" Data="state" Name="СОСТОЯНИЕ АУДИТА" Icon="health_and_safety" ShowCancelButton="false">
            <div class="audit-state-content">
              <RadzenAlert AlertStyle="@(state.Available ? AlertStyle.Success : AlertStyle.Danger)" AllowClose="false">@state.Message</RadzenAlert>
              <InfoBlock Compact="true" Title="Доступность" Icon="verified_user" Style="min-width:0;">
                <dl class="audit-facts">
                  <dt>Действующий режим</dt><dd>@(state.Code == "StorageUnavailable" || state.Mode is not (AuditMode.Local or AuditMode.Siem) ? "Неизвестен" : state.Mode == AuditMode.Local ? "Локальный" : "RuSIEM")</dd>
                  <dt>Код состояния</dt><dd><span class="audit-code">@state.Code</span></dd>
                  <dt>Последняя проверка, UTC</dt><dd>@Format(state.CheckedAtUtc)</dd>
                  <dt>Возраст показателей</dt><dd>@Math.Max(0, (int)(DateTime.UtcNow - state.CheckedAtUtc).TotalSeconds) сек.</dd>
                  <dt>Локальная запись исправна, UTC</dt><dd>@Format(state.LastStorageSuccessUtc)</dd>
                  <dt>Последний сбой, UTC</dt><dd>@Format(state.LastFailureUtc)</dd>
                  <dt>Причина сбоя</dt><dd>@(state.LastFailure ?? "Нет")</dd>
                  <dt>Сбоев с запуска</dt><dd>@state.StorageFailures</dd>
                </dl>
              </InfoBlock>
              <InfoBlock Compact="true" Title="Очередь и доставка" Icon="sync_alt" Style="min-width:0;">
                @if (state.Code == "StorageUnavailable") { <RadzenText>Данные очереди неизвестны. Нулевое значение не подтверждено.</RadzenText> }
                <dl class="audit-facts">
                  @if (state.Code != "StorageUnavailable") {
                    <dt>Ожидают отправки</dt><dd>@state.Pending событий</dd>
                    <dt>Объём очереди</dt><dd>@FormatBytes(state.PendingBytes)</dd>
                    <dt>Старейшее событие, UTC</dt><dd>@Format(state.OldestQueuedAtUtc)</dd>
                    <dt>Возраст старейшего</dt><dd>@(state.OldestQueuedAtUtc is {} oldest ? Math.Max(0, (long)(DateTime.UtcNow - oldest).TotalSeconds) + " сек." : "Нет")</dd>
                  }
                  <dt>Отправка по TLS, UTC</dt><dd>@Format(state.LastSentUtc)</dd>
                  <dt>Цикл отправителя, UTC</dt><dd>@Format(state.WorkerCompletedAtUtc)</dd>
                  <dt>Сертификат действует до, UTC</dt><dd>@Format(state.CertificateExpiresAtUtc)</dd>
                  @if (state.Mode == AuditMode.Siem && state.Code != "StorageUnavailable") {
                    <dt>Предельный возраст</dt><dd>@state.MaxQueueAgeMinutes мин.</dd>
                    <dt>Предельный объём</dt><dd>@FormatBytes(state.MaxQueueBytes)</dd>
                    <dt>Предельное количество</dt><dd>@(state.MaxQueueCount > 0 ? state.MaxQueueCount.ToString() : "Без дополнительного ограничения")</dd>
                    @if (state.MaxQueueBytes > 0) { <dt>Использовано объёма</dt><dd>@((state.PendingBytes * 100.0 / state.MaxQueueBytes).ToString("F1")) %</dd> }
                    <dt>Версия конфигурации</dt><dd class="audit-code">@state.ConfigurationVersion</dd>
                  }
                </dl>
                <RadzenText TextStyle="TextStyle.Caption" class="audit-note">В локальном режиме прежняя очередь сохранена, отправка приостановлена. Отправка по TLS не подтверждает сохранение в RuSIEM.</RadzenText>
              </InfoBlock>
              <InfoBlock Compact="true" Title="Хранение и очистка" Icon="inventory_2" Style="min-width:0;">
                <dl class="audit-facts">
                  <dt>Последняя очистка, UTC</dt><dd>@Format(state.LastCleanupUtc)</dd>
                  <dt>Ошибка очистки</dt><dd>@(state.CleanupError ?? "Нет")</dd>
                </dl>
              </InfoBlock>
            </div>
          </ViewEntity>
        </section>
      }
      @if (allowed && model != null) {
        <section class="audit-configuration" aria-label="Настройки аудита">
          <EditEntity TItem="AuditConfiguration" Data="model" Name="НАСТРОЙКИ АУДИТА" IsLoading="loading" IsSaving="saving" ShowCancelButton="false" Submit="SaveAsync">
            <div class="audit-form-content">
              <InfoBlock Compact="true" Title="Режим и хранение" Icon="settings" Style="min-width:0;">
                <div class="audit-fields">
                  <div class="audit-field audit-field-wide">
                    <RadzenLabel Text="Режим аудита" Component="AuditMode" />
                    <RadzenSelectBar Name="AuditMode" TValue="AuditMode" @bind-Value="model.Mode"><Items>
                      <RadzenSelectBarItem Text="Локальный" Value="AuditMode.Local" />
                      <RadzenSelectBarItem Text="С RuSIEM" Value="AuditMode.Siem" />
                    </Items></RadzenSelectBar>
                  </div>
                  <RadzenFormField Class="audit-field audit-field-wide" Text="Срок хранения, календарных лет (1–30)" Variant="Variant.Text"><RadzenNumeric AriaLabel="Срок хранения, календарных лет (1–30)" Name="RetentionYears" TValue="int" @bind-Value="model.RetentionYears" Min="1" Max="30" /></RadzenFormField>
                </div>
                <RadzenText TextStyle="TextStyle.Caption" class="audit-note">Срок действует для журнала и технических логов. Неотправленные обязательные события сохраняются до доставки. Уменьшение срока разрешает очистку более старых локальных и доставленных записей.</RadzenText>
              </InfoBlock>
              @if (model.Mode == AuditMode.Siem) {
                <InfoBlock Compact="true" Title="Соединение RuSIEM" Icon="lan" Style="min-width:0;">
                  <div class="audit-fields">
                    <RadzenFormField Class="audit-field audit-field-wide" Text="Сервер — имя или IP" Variant="Variant.Text"><RadzenTextBox Name="SiemHost" @bind-Value="model.Host" MaxLength="253" /></RadzenFormField>
                    <RadzenFormField Class="audit-field" Text="Порт TLS" Variant="Variant.Text"><RadzenNumeric AriaLabel="Порт TLS" Name="SiemPort" TValue="int" @bind-Value="model.Port" Min="1" Max="65535" /></RadzenFormField>
                    <RadzenFormField Class="audit-field audit-field-wide" Text="Публичный PEM-сертификат CA" Variant="Variant.Text"><RadzenTextArea Name="SiemCa" @bind-Value="model.CaCertificatePem" Rows="4" MaxLength="16384" /></RadzenFormField>
                  </div>
                  <RadzenText TextStyle="TextStyle.Caption" class="audit-note">Пустой сертификат — системное доверие. Приватный ключ не требуется.</RadzenText>
                  <RadzenButton Size="ButtonSize.Small" Text="Проверить соединение и отправить тест" Icon="network_check" Click="TestAsync" Disabled="saving" ButtonStyle="ButtonStyle.Light" />
                </InfoBlock>
                <InfoBlock Compact="true" Title="Обязательная очередь" Icon="hourglass_top" Style="min-width:0;">
                  <div class="audit-fields">
                    <RadzenFormField Class="audit-field" Text="Максимальный возраст, минут" Variant="Variant.Text"><RadzenNumeric AriaLabel="Максимальный возраст, минут" Name="QueueAge" TValue="int" @bind-Value="model.MaxQueueAgeMinutes" Min="1" Max="525600" /></RadzenFormField>
                    <RadzenFormField Class="audit-field" Text="Максимальный объём, байт" Variant="Variant.Text"><RadzenNumeric AriaLabel="Максимальный объём, байт" Name="QueueBytes" TValue="long" @bind-Value="model.MaxQueueBytes" Min="1024" /></RadzenFormField>
                    <RadzenFormField Class="audit-field audit-field-wide" Text="Максимальное число событий" Variant="Variant.Text"><RadzenNumeric AriaLabel="Максимальное число событий" Name="QueueCount" TValue="int" @bind-Value="model.MaxQueueCount" Min="0" /></RadzenFormField>
                  </div>
                  <RadzenText TextStyle="TextStyle.Caption" class="audit-note">Возраст и объём обязательны; минимальный объём — 1024 байта. Количество 0 отключает только дополнительный предел числа событий.</RadzenText>
                  <div class="audit-confirmation"><RadzenCheckBox Name="TransferPending" AriaLabel="Подтверждаю перенос обязательной очереди" @bind-Value="transferPending" /><RadzenLabel Component="TransferPending" Text="Подтверждаю перенос обязательной очереди на новое назначение при смене сервера или доверия" /></div>
                </InfoBlock>
              }
              <RadzenText TextStyle="TextStyle.Caption" class="audit-note">Снижение пределов может сразу заблокировать работу. Локальный режим приостанавливает отправку SIEM; локальные события задним числом не отправляются.</RadzenText>
              <div class="audit-form-actions">
                <RadzenButton Size="ButtonSize.Small" Text="Сохранить настройки" Icon="save" ButtonType="ButtonType.Submit" Disabled="@(saving || loading)" />
                <RadzenButton Size="ButtonSize.Small" Text="Обновить" Icon="refresh" Click="ReloadAsync" Disabled="@(saving || loading)" ButtonStyle="ButtonStyle.Light" />
              </div>
              <dl class="audit-facts audit-version">
                <dt>Версия</dt><dd class="audit-code">@model.Version</dd>
                <dt>Изменил</dt><dd>@(model.ModifiedBy ?? "Ещё не настроено")</dd>
                <dt>Изменено, UTC</dt><dd>@Format(model.ModifiedAtUtc)</dd>
              </dl>
            </div>
          </EditEntity>
        </section>
      }
    </div>
  }
</CardPageWrapper>
</div>
