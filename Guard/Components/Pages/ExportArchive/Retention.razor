<EditEntity TItem="RetentionForm" Data="form" Name="СРОК ХРАНЕНИЯ ВЫГРУЗОК" IsLoading="loading" IsSaving="saving" ShowSaveButton="loaded" Submit="SaveAsync" OnCancelButtonClick="@(() => Dialogs.Close(null))">
  <RadzenStack Class="guard-compact-content" Gap="5px" Style="min-width:0;">
    @if (error != null) { <CompactNotice Severity="AlertStyle.Danger">@error</CompactNotice> }
    @if (!loaded && !loading) { <RadzenButton Text="Повторить загрузку" Icon="refresh" Click="LoadAsync" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Style="border-radius:0px;color:var(--rz-text-color);" /> }
    <InfoBlock Compact="true" Title="Правила хранения" Icon="schedule" Style="min-width:0;flex-shrink:0;">
      <RadzenFormField Text="Срок хранения, лет" Variant="Variant.Text" Style="width:100%;"><RadzenNumeric TValue="int" @bind-Value="form.Years" Min="1" Max="30" Disabled="@(!loaded)" Style="width:100%;" /></RadzenFormField>
      <p>От 1 до 30 лет. По умолчанию — 3 года.</p>
      <p>Изменение применяется только к новым выгрузкам.</p>
    </InfoBlock>
  </RadzenStack>
</EditEntity>
