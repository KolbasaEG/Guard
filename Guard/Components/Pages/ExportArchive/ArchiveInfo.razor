<EntityInfo Name="СВЕДЕНИЯ О ВЫГРУЗКЕ">
  <LoadingContainer IsLoading="loading">
    <RadzenStack Class="guard-compact-content" Gap="5px" Style="min-width:0;overflow-y:auto;">
      @if (error != null) { <CompactNotice Severity="AlertStyle.Danger">@error</CompactNotice> }
      @if (details != null) {
        <InfoBlock Compact="true" Title="Выгрузка" Icon="description" Style="min-width:0;flex-shrink:0;">
          <p>Номер: @Id</p>
          <p>@details.Conditions</p>
        </InfoBlock>
        <InfoBlock Compact="true" Title="Архивная копия" Icon="inventory_2" Style="min-width:0;flex-shrink:0;">
          <p>Размер: @(details.Size?.ToString() ?? "не задано") байт</p>
          <p>SHA-256: @(details.Sha256 ?? "не задано")</p>
        </InfoBlock>
        <InfoBlock Compact="true" Title="Передача файла" Icon="file_download" Style="min-width:0;flex-shrink:0;">
          <p>Начало передачи (UTC): @FormatTime(details.DeliveryStartedAtUtc)</p>
          <p>Завершение передачи (UTC): @FormatTime(details.DeliveryCompletedAtUtc)</p>
          <p>Результат: @(details.DeliverySucceeded == true ? "Файл передан сервером" : details.DeliverySucceeded == false ? "Передача не завершена" : details.DeliveryStartedAtUtc != null ? "Результат передачи неизвестен" : "Передача не начиналась")</p>
        </InfoBlock>
      }
    </RadzenStack>
  </LoadingContainer>
</EntityInfo>
