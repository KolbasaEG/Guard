<div class="archive-preview" @ref="element">
<ViewEntity TItem="ExportPreview" Data="preview" Name="ПРОСМОТР АРХИВНОЙ КОПИИ" IsLoading="loading" ShowInfoButton="true" OnInfoClick="InfoAsync" OnCancelButtonClick="@(() => Dialogs.Close(null))">
  <div class="preview-layout">
    @if (error != null) { <CompactNotice Severity="AlertStyle.Danger">@error</CompactNotice> }
    <RadzenStack Class="preview-controls" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0px" Wrap="FlexWrap.Wrap">
      <RadzenFormField Text="Часть" Variant="Variant.Text" Style="width:100px;margin-right:5px;"><RadzenNumeric TValue="int" @bind-Value="part" Min="1" Disabled="loading" Style="width:100%;" /></RadzenFormField>
      <RadzenButton Text="Открыть" Icon="folder_open" Click="@(() => LoadAsync(0))" Disabled="loading" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Style="border-radius:0px;color:var(--rz-text-color);" />
      <RadzenButton Text="Предыдущие строки" Icon="chevron_left" Click="@(() => LoadAsync(Math.Max(0, skip - 100)))" Disabled="@(loading || skip == 0)" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Style="border-radius:0px;color:var(--rz-text-color);" />
      <RadzenButton Text="Следующие строки" Icon="chevron_right" Click="@(() => LoadAsync(skip + 100))" Disabled="@(loading || preview?.HasMore != true)" Variant="Variant.Text" ButtonStyle="ButtonStyle.Light" Style="border-radius:0px;color:var(--rz-text-color);" />
    </RadzenStack>
    @if (preview != null) {
      <RadzenDataGrid TItem="IReadOnlyList<string>" Data="preview.Rows" AllowPaging="false" AllowSorting="false" AllowColumnResize="true" Density="Density.Compact" ColumnWidth="200px" EmptyText="Записи не найдены" Style="flex:1;min-height:0;min-width:0;">
        <Columns>
          @for (var i = 0; i < preview.Headers.Count; i++) {
            var columnIndex = i;
            <RadzenDataGridColumn TItem="IReadOnlyList<string>" Title="@preview.Headers[i]">
              <Template Context="row"><span class="guard-cell-text" tabindex="0">@(columnIndex < row.Count ? row[columnIndex] : "")</span></Template>
            </RadzenDataGridColumn>
          }
        </Columns>
      </RadzenDataGrid>
    }
  </div>
</ViewEntity>
</div>
