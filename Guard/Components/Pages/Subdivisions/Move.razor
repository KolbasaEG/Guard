<Guard.Components.Layout.Components.AccessDialog ReadPermission="@Guard.Core.Identity.Permissions.Subdivisions.Read" WritePermission="@Guard.Core.Identity.Permissions.Subdivisions.Write">
@using Guard.Core.Services.DTOs
@using Guard.Core.Enums
@attribute [Authorize]

<EditEntity TItem="SubdivisionDetailsDto" Data="@item" Name="Перемещение подразделения" Icon="drive_file_move" ShowSaveButton="true" Submit="@FormSubmit" ShowInfoButton="true" OnInfoClick="InfoButtonClick" IsLoading="isLoading" IsSaving="isSaving" OnCancelButtonClick="HandleCancelButtonClick">
  <RadzenStack Gap="5px" Orientation="Orientation.Vertical" Style="width:100%;min-width:0;">

    <!-- Выбор нового родительского подразделения -->
    <RadzenFormField Text="Новое родительское подразделение" Variant="Variant.Text" Style="width:100%">
      <ChildContent>
        <RadzenDropDownDataGrid Style="display: block; width: 100%"
                                Data="@availableParents"
                                @bind-Value="@selectedParentId"
                                TextProperty="Name"
                                ValueProperty="Id"
                                Name="ParentId"
                                AllowClear="true"
                                Placeholder="-- Корневой узел (Без родителя) --">
          <Columns>
            <RadzenDropDownDataGridColumn Property="Name" Title="Наименование" />
            <RadzenDropDownDataGridColumn Property="Path" Title="Путь" />
          </Columns>
        </RadzenDropDownDataGrid>
      </ChildContent>
      <Helper>
        <RadzenText TextStyle="TextStyle.Caption" class="rz-color-secondary" Style="margin:0;overflow-wrap:anywhere;">
          Очистите поле для перевода подразделения на верхний уровень (в корневой узел).
        </RadzenText>
      </Helper>
    </RadzenFormField>

  </RadzenStack>
</EditEntity>
</Guard.Components.Layout.Components.AccessDialog>
