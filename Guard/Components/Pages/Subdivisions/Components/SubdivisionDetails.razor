@using Guard.Core.Entities

<div class="subdivision-details">
  <RadzenTable Style="width:100%;table-layout:fixed;" aria-label="Сведения о подразделении">
    <RadzenTableBody>
      @foreach (var row in Rows)
      {
        <RadzenTableRow>
          <RadzenTableCell Style="padding:2px;width:40%;background:var(--rz-grid-header-background-color);">
            <RadzenStack Gap="5px" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start">
              <RadzenIcon Icon="@row.Icon" Style="font-size:16px;flex-shrink:0;" aria-hidden="true" />
              <span>@row.Label</span>
            </RadzenStack>
          </RadzenTableCell>
          <RadzenTableCell Style="padding:2px;">@(string.IsNullOrWhiteSpace(row.Value) ? "—" : row.Value)</RadzenTableCell>
        </RadzenTableRow>
      }
    </RadzenTableBody>
  </RadzenTable>
</div>

@code {
  [Parameter, EditorRequired] public Subdivision Item { get; set; } = default!;

  private IEnumerable<(string Icon, string Label, string? Value)> Rows => [
    ("business", "Наименование", Item.Name),
    ("work_outline", "Наименование для должности", Item.PositionFormationName),
    ("account_tree", "Вышестоящее подразделение", Item.Parent?.Name),
    ("account_balance", "Тип органа", Item.OrganType?.Value),
    ("check_circle_outline", "Статус подразделения", Item.StatusClassifier?.Value),
    ("format_list_numbered", "Порядок на уровне", Item.LevelOrder.ToString()),
    ("folder_open", "Является отделом", Item.IsDepartment ? "Да" : "Нет"),
    ("markunread_mailbox", "Почтовый индекс", Item.PostalCode),
    ("location_on", "Адрес", Item.Address),
    ("phone", "Телефон", Item.Phone),
    ("print", "Факс", Item.Fax)
  ];
}
