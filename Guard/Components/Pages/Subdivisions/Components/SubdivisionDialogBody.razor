@using Guard.Core.Services.DTOs

@if (CanEdit)
{
  <EditEntity TItem="SubdivisionDetailsDto" Data="Item" Name="РЕДАКТИРОВАНИЕ ПОДРАЗДЕЛЕНИЯ"
              Submit="Submit" ShowInfoButton="true" OnInfoClick="OnInfoClick"
              IsLoading="IsLoading" IsSaving="IsSaving" OnCancelButtonClick="OnCancel">
    <SubdivisionFields Item="Item" OrganTypes="OrganTypes" StatusClassifiers="StatusClassifiers" />
  </EditEntity>
}
else
{
  <ViewEntity TItem="SubdivisionDetailsDto" Data="Item" Name="ПРОСМОТР ПОДРАЗДЕЛЕНИЯ"
              ShowInfoButton="@(!IsLoading && !IsSaving)" OnInfoClick="OnInfoClick"
              IsLoading="IsLoading" OnCancelButtonClick="OnCancel">
    @if (!IsLoading)
    {
      <SubdivisionDetails Item="Item" />
    }
  </ViewEntity>
}

@code {
  [CascadingParameter] public DialogAccessState? AccessState { get; set; }
  [Parameter, EditorRequired] public SubdivisionDetailsDto Item { get; set; } = default!;
  [Parameter] public IEnumerable<SubdivisionClassifierOptionDto> OrganTypes { get; set; } = [];
  [Parameter] public IEnumerable<SubdivisionClassifierOptionDto> StatusClassifiers { get; set; } = [];
  [Parameter] public bool IsLoading { get; set; }
  [Parameter] public bool IsSaving { get; set; }
  [Parameter] public EventCallback Submit { get; set; }
  [Parameter] public EventCallback OnInfoClick { get; set; }
  [Parameter] public EventCallback OnCancel { get; set; }

  private bool CanEdit => AccessState?.CanWrite == true && Item.Status is Status.Inserted or Status.Modified;
}
