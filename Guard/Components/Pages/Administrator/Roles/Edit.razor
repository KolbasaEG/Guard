<Guard.Components.Layout.Components.AccessDialog ReadPermission="@Guard.Core.Identity.Permissions.Roles.Read" WritePermission="@Guard.Core.Identity.Permissions.Roles.Manage">
@using Guard.Core.Services.DTOs
@attribute [Authorize]

<EditEntity ReadOnly="@item.IsSystem" TItem="RoleEditDto" Data="@item" ShowSaveButton="@(!item.IsSystem)" Submit="@FormSubmit" OnCancelButtonClick="HandleCancelButtonClick" ShowInfoButton="false" IsLoading="isLoading">
  <RadzenStack Gap="0px" Orientation="Orientation.Vertical" Style="width:100%;">
    <RadzenFormField Text="Наименование роли" Variant="Variant.Text" Style="width:100%;">
      <ChildContent>
        <RadzenTextBox style="display: block; width: 100%" @bind-Value="@item.Name" Name="RoleName" Placeholder="Введите наименование роли" />
      </ChildContent>
      <Helper>
        <RadzenRequiredValidator Component="RoleName" Text="Обязательно для заполнения!" />
      </Helper>
    </RadzenFormField>
    @if (item.IsSystem) { <RadzenAlert>Root имеет полный системный доступ. Роль нельзя изменить.</RadzenAlert> }
    else { <PermissionSelector Definitions="@PermissionCatalog.All" @bind-Selected="item.Permissions" Disabled="@isLoading" /> }
  </RadzenStack>
</EditEntity>
@code { [CascadingParameter] public Guard.Core.Services.DTOs.UserAccessSnapshot? Access { get; set; } }
</Guard.Components.Layout.Components.AccessDialog>
