@using Guard.Core.Entities
@attribute [Authorize]

<CreateEntity TItem="CreateUserModel" Data="@item">
  <Body>
    <RadzenStack Gap="0px" Orientation="Orientation.Vertical">
      <RadzenFormField Text="Логин" Variant="Variant.Text" Style="width:100%">
        <ChildContent>
          <RadzenTextBox style="display: block; width: 100%" @bind-Value="@item.Login" Name="Login" />
        </ChildContent>
        <Helper>
          <RadzenRequiredValidator Component="Login" Text="Обязательно для заполнения!" />
        </Helper>
      </RadzenFormField>
      <RadzenFormField Text="Роли" Variant="Variant.Text">
        <ChildContent>
          <RadzenDropDown Data="@roles" Multiple="true" style="width: 100%" TextProperty="Name" @bind-Value="@(userRoles)" ValueProperty="Id" Name="Roles" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true" />
        </ChildContent>
      </RadzenFormField>
      <RadzenFormField Text="Пароль" Variant="Variant.Text">
        <ChildContent>
          <RadzenPassword @bind-Value="@(item.Password)" style="display: block; width: 100%" Name="Password" />
        </ChildContent>
        <Helper>
          <RadzenRequiredValidator Component="Password" Text="Обязательно для заполнения!" />
        </Helper>
      </RadzenFormField>
      <RadzenFormField Text="Подтвердите пароль" Variant="Variant.Text">
        <ChildContent>
          <RadzenPassword style="display: block; width: 100%" @bind-Value="@(item.ConfirmPassword)" Name="ConfirmPassword" />
        </ChildContent>
        <Helper>
          <RadzenRequiredValidator Component="ConfirmPassword" Text="Обязательно для заполнения!" />
          <RadzenCompareValidator Text="Пароли должны совпадать!" Component="ConfirmPassword" Value="@item.Password" />
        </Helper>
      </RadzenFormField>
    </RadzenStack>
  </Body>
</CreateEntity>