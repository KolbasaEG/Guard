@page "/administrator/maintenance-sectors/schedule"
@using Guard.Core.Entities
@attribute [Authorize]

<RadzenCard Class="rz-p-4 rz-shadow-2">
  <RadzenStack Gap="1rem">

    <!-- Панель управления и фильтрации -->
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="1rem">
      <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">

        <RadzenFormField Text="Подразделение" Variant="Variant.Outlined" Style="min-width: 280px;">
          <RadzenDropDown TValue="Guid?" Data="@subdivisions" TextProperty="Name" ValueProperty="Id"
                          Value="@selectedSubdivisionId" ValueChanged="@((Guid? val) => OnSubdivisionChanged(val))"
                          AllowClear="false" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" />
        </RadzenFormField>

        <RadzenFormField Text="Месяц и год" Variant="Variant.Outlined" Style="width: 180px;">
          <RadzenDatePicker TValue="DateTime?" Value="@selectedMonth" ValueChanged="@((DateTime? val) => OnMonthChanged(val))"
                            DateFormat="MMMM yyyy" CustomDateFormat="MMMM yyyy" ShowTime="false" />
        </RadzenFormField>

      </RadzenStack>

      <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenButton Text="Заполнить по шаблонам" Icon="autorenew" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Click="@AutoFillFromPatterns" Disabled="@(isLoading || !scheduleRows.Any())" />
        <RadzenButton Text="Сохранить график" Icon="save" ButtonStyle="ButtonStyle.Primary" Click="@SaveScheduleAsync" IsLoading="@isSaving" Disabled="@(isLoading || !scheduleRows.Any())" />
      </RadzenStack>
    </RadzenStack>

    <!-- Сетка матрицы графика -->
    @if (isLoading)
    {
      <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Class="rz-p-5">
        <RadzenProgressBar Circular="true" Value="100" Mode="ProgressBarMode.Indeterminate" />
        <RadzenText TextStyle="TextStyle.Body2" Class="rz-mt-2">Формирование графика...</RadzenText>
      </RadzenStack>
    }
    else if (!scheduleRows.Any())
    {
      <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" Variant="Variant.Flat" Class="rz-mt-4">
        Участки обслуживания не найдены для выбранного подразделения.
      </RadzenAlert>
    }
    else
    {
      <div class="schedule-container">
        <table class="schedule-table">
          <thead>
            <tr>
              <!-- Левая фиксированная колонка -->
              <th class="sticky-col sector-header">
                <div>Участок обслуживания</div>
                <div class="rz-text-caption text-muted">Ответственный</div>
              </th>

              <!-- Дни месяца -->
              @foreach (var dayDate in monthDays)
              {
                var isWeekend = IsWeekend(dayDate.DayOfWeek);
                <th class="day-header @(isWeekend ? "weekend-header" : "")">
                  <div class="day-number">@dayDate.Day</div>
                  <div class="day-name">@GetShortDayName(dayDate.DayOfWeek)</div>
                </th>
              }
            </tr>
          </thead>
          <tbody>
            @foreach (var row in scheduleRows)
            {
              <tr>
                <!-- Название участка и ответственный -->
                <td class="sticky-col sector-cell">
                  <div class="sector-name">@row.SectorName</div>
                  <div class="sector-responsible">@row.ResponsibleName</div>
                </td>

                <!-- Ячейки с днями -->
                @foreach (var dayDate in monthDays)
                {
                  var isWeekend = IsWeekend(dayDate.DayOfWeek);
                  row.Days.TryGetValue(dayDate, out var cell);

                  <td class="day-cell @(isWeekend ? "weekend-cell" : "") @(cell != null && cell.IsWorkDay ? "workday-cell" : "offday-cell")"
                      @onclick="@(() => { if (cell != null) ToggleDayStatus(cell); })"
                      title="@(cell != null && cell.IsWorkDay ? $"Рабочая смена: {cell.WorkStart:hh\\:mm} - {cell.WorkEnd:hh\\:mm}" : "Выходной день (клик для изменения)")">
                    @if (cell != null)
                    {
                      if (cell.IsWorkDay)
                      {
                        <div class="shift-time">
                          <span>@cell.WorkStart?.ToString(@"hh\:mm")</span>
                          <span class="time-separator">-</span>
                          <span>@cell.WorkEnd?.ToString(@"hh\:mm")</span>
                        </div>
                      }
                      else
                      {
                        <span class="off-badge">В</span>
                      }
                    }
                  </td>
                }
              </tr>
            }
          </tbody>
        </table>
      </div>
    }

  </RadzenStack>
</RadzenCard>

<style>
  .schedule-container {
    width: 100%;
    overflow-x: auto;
    max-height: 70vh;
    border: 1px solid var(--rz-border-color, #e0e0e0);
    border-radius: 6px;
  }

  .schedule-table {
    border-collapse: separate;
    border-spacing: 0;
    width: 100%;
    font-size: 0.85rem;
  }

    .schedule-table th, .schedule-table td {
      border-right: 1px solid var(--rz-border-color, #e0e0e0);
      border-bottom: 1px solid var(--rz-border-color, #e0e0e0);
      text-align: center;
      padding: 6px 4px;
      white-space: nowrap;
    }

  /* Фиксированная левая колонка */
  .sticky-col {
    position: sticky;
    left: 0;
    z-index: 2;
    background-color: var(--rz-panel-background-color, #ffffff);
    min-width: 220px;
    max-width: 250px;
    text-align: left !important;
    padding-left: 12px !important;
    box-shadow: 2px 0 5px rgba(0,0,0,0.05);
  }

  .sector-header {
    top: 0;
    z-index: 3 !important;
    background-color: var(--rz-grid-header-background-color, #f4f5f7) !important;
  }

  .day-header {
    position: sticky;
    top: 0;
    z-index: 1;
    background-color: var(--rz-grid-header-background-color, #f4f5f7);
    min-width: 50px;
    user-select: none;
  }

  .day-number {
    font-weight: bold;
    font-size: 0.95rem;
  }

  .day-name {
    font-size: 0.75rem;
    color: var(--rz-text-secondary-color, #6c757d);
  }

  .weekend-header {
    background-color: #fbe9e7 !important;
    color: #c62828;
  }

  .weekend-cell {
    background-color: #fff8f6;
  }

  .day-cell {
    cursor: pointer;
    transition: background-color 0.15s ease-in-out;
    vertical-align: middle;
  }

    .day-cell:hover {
      filter: brightness(0.95);
    }

  .workday-cell {
    background-color: #e8f5e9;
    color: #1b5e20;
  }

  .shift-time {
    display: flex;
    flex-direction: column;
    font-size: 0.72rem;
    line-height: 1.1;
    font-weight: 600;
  }

  .time-separator {
    font-size: 0.65rem;
    opacity: 0.6;
  }

  .off-badge {
    color: #b0bec5;
    font-weight: 600;
    font-size: 0.8rem;
  }

  .sector-name {
    font-weight: 600;
    color: var(--rz-text-title-color, #212529);
  }

  .sector-responsible {
    font-size: 0.75rem;
    color: var(--rz-text-secondary-color, #6c757d);
  }

  .text-muted {
    color: var(--rz-text-secondary-color, #6c757d);
  }
</style>