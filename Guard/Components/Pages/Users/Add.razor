@using Guard.Core.Services.DTOs

<Guard.Components.Layout.Components.AccessDialog ReadPermission="@Permissions.Users.Read" WritePermission="@Permissions.Users.Manage">
<CreateEntity TItem="CreateUserDto" Data="@model" Name="Создание пользователя" Submit="SaveAsync"
              IsLoading="@(busy && !loaded)" IsSaving="@(busy && loaded)" ShowSaveButton="@loaded" OnCancelButtonClick="Cancel">
  <RadzenStack Gap="12px">
    @if (error != null) { <RadzenAlert AlertStyle="AlertStyle.Danger">@error</RadzenAlert> }
    @if (loaded && personals.Count == 0) { <RadzenAlert AlertStyle="AlertStyle.Info">Нет доступных сотрудников без учётной записи. Сначала добавьте сотрудника в разделе «Персонал».</RadzenAlert> }
    <RadzenFormField Text="Имя пользователя" Style="width:100%">
      <RadzenTextBox Name="UserName" @bind-Value="model.UserName" Style="width:100%" autocomplete="off" />
    </RadzenFormField>
    <RadzenRequiredValidator Component="UserName" Text="Укажите имя пользователя" />
    <RadzenFormField Text="Email" Style="width:100%">
      <RadzenTextBox Name="Email" @bind-Value="model.Email" Style="width:100%" autocomplete="off" />
    </RadzenFormField>
    <RadzenRequiredValidator Component="Email" Text="Укажите email" />
    <RadzenEmailValidator Component="Email" Text="Некорректный email" />
    <RadzenFormField Text="Пароль" Style="width:100%">
      <RadzenPassword Name="Password" @bind-Value="model.Password" Style="width:100%" autocomplete="new-password" />
    </RadzenFormField>
    <RadzenRequiredValidator Component="Password" Text="Укажите пароль" />
    <Guard.Components.Library.PasswordRequirements />
    <RadzenFormField Text="Повтор пароля" Style="width:100%">
      <RadzenPassword Name="Confirmation" @bind-Value="confirmation" Style="width:100%" autocomplete="new-password" />
    </RadzenFormField>
    <RadzenRequiredValidator Component="Confirmation" Text="Повторите пароль" />
    <RadzenFormField Text="Сотрудник" Style="width:100%">
      <RadzenDropDown Name="Personal" TValue="Guid?" Data="@personals" TextProperty="Name" ValueProperty="Id"
                      @bind-Value="model.PersonalId" AllowFiltering="true" AllowClear="true" Style="width:100%" />
    </RadzenFormField>
    <RadzenRequiredValidator Component="Personal" Text="Выберите сотрудника" />
    <RadzenText Text="После создания Root назначает роли через «Роли и итоговые права». Для входа сотруднику также нужны разрешённые IP-адреса." />
  </RadzenStack>
</CreateEntity>
</Guard.Components.Layout.Components.AccessDialog>
