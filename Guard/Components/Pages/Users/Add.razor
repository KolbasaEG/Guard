@using Guard.Core.Services.DTOs

<Guard.Components.Layout.Components.AccessDialog ReadPermission="@Permissions.Users.Read" WritePermission="@Permissions.Users.Manage">
<CreateEntity TItem="CreateUserDto" Data="@model" Name="Создание пользователя" Submit="SaveAsync"
              IsLoading="@(busy && !loaded)" IsSaving="@(busy && loaded)" ShowSaveButton="@loaded" OnCancelButtonClick="Cancel">
  <RadzenStack Class="guard-compact-content" Gap="5px" Style="width:100%;min-width:0;">
    @if (error != null) { <RadzenAlert AlertStyle="AlertStyle.Danger">@error</RadzenAlert> }
    @if (loaded && personals.Count == 0) { <RadzenAlert AlertStyle="AlertStyle.Info">Нет доступных сотрудников без учётной записи. Сначала добавьте сотрудника в разделе «Персонал».</RadzenAlert> }
    <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="2px" Style="width:100%;min-width:0;">
      <RadzenFormField Text="Имя пользователя" Variant="Variant.Text" Style="flex:1;min-width:min(100%,200px);">
        <ChildContent><RadzenTextBox Name="UserName" @bind-Value="model.UserName" Style="width:100%" autocomplete="off" /></ChildContent>
        <Helper><RadzenRequiredValidator Component="UserName" Text="Укажите имя пользователя" /></Helper>
      </RadzenFormField>
      <RadzenFormField Text="Email" Variant="Variant.Text" Style="flex:1;min-width:min(100%,200px);">
        <ChildContent><RadzenTextBox Name="Email" @bind-Value="model.Email" Style="width:100%" autocomplete="off" /></ChildContent>
        <Helper>
          <RadzenRequiredValidator Component="Email" Text="Укажите email" />
          <RadzenEmailValidator Component="Email" Text="Некорректный email" />
        </Helper>
      </RadzenFormField>
    </RadzenStack>
    <RadzenStack Gap="2px" Style="width:100%;min-width:0;">
      <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="2px" Style="width:100%;min-width:0;">
        <RadzenFormField Text="Пароль" Variant="Variant.Text" Style="flex:1;min-width:min(100%,200px);">
          <ChildContent><RadzenPassword Name="Password" @bind-Value="model.Password" Style="width:100%" autocomplete="new-password" /></ChildContent>
          <Helper><RadzenRequiredValidator Component="Password" Text="Укажите пароль" /></Helper>
        </RadzenFormField>
        <RadzenFormField Text="Повтор пароля" Variant="Variant.Text" Style="flex:1;min-width:min(100%,200px);">
          <ChildContent><RadzenPassword Name="Confirmation" @bind-Value="confirmation" Style="width:100%" autocomplete="new-password" /></ChildContent>
          <Helper><RadzenRequiredValidator Component="Confirmation" Text="Повторите пароль" /></Helper>
        </RadzenFormField>
      </RadzenStack>
      <Guard.Components.Library.PasswordRequirements />
    </RadzenStack>
    <RadzenFormField Text="Сотрудник" Variant="Variant.Text" Style="width:100%">
      <ChildContent>
        <RadzenDropDown Name="Personal" TValue="Guid?" Data="@personals" TextProperty="Name" ValueProperty="Id"
                        @bind-Value="model.PersonalId" AllowFiltering="true" AllowClear="true" Style="width:100%" />
      </ChildContent>
      <Helper><RadzenRequiredValidator Component="Personal" Text="Выберите сотрудника" /></Helper>
    </RadzenFormField>
    <RadzenText Text="После создания Root назначает роли через «Роли и итоговые права». Для входа сотруднику также нужны разрешённые IP-адреса." />
  </RadzenStack>
</CreateEntity>
</Guard.Components.Layout.Components.AccessDialog>
