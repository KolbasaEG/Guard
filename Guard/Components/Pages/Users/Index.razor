@using Guard.Core.Enums
@using Guard.Core.Services.DTOs
@attribute [Authorize]
<PageTitle>АИС "Охрана" — Пользователи</PageTitle>
<div class="users-list">
<TableWrapperWithFilterAndAnalytics ShowAnalitycs="false" TopPaneSize="180px">
  <Table>
    <RadzenDataGrid @ref="grid" IsLoading=@isLoading LoadData="@LoadData"  Count="@count" Data="@(filteredData)" TItem="UserDto" ColumnWidth="200px" AllowPaging="true" AllowSorting="true" PageSizeOptions=@(new int[] { 10, 20, 30, 50, 100 }) PageSize="20"
                    AllowColumnResize="true" Density="Density.Compact" AndOperatorText="И" ApplyFilterText="Применить" ClearFilterText="Очистить" ContainsText="Содержит" FilterText="Фильтр" EndsWithText="Заканчивается на" EqualsText="Равно"
                    DoesNotContainText="Не содержит" FirstPageTitle="Первая страница" FirstPageAriaLabel="К первой странице" IsEmptyText="Пусто" IsNotEmptyText="Не пусто" IsNullText="Не задано" IsNotNullText="Задано"
                    LastPageAriaLabel="К последней странице" LastPageTitle="Последняя страница" NextPageTitle="Следующая страница" NextPageAriaLabel="К следующей странице" NotEqualsText="Не равно" OrOperatorText="Или"
                    PageAriaLabelFormat="К странице {0}" PageSizeText="записей на странице" PrevPageTitle="Предыдущая страница" PrevPageAriaLabel="К предыдущей странице" ShowMultiColumnSortingIndex="true"
                    EmptyText="Записи не найдены" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" StartsWithText="Начинается c" LessThanText="Меньше" LessThanOrEqualsText="Меньше или равно"
                    PagerHorizontalAlign="HorizontalAlign.Right" PagerPosition="PagerPosition.Top" GreaterThanText="Больше" GreaterThanOrEqualsText="Больше или равно" ShowPagingSummary="true" PagingSummaryFormat="@pagingSummaryFormat"
                    Style="height:100%;">
      <HeaderTemplate>
        <RadzenStack Class="user-list-toolbar" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0px" Style="width:100%;min-width:0;">
          <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0px" Class="user-list-actions" Style="background-color: var(--rz-menu-top-item-background-color); border: var(--rz-selectbar-border);">
            <RadzenButton Icon="refresh" Click="@(grid.Reload)" title="Обновить" aria-label="Обновить список пользователей" Size="Radzen.ButtonSize.Medium" Variant="Variant.Text" Style="border-radius:0px;" />
            <RadzenButton Icon="add_circle_outline" title="Добавить" aria-label="Добавить пользователя" Visible="@(Access?.Has(Permissions.Users.Manage) == true)" Click="AddUserAsync" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Medium" Variant="Variant.Text" Style="border-radius:0px;" />

          </RadzenStack>
        </RadzenStack>
      </HeaderTemplate>
      <Columns>
        <RadzenDataGridColumn TItem="UserDto" Property="Id" SortProperty="Id" Title="Id" Frozen="true" Width="200px">
          <Template Context="item"><span class="guard-cell-text" tabindex="0">@item.Id</span></Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="UserDto" Property="UserName" SortProperty="UserName" Title="Имя пользователя" Width="200px">
          <Template Context="item"><span class="guard-cell-text" tabindex="0">@item.UserName</span></Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="UserDto" Property="Email" SortProperty="Email" Title="Email" Width="200px">
          <Template Context="item"><span class="guard-cell-text" tabindex="0">@item.Email</span></Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="UserDto" Property="PersonalId" SortProperty="PersonalId" Title="Id сотрудника" Width="200px">
          <Template Context="item"><span class="guard-cell-text" tabindex="0">@item.PersonalId</span></Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="UserDto" Property="PersonalFullName" Title="ФИО" Sortable="false" Width="100%" MinWidth="200px">
          <Template Context="item"><span class="guard-cell-text" tabindex="0">@item.PersonalFullName</span></Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="UserDto" Property="IsLockedOut" Title="Блокировка" Sortable="false" Width="200px">
          <Template Context="item">@(item.IsLockedOut ? "Да" : "Нет")</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="UserDto" Property="AccountBlockReason" SortProperty="AccountBlockReason" Title="Причина блокировки" Width="180px">
          <Template Context="item"><span class="guard-cell-text" tabindex="0">@(item.AccountBlockReason == "Inactivity" ? "Неактивность" : item.AccountBlockReason == "Administrator" ? "Администратор" : item.IsLockedOut ? "Временная блокировка" : "—")</span></Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="UserDto" Property="LastActivityAtUtc" SortProperty="LastActivityAtUtc" Title="Последняя активность" Width="180px">
          <Template Context="item">@(Time.Format(item.LastActivityAtUtc?.UtcDateTime))</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="UserDto" Property="PasswordChangeRequired" Sortable="false" Title="Требуется смена пароля" Width="180px">
          <Template Context="item">@(item.PasswordChangeRequired ? "Да" : "Нет")</Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="UserDto" Title="Действия" Filterable="false" Sortable="false" Width="180px" Frozen="true" TextAlign="TextAlign.Center" FrozenPosition="FrozenColumnPosition.Right">
          <Template Context="item">
            <RadzenStack Gap="2px" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Style="width:100%;">
              <RadzenButton Icon="edit" title="Редактировать пользователя" aria-label="Редактировать пользователя" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.ExtraSmall" Shade="Shade.Lighter" Variant="Variant.Flat" Visible="@(Access?.Has(Permissions.Users.Manage) == true && !item.IsLockedOut)" Click="@(() => EditUserAsync(item))" @onclick:stopPropagation="true" />
              <RadzenButton Icon="domino_mask" title="Роли и итоговые права" aria-label="Роли и итоговые права" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.ExtraSmall" Shade="Shade.Lighter" Variant="Variant.Flat" Visible="@(Access?.IsRoot == true)" Click="@(() => EditRoles(item))" @onclick:stopPropagation="true" />
              <RadzenButton Icon="lock" title="Изменить блокировку" aria-label="Изменить блокировку" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.ExtraSmall" Shade="Shade.Lighter" Variant="Variant.Flat" Visible="@(Access?.Has(Permissions.Users.Manage) == true)" Click="@(() => ToggleLockout(item))" @onclick:stopPropagation="true" />
              <RadzenButton Icon="passkey" title="Сбросить пароль" aria-label="Сбросить пароль" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.ExtraSmall" Shade="Shade.Lighter" Variant="Variant.Flat" Visible="@(Access?.Has(Permissions.Users.Manage) == true && !item.IsLockedOut)" Click="@(() => ResetPasswordAsync(item))" @onclick:stopPropagation="true" />
            </RadzenStack>
          </Template>
        </RadzenDataGridColumn>
      </Columns>
    </RadzenDataGrid>
  </Table>
  <Filter>
    <RadzenDataFilter Style="width:100%;" @ref="dataFilter" Auto=false Data="@data" TItem="UserFilterFields"
                      AndOperatorText="И" ApplyFilterText="Применить" ClearFilterText="Очистить" ContainsText="Содержит" FilterText="Фильтр" EndsWithText="Заканчивается на" EqualsText="Равно"
                      DoesNotContainText="Не содержит" IsEmptyText="Пусто" IsNotEmptyText="Не пусто" IsNullText="Не задано" IsNotNullText="Задано" NotEqualsText="Не равно" OrOperatorText="Или" StartsWithText="Начинается c" LessThanText="Меньше"
                      AddFilterText="Добавить фильтр" AddFilterGroupText="Добавить группу фильтров" LessThanOrEqualsText="Меньше или равно" GreaterThanText="Больше" GreaterThanOrEqualsText="Больше или равно" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
      <Properties>
        <RadzenDataFilterProperty TItem="UserFilterFields" Property="UserName" Title="Имя пользователя" />
        <RadzenDataFilterProperty TItem="UserFilterFields" Property="Email" Title="Email" />
      </Properties>
    </RadzenDataFilter>
  </Filter>
  <FilterButtons>
    <RadzenButton Icon="filter_alt" Text="Применить" Click="ApplyFilter" ButtonStyle="Radzen.ButtonStyle.Light" Size="Radzen.ButtonSize.Medium" Variant="Variant.Text" Style="border-radius:0px;" />
  </FilterButtons>

</TableWrapperWithFilterAndAnalytics>
</div>
