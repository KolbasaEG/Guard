@using Guard.Core.Services.DTOs
<Guard.Components.Layout.Components.AccessDialog ReadPermission="@Permissions.Users.Read" WritePermission="@Permissions.Users.Manage">
<EditEntity TItem="CreateUserDto" Data="@model" Name="Сброс пароля" Icon="passkey" IsSaving="@busy"
            ReadOnly="@(Access?.Has(Permissions.Users.Manage) != true)" Submit="SaveAsync" OnCancelButtonClick="Cancel">
  <RadzenStack Class="guard-compact-content" Gap="5px" Style="width:100%;min-width:0;">
    <RadzenText Text="После сброса все сессии пользователя завершаются. При следующем входе он должен заменить временный пароль." />
    <Guard.Components.Library.PasswordRequirements />
    @if (error != null) { <RadzenAlert AlertStyle="AlertStyle.Danger">@error</RadzenAlert> }
    <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="2px" Style="width:100%;min-width:0;">
      <RadzenFormField Text="Временный пароль" Variant="Variant.Text" Style="flex:1;min-width:min(100%,200px);">
        <ChildContent><RadzenPassword Name="Password" @bind-Value="model.Password" autocomplete="new-password" Style="width:100%" /></ChildContent>
        <Helper><RadzenRequiredValidator Component="Password" Text="Введите пароль" /></Helper>
      </RadzenFormField>
      <RadzenFormField Text="Повтор пароля" Variant="Variant.Text" Style="flex:1;min-width:min(100%,200px);">
        <ChildContent><RadzenPassword Name="Confirmation" @bind-Value="confirmation" autocomplete="new-password" Style="width:100%" /></ChildContent>
        <Helper><RadzenRequiredValidator Component="Confirmation" Text="Повторите пароль" /></Helper>
      </RadzenFormField>
    </RadzenStack>
  </RadzenStack>
</EditEntity>
</Guard.Components.Layout.Components.AccessDialog>
