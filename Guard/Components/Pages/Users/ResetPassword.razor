@using Guard.Core.Services.DTOs
@implements IDisposable
@inject ISecurityService Security
@inject DialogService DialogService
@inject ILogger<ResetPassword> Logger
<Guard.Components.Layout.Components.AccessDialog ReadPermission="@Permissions.Users.Read" WritePermission="@Permissions.Users.Manage">
<EditEntity TItem="CreateUserDto" Data="@model" Name="Сброс пароля" Icon="passkey" IsLoading="@busy"
            ReadOnly="@(Access?.Has(Permissions.Users.Manage) != true)" Submit="SaveAsync" OnCancelButtonClick="Cancel">
  <RadzenStack Gap="10px">
    <RadzenText Text="После сброса все сессии пользователя завершаются. При следующем входе он должен заменить временный пароль." />
    <Guard.Components.Library.PasswordRequirements />
    @if (error != null) { <RadzenAlert AlertStyle="AlertStyle.Danger">@error</RadzenAlert> }
    <RadzenLabel Text="Временный пароль" Component="Password" />
    <RadzenPassword Name="Password" @bind-Value="model.Password" autocomplete="new-password" Style="width:100%" />
    <RadzenRequiredValidator Component="Password" Text="Введите пароль" />
    <RadzenLabel Text="Повтор пароля" Component="Confirmation" />
    <RadzenPassword Name="Confirmation" @bind-Value="confirmation" autocomplete="new-password" Style="width:100%" />
    <RadzenRequiredValidator Component="Confirmation" Text="Повторите пароль" />
  </RadzenStack>
</EditEntity>
</Guard.Components.Layout.Components.AccessDialog>
@code {
  [Parameter] public string UserId { get; set; } = "";
  [CascadingParameter] public UserAccessSnapshot? Access { get; set; }
  private readonly CreateUserDto model = new() { Password = "" };
  private readonly CancellationTokenSource stop = new();
  private string confirmation = "";
  private string? error;
  private bool busy;
  private void Cancel() => DialogService.Close(null);
  private async Task SaveAsync()
  {
    if (busy) return;
    if (model.Password != confirmation) { error = "Пароли не совпадают."; return; }
    busy = true;
    try {
      var result = await Security.ResetPasswordAsync(UserId, model.Password, stop.Token);
      if (!result.Succeeded) { error = "Не удалось сбросить пароль."; return; }
      DialogService.Close(new Guard.Components.Library.Dialogs.EntityDialogResult(true));
    }
    catch (UnauthorizedAccessException) { error = "Недостаточно прав для сброса пароля этого пользователя."; }
    catch (UserSecurityException ex) { error = ex.Message; }
    catch (Exception ex) { Logger.LogError(ex, "Сброс пароля"); error = "Не удалось сбросить пароль. Обновите данные и повторите попытку."; }
    finally { busy = false; model.Password = ""; confirmation = ""; }
  }
  public void Dispose() { model.Password = ""; confirmation = ""; stop.Cancel(); stop.Dispose(); }
}
