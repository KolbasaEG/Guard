@page "/Account/Logout"
@layout AccountScreenLayout

<PageTitle>Выход из системы — АИС «Охрана»</PageTitle>
<AccountCard ScreenStyle="true">
    <Heading>
        <div class="account-centered">
            <div class="account-emblem"><RadzenIcon Icon="logout" /></div>
            <h1>Выход из системы</h1>
            <p class="account-subtitle">Вы уверены, что хотите выйти?</p>
        </div>
    </Heading>
    <ChildContent>
        <form method="post" action="Account/Logout" data-enhance="false">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="/Account/Login" />
            <div class="account-actions">
                <button type="submit" class="account-button">Выйти</button>
                <a href="@CancelReturnUrl" class="account-button account-button-secondary">Отмена</a>
            </div>
        </form>
    </ChildContent>
</AccountCard>

@code {
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    private string CancelReturnUrl => AccountReturnUrl.Normalize(ReturnUrl);
}
