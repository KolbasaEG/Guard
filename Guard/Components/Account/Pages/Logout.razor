@page "/Account/Logout"

@layout AccountLayout

<PageTitle>Выход из системы — АИС «Охрана»</PageTitle>

<RadzenCard Style="max-width: 440px; margin: 1rem; padding: 2.5rem; text-align: center; box-shadow: var(--rz-card-shadow);">
  <RadzenStack AlignItems="AlignItems.Center" Gap="1.75rem">

    <RadzenIcon Icon="logout" Style="font-size: 4.5rem; color: var(--rz-danger);" />

    <RadzenText Text="Выход из системы" TextStyle="Radzen.Blazor.TextStyle.H4" class="rz-m-0" />

    <RadzenText Text="Вы действительно хотите выйти из АИС «Охрана»?"
                TextStyle="Radzen.Blazor.TextStyle.Body1"
                class="rz-text-secondary" />

    <!--
            ВАЖНО: Используем <form method="post"> + endpoint /Account/Logout
            Это единственный production-ready способ в Static SSR (render mode = null для /Account/*).
            Интерактивные @onclick/Click не работают в Static SSR, т.к. нет Blazor circuit.
            Endpoint выполняет SignOutAsync + безопасный LocalRedirect.
        -->
    <form method="post" action="/Account/Logout" style="width: 100%;">
      <AntiforgeryToken />
      <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />

      <RadzenStack Orientation="Orientation.Horizontal"
                   JustifyContent="JustifyContent.Center"
                   Gap="1rem" class="rz-mt-2">

        <!-- Кнопка подтверждения выхода - type=submit отправляет форму на endpoint -->
        <RadzenButton ButtonType="ButtonType.Submit"
                      Text="Да, выйти"
                      Icon="power_settings_new"
                      ButtonStyle="Radzen.ButtonStyle.Danger"
                      Size="Radzen.ButtonSize.Large"
                      Style="min-width: 160px; font-weight: 500;" />

        <!-- Отмена: используем <a> вместо RadzenButton с Click,
                     т.к. в Static SSR события не обрабатываются.
                     Стилизуем под RadzenButton Secondary для consistency UI. -->
        <a href="@CancelReturnUrl"
           class="rz-button rz-button-secondary rz-button-lg"
           style="min-width: 160px; font-weight: 500; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; color: inherit;">
          Отмена
        </a>
      </RadzenStack>
    </form>

    <RadzenText Text="При подтверждении вы будете перенаправлены на страницу авторизации."
                TextStyle="Radzen.Blazor.TextStyle.Caption"
                class="rz-text-disabled" />
  </RadzenStack>
</RadzenCard>

@code {
  /// <summary>
  /// ReturnUrl из query string. После успешного выхода пользователь будет перенаправлен сюда.
  /// Если не указан — на главную страницу.
  /// </summary>
  [SupplyParameterFromQuery]
  private string? ReturnUrl { get; set; }

  /// <summary>
  /// URL для кнопки "Отмена". Вычисляется с sanitization для безопасности.
  /// </summary>
  private string CancelReturnUrl { get; set; } = "/";

  protected override void OnInitialized()
  {
    // Санитизация ReturnUrl — защита от Open Redirect атак (как в RedirectToLogin.razor)
    var targetReturnUrl = ReturnUrl;

    if (string.IsNullOrWhiteSpace(targetReturnUrl))
    {
      targetReturnUrl = "/";
    }

    if (!Uri.IsWellFormedUriString(targetReturnUrl, UriKind.Relative) ||
        targetReturnUrl.StartsWith("//", StringComparison.Ordinal) ||
        targetReturnUrl.Contains("://", StringComparison.Ordinal))
    {
      targetReturnUrl = "/";
    }

    CancelReturnUrl = targetReturnUrl;

    // Примечание: после SignOut в endpoint редирект произойдёт на ReturnUrl.
    // Если ReturnUrl ведёт на защищённую страницу — сработает RedirectToLogin (пользователь увидит форму входа).
  }
}