@page "/Account/Login"

@using System.ComponentModel.DataAnnotations
@using Guard.Core.Services
@using Guard.Core.Services.DTOs

@inject ILocalAccountService Accounts
@inject IdentityRedirectManager RedirectManager
@layout AccountLayout

<PageTitle>Вход в систему — АИС «Охрана»</PageTitle>
<AccountCard Title="Вход в систему" Icon="login">
    <StatusMessage Message="@errorMessage" />
    <EditForm EditContext="editContext" method="post" OnSubmit="LoginUser" FormName="login">
      <DataAnnotationsValidator />
      <RadzenText Text="Для входа в систему используйте локальную учетную запись." TextStyle="Radzen.Blazor.TextStyle.Subtitle1" />

      <ValidationSummary class="text-danger" role="alert" />
      <div class="form-floating mb-2">
        <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" style="height:48px; min-height:48px;" autocomplete="username" aria-required="true" placeholder="name@example.com" />
        <label for="Input.Email" class="form-label">Email</label>
        <ValidationMessage For="() => Input.Email" class="text-danger" />
      </div>
      <div class="form-floating mb-2">
        <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" style="height:48px; min-height:48px;" autocomplete="current-password" aria-required="true" placeholder="Пароль" />
        <label for="Input.Password" class="form-label">Пароль</label>
        <ValidationMessage For="() => Input.Password" class="text-danger" />
      </div>

      <div class="checkbox mb-2">
        <label class="form-label rz-text-subtitle1">
          <InputCheckbox @bind-Value="Input.RememberMe" class="darker-border-checkbox form-check-input" />
          Запомнить меня
        </label>
      </div>
      <div>
          <RadzenButton ButtonType="ButtonType.Submit" Text="Войти" ButtonStyle="ButtonStyle.Primary" class="w-100" Size="ButtonSize.Medium" />
      </div>

    </EditForm>

</AccountCard>


@code {
  private string? errorMessage;
  private EditContext editContext = default!;
  [CascadingParameter]
  private HttpContext HttpContext { get; set; } = default!;

  [SupplyParameterFromForm]
  private InputModel Input { get; set; } = default!;

  [SupplyParameterFromQuery]
  private string? ReturnUrl { get; set; }

  protected override void OnInitialized()
  {
    Input ??= new();
    editContext = new EditContext(Input);
  }

  public async Task LoginUser()
  {
    if (!editContext.Validate()) return;
    var result = await Accounts.SignInAsync(Input.Email, Input.Password, Input.RememberMe, HttpContext.RequestAborted);
    switch (result) {
      case LocalSignInStatus.Succeeded:
        RedirectManager.RedirectTo(AccountReturnUrl.Normalize(ReturnUrl));
        break;
      case LocalSignInStatus.LockedOut:
        RedirectManager.RedirectTo("Account/Lockout");
        break;
      case LocalSignInStatus.RequiresTwoFactor:
        errorMessage = "Ошибка: Для этой учётной записи включена двухфакторная проверка. Обратитесь к администратору для перехода на локальный вход.";
        break;
      case LocalSignInStatus.NotAllowed:
        errorMessage = "Ошибка: Вход не разрешён. Учётная запись может быть заблокирована, либо не выполнены условия IP-доступа и подтверждения. Обратитесь к администратору.";
        break;
      default:
        errorMessage = "Ошибка: Неверный email или пароль.";
        break;
    }
  }

  private sealed class InputModel
  {
    [Required(ErrorMessage = "Поле «Email» обязательно для заполнения.")]
    [EmailAddress(ErrorMessage = "Введите корректный адрес электронной почты.")]
    public string Email { get; set; } = "";

    [Required(ErrorMessage = "Поле «Пароль» обязательно для заполнения.")]
    [DataType(DataType.Password)]
    public string Password { get; set; } = "";

    [Display(Name = "Remember me?")]
    public bool RememberMe { get; set; }

  }
}
