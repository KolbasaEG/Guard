@page "/Account/Login"

@using System.ComponentModel.DataAnnotations
@using Guard.Core.Services
@using Guard.Core.Services.DTOs

@inject ILocalAccountService Accounts
@inject IdentityRedirectManager RedirectManager
@layout AccountScreenLayout

<PageTitle>Вход в систему — АИС «Охрана»</PageTitle>
<AccountCard ScreenStyle="true">
  <Heading><h1>Вход в систему</h1><p class="account-subtitle">Введите свои учётные данные</p></Heading>
  <ChildContent>
    <StatusMessage Message="@errorMessage" Compact="true" Severity="AlertStyle.Danger" />
    <EditForm EditContext="editContext" method="post" OnSubmit="LoginUser" FormName="login" class="account-form account-login" Enhance="false">
      <DataAnnotationsValidator />
      <div class="account-field">
        <label for="Input.Email">Email</label>
        <div class="account-input-shell"><RadzenIcon Icon="mail_outline" /><InputText @bind-Value="Input.Email" id="Input.Email" autocomplete="username" aria-required="true" placeholder="name@example.com" /></div>
        <ValidationMessage For="() => Input.Email" />
      </div>
      <div class="account-field">
        <label for="Input.Password">Пароль</label>
        <div class="account-input-shell"><RadzenIcon Icon="lock_outline" /><InputText type="password" @bind-Value="Input.Password" id="Input.Password" autocomplete="current-password" aria-required="true" placeholder="Пароль" />
          <button class="account-eye" type="button" data-account-password="Input.Password" aria-label="Показать пароль" aria-pressed="false"><RadzenIcon Icon="visibility" /></button>
        </div>
        <ValidationMessage For="() => Input.Password" />
      </div>

        <label class="account-remember">
          <InputCheckbox @bind-Value="Input.RememberMe" />
          Запомнить меня
        </label>
      <div class="account-help">Забыли пароль? Обратитесь к администратору.</div>
      <button type="submit" class="account-button">Войти <RadzenIcon Icon="arrow_forward" /></button>

    </EditForm>

  </ChildContent>
</AccountCard>


@code {
  private string? errorMessage;
  private EditContext editContext = default!;
  [CascadingParameter]
  private HttpContext HttpContext { get; set; } = default!;

  [SupplyParameterFromForm]
  private InputModel Input { get; set; } = default!;

  [SupplyParameterFromQuery]
  private string? ReturnUrl { get; set; }

  protected override void OnInitialized()
  {
    Input ??= new();
    editContext = new EditContext(Input);
  }

  public async Task LoginUser()
  {
    try {
    if (!editContext.Validate()) {
      try { await Accounts.RecordRejectedSignInAsync(Input.Email, HttpContext.RequestAborted); }
      catch (AuditUnavailableException) { errorMessage = "Обязательный аудит недоступен. Работа системы приостановлена."; }
      return;
    }
    LocalSignInStatus result;
    try { result = await Accounts.SignInAsync(Input.Email, Input.Password, Input.RememberMe, HttpContext.RequestAborted); }
    catch (AuditUnavailableException) { errorMessage = "Обязательный аудит недоступен. Работа системы приостановлена."; return; }
    catch (OperationCommitUnknownException) { errorMessage = "Результат входа не подтверждён. Обновите страницу и проверьте состояние аудита."; return; }
    switch (result) {
      case LocalSignInStatus.RecoveryOnly:
        RedirectManager.RedirectTo("Account/Audit");
        break;
      case LocalSignInStatus.AuditUnavailable:
        errorMessage = "Работа системы приостановлена: обязательный аудит недоступен. Root может войти только в диагностику.";
        break;
      case LocalSignInStatus.Succeeded:
        RedirectManager.RedirectTo(AccountReturnUrl.Normalize(ReturnUrl));
        break;
      case LocalSignInStatus.LockedOut:
        RedirectManager.RedirectTo("Account/Lockout");
        break;
      case LocalSignInStatus.RequiresTwoFactor:
        errorMessage = "Ошибка: Для этой учётной записи включена двухфакторная проверка. Обратитесь к администратору для перехода на локальный вход.";
        break;
      case LocalSignInStatus.NotAllowed:
        errorMessage = "Ошибка: Вход не разрешён. Учётная запись может быть заблокирована, либо не выполнены условия IP-доступа и подтверждения. Обратитесь к администратору.";
        break;
      default:
        errorMessage = "Ошибка: Неверный email или пароль.";
        break;
    }
    }
    finally { Input.Password = ""; }
  }

  private sealed class InputModel
  {
    [Required(ErrorMessage = "Поле «Email» обязательно для заполнения.")]
    [EmailAddress(ErrorMessage = "Введите корректный адрес электронной почты.")]
    public string Email { get; set; } = "";

    [Required(ErrorMessage = "Поле «Пароль» обязательно для заполнения.")]
    [DataType(DataType.Password)]
    public string Password { get; set; } = "";

    [Display(Name = "Remember me?")]
    public bool RememberMe { get; set; }

  }
}
