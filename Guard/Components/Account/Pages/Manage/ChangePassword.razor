@page "/Account/Manage/ChangePassword"

@layout AccountLayout

@using System.ComponentModel.DataAnnotations
@using Guard.Core.Entities;
@using Microsoft.AspNetCore.Identity


@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ChangePassword> Logger

<PageTitle>Смена пароля</PageTitle>

<AccountCard Title="Смена пароля" Icon="passkey">
    <EditEntity TItem="InputModel" Data="@Input" ContentOnly="true" StaticFormName="change-password" Name="Смена пароля" Icon="passkey" Submit="OnValidSubmitAsync">
        <Guard.Components.Library.PasswordRequirements />
        <p>При истечении срока действия или сбросе администратором замените пароль для продолжения работы.</p>
        <StatusMessage Message="@message" />
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />
        <div class="form-floating mb-2">
            <InputText type="password" @bind-Value="Input.OldPassword" id="Input.OldPassword" class="form-control" style="height:48px; min-height:48px;" autocomplete="current-password" aria-required="true" placeholder="Введите текущий пароль" />
            <label for="Input.OldPassword" class="form-label">Текущий пароль</label>
            <ValidationMessage For="() => Input.OldPassword" class="text-danger" />
        </div>
        <div class="form-floating mb-2">
            <InputText type="password" @bind-Value="Input.NewPassword" id="Input.NewPassword" class="form-control" style="height:48px; min-height:48px;" autocomplete="new-password" aria-required="true" placeholder="Введите новый пароль" />
            <label for="Input.NewPassword" class="form-label">Новый пароль</label>
            <ValidationMessage For="() => Input.NewPassword" class="text-danger" />
        </div>
        <div class="form-floating mb-2">
            <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" style="height:48px; min-height:48px;" autocomplete="new-password" aria-required="true" placeholder="Введите новый пароль" />
            <label for="Input.ConfirmPassword" class="form-label">Повтор пароля</label>
            <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
        </div>
          <RadzenButton ButtonType="ButtonType.Submit" Text="Сохранить пароль" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Medium" class="w-100" />
    </EditEntity>
    <LogoutButton />
</AccountCard>

@code {
    private string? message;
    private ApplicationUser? user;
    private bool hasPassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        hasPassword = await UserManager.HasPasswordAsync(user);
        if (!hasPassword)
        {
            RedirectManager.RedirectTo("Account/Manage/SetPassword");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var changePasswordResult = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!changePasswordResult.Succeeded)
        {
            message = $"Ошибка: {string.Join(",", changePasswordResult.Errors.Select(error => error.Description))}";
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        Logger.LogInformation("User changed their password successfully.");

        RedirectManager.RedirectTo("/");
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Заполните поле пароля.")]
        [DataType(DataType.Password)]
        [Display(Name = "Текущий пароль")]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "Заполните поле пароля.")]
        [StringLength(100, ErrorMessage = "Поле {0}: длина от {2} до {1} символов.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = "Новый пароль")]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Повтор пароля")]
        [Compare("NewPassword", ErrorMessage = "Пароли не совпадают.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
