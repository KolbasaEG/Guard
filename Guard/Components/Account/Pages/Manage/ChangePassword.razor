@page "/Account/Manage/ChangePassword"
@layout AccountScreenLayout

<PageTitle>@ScreenTitle — АИС «Охрана»</PageTitle>
<AccountCard ScreenStyle="true">
    <Heading>
        <RadzenIcon Icon="passkey" class="@(mandatory ? "account-heading-icon account-heading-warning" : "account-heading-icon")" />
        <h1>@ScreenTitle</h1>
        <p class="account-subtitle">@(mandatory ? "Чтобы продолжить работу, установите новый пароль." : "Введите текущий пароль и задайте новый.")</p>
    </Heading>
    <ChildContent>
        <StatusMessage Message="@message" Compact="true" Severity="@(signInRequired ? AlertStyle.Warning : AlertStyle.Danger)" />
        @if (signInRequired) {
            <a href="/Account/Login" class="account-button">Войти с новым паролем</a>
        }
        @if (canChange) {
            <EditForm Model="Input" method="post" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" OnInvalidSubmit="ClearPasswords" class="account-form" Enhance="false">
                <DataAnnotationsValidator />
                <div class="account-field">
                    <label for="Input.OldPassword">Текущий пароль</label>
                    <div class="account-input-shell">
                        <RadzenIcon Icon="lock_outline" />
                        <InputText type="password" @bind-Value="Input.OldPassword" id="Input.OldPassword" autocomplete="current-password" aria-required="true" />
                        <button type="button" class="account-eye" data-account-password="Input.OldPassword" aria-label="Показать пароль" aria-pressed="false"><RadzenIcon Icon="visibility" /></button>
                    </div>
                    <ValidationMessage For="() => Input.OldPassword" />
                </div>
                <div class="account-field">
                    <label for="Input.NewPassword">Новый пароль</label>
                    <div class="account-input-shell">
                        <RadzenIcon Icon="lock_outline" />
                        <InputText type="password" @bind-Value="Input.NewPassword" id="Input.NewPassword" autocomplete="new-password" aria-required="true" />
                        <button type="button" class="account-eye" data-account-password="Input.NewPassword" aria-label="Показать пароль" aria-pressed="false"><RadzenIcon Icon="visibility" /></button>
                    </div>
                    <ValidationMessage For="() => Input.NewPassword" />
                </div>
                <div class="account-field">
                    <label for="Input.ConfirmPassword">Повтор пароля</label>
                    <div class="account-input-shell">
                        <RadzenIcon Icon="lock_outline" />
                        <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" />
                        <button type="button" class="account-eye" data-account-password="Input.ConfirmPassword" aria-label="Показать пароль" aria-pressed="false"><RadzenIcon Icon="visibility" /></button>
                    </div>
                    <ValidationMessage For="() => Input.ConfirmPassword" />
                </div>
                <div class="account-requirements"><PasswordRequirements /></div>
                <button type="submit" class="account-button">Сохранить пароль</button>
                @if (!mandatory) {
                    <a href="@SafeReturnUrl" class="account-button account-button-secondary">Отмена</a>
                }
            </EditForm>
        }
        @if ((mandatory || !canChange) && !signInRequired) {
            <a href="/Account/Logout?ReturnUrl=%2FAccount%2FManage%2FChangePassword" class="account-button account-button-secondary account-logout-link">Выйти из системы</a>
        }
    </ChildContent>
</AccountCard>
