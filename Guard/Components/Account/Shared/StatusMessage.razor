@if (!string.IsNullOrEmpty(DisplayMessage))
{
    var inferredError = DisplayMessage.StartsWith("Error", StringComparison.OrdinalIgnoreCase) ||
        DisplayMessage.StartsWith("Ошибка", StringComparison.OrdinalIgnoreCase) ? "danger" : "success";
    var statusMessageClass = Severity?.ToString().ToLowerInvariant() ?? inferredError;
    <div class="@(Compact ? $"account-status account-status-{statusMessageClass}" : $"alert alert-{statusMessageClass}")" role="@(Compact && statusMessageClass != "danger" ? "status" : "alert")">
        @DisplayMessage
    </div>
}

@code {
    private string? messageFromCookie;

    [Parameter]
    public string? Message { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public AlertStyle? Severity { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? DisplayMessage => Message ?? messageFromCookie;

    protected override void OnInitialized()
    {
        messageFromCookie = HttpContext.Request.Cookies[IdentityRedirectManager.StatusCookieName];

        if (messageFromCookie is not null)
        {
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
        }
    }
}
