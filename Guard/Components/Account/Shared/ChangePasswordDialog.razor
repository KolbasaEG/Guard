@implements IAsyncDisposable
@inject DialogService DialogService
@inject IJSRuntime JS
@inject ILogger<ChangePasswordDialog> Logger

<div @ref="container">
  <EditEntity TItem="PasswordInput" Data="@input" Name="Смена пароля" Icon="passkey"
              IsLoading="@busy" Submit="SaveAsync" OnCancelButtonClick="Cancel">
    <AntiforgeryToken />
    <RadzenStack Gap="10px">
      <Guard.Components.Library.PasswordRequirements />
      @if (error != null) { <RadzenAlert AlertStyle="AlertStyle.Danger">@error</RadzenAlert> }
      <RadzenLabel Text="Текущий пароль" Component="OldPassword" />
      <RadzenPassword Name="OldPassword" @bind-Value="input.OldPassword" autocomplete="current-password" Style="width:100%" />
      <RadzenRequiredValidator Component="OldPassword" Text="Введите текущий пароль" />
      <RadzenLabel Text="Новый пароль" Component="NewPassword" />
      <RadzenPassword Name="NewPassword" @bind-Value="input.NewPassword" autocomplete="new-password" Style="width:100%" />
      <RadzenRequiredValidator Component="NewPassword" Text="Введите новый пароль" />
      <RadzenLabel Text="Повтор пароля" Component="Confirmation" />
      <RadzenPassword Name="Confirmation" @bind-Value="input.Confirmation" autocomplete="new-password" Style="width:100%" />
      <RadzenRequiredValidator Component="Confirmation" Text="Повторите пароль" />
    </RadzenStack>
  </EditEntity>
</div>

@code {
  private readonly PasswordInput input = new();
  private ElementReference container;
  private IJSObjectReference? module;
  private bool busy;
  private string? error;
  private void Cancel() => DialogService.Close(null);

  private async Task SaveAsync()
  {
    if (busy) return;
    if (input.NewPassword != input.Confirmation) { error = "Пароли не совпадают."; return; }
    busy = true;
    try {
      module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/change-password.js");
      error = await module.InvokeAsync<string?>("changePassword", container);
    }
    catch (JSDisconnectedException) { }
    catch (Exception ex) {
      Logger.LogError(ex, "Не удалось изменить собственный пароль");
      error = "Не удалось изменить пароль. Повторите попытку.";
    }
    finally { busy = false; }
  }

  public async ValueTask DisposeAsync()
  {
    input.OldPassword = input.NewPassword = input.Confirmation = "";
    if (module != null) {
      try { await module.DisposeAsync(); }
      catch (JSDisconnectedException) { }
    }
  }

  private sealed class PasswordInput
  {
    public string OldPassword { get; set; } = "";
    public string NewPassword { get; set; } = "";
    public string Confirmation { get; set; } = "";
  }
}
